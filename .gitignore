.DS_Store
**/.DS_Store

# Generated by automation/members-area/backfill_existing_customers.py -- contains
# real subscriber access tokens, must never land in git history.
automation/members-area/*.sql
!automation/members-area/schema.sql

# Eleventy build. Source of truth is site/ -- _site/ is generated output and is
# rebuilt on the VPS at deploy time, so it never belongs in the repo.
node_modules/
_site/

# Python bytecode. Several of these are already tracked from earlier work; clear
# them with:  git rm -r --cached '**/__pycache__'
__pycache__/
*.pyc
_to_delete/

# Staging area for full-size photo originals on their way into
# site/assets/images/blog/. Multi-megabyte camera and stock files that only
# need to exist long enough to be resized — committing them would put every
# original in git history permanently, where deleting the file later does not
# reclaim the space.
_incoming/
