            <img src="{{ "/assets/images/ivan-560.jpg" | v }}" srcset="{{ "/assets/images/ivan-560.jpg" | v }} 560w, {{ "/assets/images/ivan-800.jpg" | v }} 800w" sizes="(max-width: 700px) 220px, 250px" width="560" height="700" alt="Iván Koch, coach de Triaperformance" loading="lazy" decoding="async">
