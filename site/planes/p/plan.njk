---
pagination:
  data: plans.byLanguage.es
  size: 1
  alias: plan
  addAllPagesToCollections: true
permalink: "/planes/p/{{ plan.slug }}/"
layout: layouts/base.njk
lang: es
pageCss: plan-page.css
eleventyComputed:
  title: "{{ plan.seoTitle | safe }}"
  ogTitle: "{{ plan.displayName | safe }}"
  description: "{% set d %}{{ plan.displayName | safe }}: plan de {{ plan.weeks }} semanas en TrainingPeaks{% if plan.weeklyTotals and plan.weeklyTotals.sessions %}, {{ plan.weeklyTotals.sessions }} sesiones por semana{% if plan.weeklyTotals.hoursText %} ({{ plan.weeklyTotals.hoursText }} promedio){% endif %}{% endif %}. Zonas, progresión y semanas de descarga incluidas. US$ {{ plan.price }}.{% endset %}{{ d | clamp(158) }}"
---
{% include "partials/plan-page-content.njk" %}
