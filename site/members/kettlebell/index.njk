---
layout: layouts/base.njk
navVariant: "none"
footerVariant: "none"
pageCss: "members-kettlebell.css"
title: "Kettlebell Strength Routine — Triaperformance"
---
<nav class="site-nav">
  <div class="wrap">
    <a href="/members/" class="logo">Triaperformance</a>
    <a href="/members/" class="back">← Members area</a>
  </div>
</nav>

<div class="wrap">

<header class="page-header">
  <div class="eyebrow">Triaperformance × Strength</div>
  <h1>Kettlebell strength routine</h1>
  <p class="subtitle">Iván Koch — Home training · Back-safe · Posterior chain focus</p>
</header>

<div class="progress-container">
  <div class="progress-row">
    <span class="progress-label">Session progress</span>
    <span class="progress-count" id="progressCount">0 / 9 exercises</span>
  </div>
  <div class="progress-bar">
    <div class="progress-fill" id="progressFill"></div>
  </div>
</div>

<!-- Weight selector -->
<div class="weight-selector">
  <div class="weight-label">Today's working weight</div>
  <div class="weight-buttons">
    <div class="weight-btn active" onclick="setWeight('12kg', this)">12 kg<br><span style="font-size:10px;font-weight:400;color:var(--text-dim)">Technique</span></div>
    <div class="weight-btn" onclick="setWeight('16kg', this)">16 kg<br><span style="font-size:10px;font-weight:400;color:var(--text-dim)">Working</span></div>
    <div class="weight-btn" onclick="setWeight('21kg', this)">21 kg<br><span style="font-size:10px;font-weight:400;color:var(--text-dim)">Heavy</span></div>
  </div>
</div>

<div class="note-box">
  <strong>Back protocol:</strong> Side-roll to get up from floor. No barbell axial loading. Stop if lower back tension builds — not just discomfort, actual tension. Goblet position protects lumbar curve naturally.
</div>

<!-- PHASE 1: ACTIVATION -->
<div class="phase">
  <div class="phase-header">
    <div class="phase-num">1</div>
    <div class="phase-title">Activation</div>
    <div class="phase-duration">~10 min · Bands + bodyweight</div>
  </div>

  <div class="exercise" id="ex-clamshell">
    <div class="exercise-header" onclick="toggleExercise('ex-clamshell')">
      <div class="check" onclick="toggleComplete(event, 'ex-clamshell')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Clamshells with band</div>
        <div class="exercise-meta">2 sets · 15 reps + 5 holds · Each side</div>
      </div>
      <div class="exercise-weight">Band</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">Side lying, knees bent at 90°, band just above knees. Rotate top knee toward ceiling while keeping feet together. Right side first — this is your weak link. On the final 5 reps, hold the top position for 3 seconds each.</div>
      <div class="exercise-tip"><span class="tag">Why it matters</span><br>Right glute med is the root cause of your entire compensation chain. Start every session here.</div>
      <div class="sets-tracker">
        <div class="sets-label">Sets</div>
        <div class="sets-row">
          <button class="set-btn" onclick="toggleSet(this)">1</button>
          <button class="set-btn" onclick="toggleSet(this)">2</button>
        </div>
      </div>
    </div>
  </div>

  <div class="exercise" id="ex-deadbug">
    <div class="exercise-header" onclick="toggleExercise('ex-deadbug')">
      <div class="check" onclick="toggleComplete(event, 'ex-deadbug')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Dead bug with band</div>
        <div class="exercise-meta">3 sets · 10 reps · Each side</div>
      </div>
      <div class="exercise-weight">Band</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">Lying on back, band above knees, arms pointing to ceiling. Press lower back into floor. Extend opposite arm and leg simultaneously while resisting the band pulling knees together. Slow and controlled — 3 seconds per rep.</div>
      <div class="exercise-tip"><span class="tag">Why it matters</span><br>The band above knees fixes your foot turn-in pattern (glute med inhibition). If the foot turns in during the rep, stop and reset.</div>
      <div class="sets-tracker">
        <div class="sets-label">Sets</div>
        <div class="sets-row">
          <button class="set-btn" onclick="toggleSet(this)">1</button>
          <button class="set-btn" onclick="toggleSet(this)">2</button>
          <button class="set-btn" onclick="toggleSet(this)">3</button>
        </div>
      </div>
    </div>
  </div>

  <div class="exercise" id="ex-slgb">
    <div class="exercise-header" onclick="toggleExercise('ex-slgb')">
      <div class="check" onclick="toggleComplete(event, 'ex-slgb')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Single leg glute bridge</div>
        <div class="exercise-meta">3×12 right · 2×12 left · 2 sec hold at top</div>
      </div>
      <div class="exercise-weight">BW</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">On back, one foot flat, other leg extended or bent in air. Drive through the planted heel to raise hips. Hold 2 seconds at top — squeeze the glute deliberately, not just the hamstring. Right side gets more volume every session until glute med is reliably firing.</div>
      <div class="exercise-tip"><span class="tag">Why it matters</span><br>Do this before squats — wakes the right glute so it contributes from rep 1, preventing the hip shift you noticed.</div>
      <div class="sets-tracker">
        <div class="sets-label">Sets (R/L)</div>
        <div class="sets-row">
          <button class="set-btn" onclick="toggleSet(this)">R1</button>
          <button class="set-btn" onclick="toggleSet(this)">R2</button>
          <button class="set-btn" onclick="toggleSet(this)">R3</button>
          <button class="set-btn" onclick="toggleSet(this)">L1</button>
          <button class="set-btn" onclick="toggleSet(this)">L2</button>
        </div>
      </div>
    </div>
  </div>

  <div class="exercise" id="ex-lateral">
    <div class="exercise-header" onclick="toggleExercise('ex-lateral')">
      <div class="check" onclick="toggleComplete(event, 'ex-lateral')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Lateral band walks — forward lean</div>
        <div class="exercise-meta">3 sets · 15 steps each direction</div>
      </div>
      <div class="exercise-weight">Band</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">Band above knees, slight hip hinge forward (running posture, not upright). Step laterally — resist the band pulling knees together. The forward lean makes this far more specific to your running gait than upright lateral walks. Keep tension on the band throughout — don't let feet come together fully.</div>
      <div class="sets-tracker">
        <div class="sets-label">Sets</div>
        <div class="sets-row">
          <button class="set-btn" onclick="toggleSet(this)">1</button>
          <button class="set-btn" onclick="toggleSet(this)">2</button>
          <button class="set-btn" onclick="toggleSet(this)">3</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- PHASE 2: STRENGTH -->
<div class="phase">
  <div class="phase-header">
    <div class="phase-num">2</div>
    <div class="phase-title">Strength</div>
    <div class="phase-duration">~30 min · Kettlebells</div>
  </div>

  <div class="exercise" id="ex-goblet">
    <div class="exercise-header" onclick="toggleExercise('ex-goblet')">
      <div class="check" onclick="toggleComplete(event, 'ex-goblet')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Goblet squat</div>
        <div class="exercise-meta">4 sets · 10–12 reps · 90 sec rest</div>
      </div>
      <div class="exercise-weight" id="goblet-weight">12 kg</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">Kettlebell at chest in both hands. Feet shoulder-width, toes slightly out. 3 seconds down, pause 1 second at bottom, drive through heels. The goblet position forces upright torso and deep hip crease — this is what "points to the problem" and makes the glute fire correctly. Go as deep as back allows comfortably.</div>
      <div class="exercise-tip"><span class="tag">Priority</span><br>The single best exercise for your pattern right now. When 16kg feels easy for 12 reps, move to 21kg.</div>
      <div class="sets-tracker">
        <div class="sets-label">Sets</div>
        <div class="sets-row">
          <button class="set-btn" onclick="toggleSet(this, 90)">1</button>
          <button class="set-btn" onclick="toggleSet(this, 90)">2</button>
          <button class="set-btn" onclick="toggleSet(this, 90)">3</button>
          <button class="set-btn" onclick="toggleSet(this, 90)">4</button>
        </div>
      </div>
    </div>
  </div>

  <div class="exercise" id="ex-bulgarian">
    <div class="exercise-header" onclick="toggleExercise('ex-bulgarian')">
      <div class="check" onclick="toggleComplete(event, 'ex-bulgarian')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Bulgarian split squat</div>
        <div class="exercise-meta">3 sets · 10 reps each leg · 2 min rest</div>
      </div>
      <div class="exercise-weight" id="bulgarian-weight">12 kg</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">Back foot elevated on chair or couch, front foot forward. Hold KB goblet style or at sides. Slow descent, feel right glute engaging at bottom. Drive through the front heel to stand. Right leg first every set. These are taxing — full 2 minutes rest between sets is earned.</div>
      <div class="exercise-tip"><span class="tag">Why it matters</span><br>Primary posterior chain developer. More glute-specific than regular lunges due to the elevated back foot. Right side always first.</div>
      <div class="sets-tracker">
        <div class="sets-label">Sets (R/L)</div>
        <div class="sets-row">
          <button class="set-btn" onclick="toggleSet(this, 120)">R1</button>
          <button class="set-btn" onclick="toggleSet(this, 120)">R2</button>
          <button class="set-btn" onclick="toggleSet(this, 120)">R3</button>
          <button class="set-btn" onclick="toggleSet(this)">L1</button>
          <button class="set-btn" onclick="toggleSet(this)">L2</button>
          <button class="set-btn" onclick="toggleSet(this)">L3</button>
        </div>
      </div>
    </div>
  </div>

  <div class="exercise" id="ex-rdl">
    <div class="exercise-header" onclick="toggleExercise('ex-rdl')">
      <div class="check" onclick="toggleComplete(event, 'ex-rdl')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Single leg RDL</div>
        <div class="exercise-meta">3 sets · 10 reps each leg · 90 sec rest</div>
      </div>
      <div class="exercise-weight" id="rdl-weight">16 kg</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">Standing, KB in opposite hand to standing leg. Slight bend in standing knee. Hinge from hip — back flat, KB travels close to the leg down toward mid-shin. Feel the hamstring load at the bottom. Return by driving through the heel and squeezing the glute at the top. Right side first every set.</div>
      <div class="exercise-tip"><span class="tag">Why it matters</span><br>Targets the upper hamstring/semimembranosus — the area that fatigues on long bike efforts. Consistent work here directly improves bike endurance.</div>
      <div class="flag-note"><span class="tag">Caution</span><br>Right knee inside-back discomfort has been present. If you feel it during RDL, reduce range of motion slightly rather than stopping entirely — keep the hinge within pain-free range.</div>
      <div class="sets-tracker">
        <div class="sets-label">Sets (R/L)</div>
        <div class="sets-row">
          <button class="set-btn" onclick="toggleSet(this, 90)">R1</button>
          <button class="set-btn" onclick="toggleSet(this, 90)">R2</button>
          <button class="set-btn" onclick="toggleSet(this, 90)">R3</button>
          <button class="set-btn" onclick="toggleSet(this)">L1</button>
          <button class="set-btn" onclick="toggleSet(this)">L2</button>
          <button class="set-btn" onclick="toggleSet(this)">L3</button>
        </div>
      </div>
    </div>
  </div>

  <div class="exercise" id="ex-calf">
    <div class="exercise-header" onclick="toggleExercise('ex-calf')">
      <div class="check" onclick="toggleComplete(event, 'ex-calf')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Single leg calf raise</div>
        <div class="exercise-meta">3 sets · 12–15 reps each leg · 3 sec lower</div>
      </div>
      <div class="exercise-weight">21 kg</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">Stand on a step if available for full range. Hold 21kg KB in same-side hand. Slow lowering (3 seconds down) — the eccentric is where the adaptation happens. Rise on 1 second. The soleus took a hit from FRC hill sessions — consistent calf work prevents recurrence and supports Achilles health through the training block.</div>
      <div class="sets-tracker">
        <div class="sets-label">Sets (R/L)</div>
        <div class="sets-row">
          <button class="set-btn" onclick="toggleSet(this)">R1</button>
          <button class="set-btn" onclick="toggleSet(this)">R2</button>
          <button class="set-btn" onclick="toggleSet(this)">R3</button>
          <button class="set-btn" onclick="toggleSet(this)">L1</button>
          <button class="set-btn" onclick="toggleSet(this)">L2</button>
          <button class="set-btn" onclick="toggleSet(this)">L3</button>
        </div>
      </div>
    </div>
  </div>

  <div class="exercise flagged" id="ex-copenhagen">
    <div class="exercise-header" onclick="toggleExercise('ex-copenhagen')">
      <div class="check" onclick="toggleComplete(event, 'ex-copenhagen')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Copenhagen plank</div>
        <div class="exercise-meta">3 sets · 25–30 sec each side</div>
      </div>
      <div class="exercise-weight">BW</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">Side plank with top leg resting on a chair or bench. Bottom leg hangs free. Hold the position — adductors and glute med working simultaneously. This directly addresses the inner thigh fatigue pattern from long bike efforts.</div>
      <div class="flag-note"><span class="tag">Caution</span><br>Right knee inside-back discomfort — use KNEE as the lever point on the chair, not ankle or foot. This shortens the mechanical arm, reducing adductor load to a manageable level. Progress: knee → mid-shin → ankle as the knee resolves over weeks.</div>
      <div class="sets-tracker">
        <div class="sets-label">Sets (R/L)</div>
        <div class="sets-row">
          <button class="set-btn" onclick="toggleSet(this)">R1</button>
          <button class="set-btn" onclick="toggleSet(this)">R2</button>
          <button class="set-btn" onclick="toggleSet(this)">R3</button>
          <button class="set-btn" onclick="toggleSet(this)">L1</button>
          <button class="set-btn" onclick="toggleSet(this)">L2</button>
          <button class="set-btn" onclick="toggleSet(this)">L3</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- PHASE 3: FINISHER -->
<div class="phase">
  <div class="phase-header">
    <div class="phase-num">3</div>
    <div class="phase-title">Finisher + cooldown</div>
    <div class="phase-duration">~8 min</div>
  </div>

  <div class="exercise" id="ex-bridge-finish">
    <div class="exercise-header" onclick="toggleExercise('ex-bridge-finish')">
      <div class="check" onclick="toggleComplete(event, 'ex-bridge-finish')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Double leg glute bridge — holds</div>
        <div class="exercise-meta">15 reps · 5 sec hold at top</div>
      </div>
      <div class="exercise-weight">BW</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">Both feet flat, drive hips up, hold 5 seconds. Squeeze glutes deliberately at the top — this is activation, not load. End every session with glutes firing, not fatigued. It reinforces the neuromuscular pattern for the next 24 hours.</div>
    </div>
  </div>

  <div class="exercise" id="ex-hipflexor">
    <div class="exercise-header" onclick="toggleExercise('ex-hipflexor')">
      <div class="check" onclick="toggleComplete(event, 'ex-hipflexor')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Couch stretch — hip flexors</div>
        <div class="exercise-meta">2 min each side</div>
      </div>
      <div class="exercise-weight">—</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">Kneel with shin against wall or couch, other foot forward. Upright torso, squeeze glute of back leg. The psoas attaches directly to your lumbar vertebrae — when this releases after squatting and loading, the lower back decompresses immediately. Non-negotiable post-session.</div>
      <div class="exercise-tip"><span class="tag">Why it matters</span><br>Most important post-gym stretch for lower back health. The psoas is almost certainly contributing to your remaining back tightness.</div>
    </div>
  </div>

  <div class="exercise" id="ex-pigeon">
    <div class="exercise-header" onclick="toggleExercise('ex-pigeon')">
      <div class="check" onclick="toggleComplete(event, 'ex-pigeon')">✓</div>
      <div class="exercise-info">
        <div class="exercise-name">Pigeon pose — right side priority</div>
        <div class="exercise-meta">3 min right · 1 min left</div>
      </div>
      <div class="exercise-weight">—</div>
      <div class="chevron">▾</div>
    </div>
    <div class="exercise-body">
      <div class="exercise-desc">Right leg forward, shin at angle, left leg extended behind. Fold forward over the front leg. 3 minutes right side — min 1 resisting, min 2 yielding, min 3 real change happening. The piriformis releases under sustained passive load, not under stretching effort. Breathe into it.</div>
      <div class="exercise-tip"><span class="tag">Why it matters</span><br>Your most important gym-day stretch. The piriformis pattern drives every right-side issue in your training history.</div>
    </div>
  </div>
</div>

<!-- Progression notes -->
<div class="note-box" style="margin-top:8px">
  <strong>Progression:</strong> 12kg → build technique confidence → 16kg for most exercises (2–3 weeks) → 21kg goblet squat when 16kg is easy for 12 clean reps → gym for hip thrust machine once back is fully cleared (highest value exercise home setup can't replicate well).
</div>

<button class="reset-btn" onclick="resetSession()">Reset session</button>

</div>

<footer class="page-footer">
  <p>Triaperformance · <a href="mailto:coach@triaperformance.com">coach@triaperformance.com</a></p>
</footer>

<!-- Rest timer -->
<div class="rest-timer" id="restTimer">
  <div class="rest-label">Rest</div>
  <div class="rest-time" id="restDisplay">1:30</div>
  <div class="rest-close" onclick="closeTimer()">skip</div>
</div>

<script>
  let totalExercises = 9;
  let completedCount = 0;
  let currentWeight = '12kg';
  let timerInterval = null;
  let timerSeconds = 0;

  const weightMap = {
    goblet: { '12kg': '12 kg', '16kg': '16 kg', '21kg': '21 kg' },
    bulgarian: { '12kg': '12 kg', '16kg': '12–16 kg', '21kg': '16 kg' },
    rdl: { '12kg': '12 kg', '16kg': '16 kg', '21kg': '16–21 kg' }
  };

  function setWeight(w, btn) {
    currentWeight = w;
    document.querySelectorAll('.weight-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const g = document.getElementById('goblet-weight');
    const b = document.getElementById('bulgarian-weight');
    const r = document.getElementById('rdl-weight');
    if (g) g.textContent = weightMap.goblet[w];
    if (b) b.textContent = weightMap.bulgarian[w];
    if (r) r.textContent = weightMap.rdl[w];
  }

  function toggleExercise(id) {
    const ex = document.getElementById(id);
    ex.classList.toggle('open');
  }

  function toggleComplete(e, id) {
    e.stopPropagation();
    const ex = document.getElementById(id);
    const wasComplete = ex.classList.contains('completed');
    ex.classList.toggle('completed');
    completedCount = wasComplete ? completedCount - 1 : completedCount + 1;
    updateProgress();
  }

  function updateProgress() {
    const pct = (completedCount / totalExercises) * 100;
    document.getElementById('progressFill').style.width = pct + '%';
    document.getElementById('progressCount').textContent = completedCount + ' / ' + totalExercises + ' exercises';
  }

  function toggleSet(btn, restSeconds) {
    btn.classList.toggle('done');
    if (btn.classList.contains('done') && restSeconds) {
      startRestTimer(restSeconds);
    }
  }

  function startRestTimer(seconds) {
    clearInterval(timerInterval);
    timerSeconds = seconds;
    const timer = document.getElementById('restTimer');
    timer.style.display = 'block';
    updateTimerDisplay();
    timerInterval = setInterval(() => {
      timerSeconds--;
      updateTimerDisplay();
      if (timerSeconds <= 0) {
        clearInterval(timerInterval);
        timer.style.display = 'none';
        try { navigator.vibrate && navigator.vibrate([300, 100, 300]); } catch(e) {}
      }
    }, 1000);
  }

  function updateTimerDisplay() {
    const m = Math.floor(timerSeconds / 60);
    const s = timerSeconds % 60;
    document.getElementById('restDisplay').textContent = m + ':' + (s < 10 ? '0' : '') + s;
  }

  function closeTimer() {
    clearInterval(timerInterval);
    document.getElementById('restTimer').style.display = 'none';
  }

  function resetSession() {
    document.querySelectorAll('.exercise').forEach(ex => {
      ex.classList.remove('completed', 'open');
    });
    document.querySelectorAll('.set-btn').forEach(btn => {
      btn.classList.remove('done');
    });
    completedCount = 0;
    updateProgress();
    closeTimer();
  }
</script>
