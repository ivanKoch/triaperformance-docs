        cue: "Banda anclada a la altura del codo, codo pegado al cuerpo. Rota hacia afuera y <strong>vuelve más lento de lo que fuiste</strong>. Rango corto y control." }] },

    latWalk: { name: "Caminata lateral en media sentadilla", mode: "bi", tag: "Sin equipo", secs: 60,
      cue: "Media sentadilla, pecho alto, y camina de lado dando pasos parejos sin juntar los pies del todo. <strong>Las rodillas empujando hacia afuera todo el tiempo</strong> y la cadera a la misma altura. Ida y vuelta.",
      variants: [{ name: "Caminata lateral con minibanda", mode: "bi", tag: "Minibanda",
        cue: "Banda en los tobillos o por encima de las rodillas. Mismo paso contra resistencia, <strong>y sin que el pie de atrás se arrastre</strong>." }] },

    calfEcc: { name: "Elevación de talones excéntrica", mode: "bi", tag: "Sin equipo", secs: 60,
      cue: "Sube con las dos piernas y <strong>baja con una sola, contando tres segundos</strong>. La bajada es el ejercicio. Alterna la pierna que baja.",
      variants: [{ name: "Excéntricas en escalón", mode: "bi", tag: "Escalón",
        cue: "Media planta en el borde de un escalón. Sube con dos, baja con una <strong>dejando caer el talón por debajo del escalón</strong>, tres segundos. Si estás con el protocolo de aquiles, no sumes volumen aquí: cuenta estas series como parte de aquel." }] },

    plantarFlex: { name: "Flexión plantar activa", mode: "bi", tag: "Sin equipo", secs: 45,
      cue: "Sentado con las piernas estiradas, <strong>apunta las puntas de los pies lo más lejos que puedas y sostén cinco segundos</strong>, después tráelas hacia ti. Activa, no pasiva: es el rango que empuja el agua en la patada." },

    tva: { name: "Activación de transverso", mode: "bi", tag: "Sin equipo", secs: 60,
      cue: "Boca arriba, rodillas dobladas, manos sobre los huesos de la cadera por dentro. <strong>Inhala al abdomen, y al exhalar lleva el ombligo hacia adentro y hacia arriba sin mover la pelvis.</strong> Deberías sentir una tensión suave debajo de los dedos. Es sutil, y es la base de todo lo demás." },

    reverseLunge: { name: "Estocada inversa con brazos arriba", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Paso largo hacia atrás bajando la rodilla, <strong>con los dos brazos estirados por encima de la cabeza y las costillas abajo</strong>. Los brazos arriba son lo que convierte esto en trabajo de cadera y torácica a la vez." }
  };

  /* ------------------------------------------------------------- ROUTINES
     Three tiers, three named blocks, and the tiers GROW THE BLOCKS rather than
     appending new ones. That is the difference from /members/movilidad/, and it
     is deliberate: there the tiers were the story (unload, then the rest of the
     chain, then the forgotten spots), here the BLOCKS are the story, because
     the athlete has to be able to see that a third of this session is
     activation work and not mobility. Decision 4.

     So: 30 = BASE, 45 = BASE + EXT, 60 = BASE + EXT + DEEP, merged per block.
     `mov` always opens. Decision 1 lives in the ORDER of these lists — the
     CARs, flows, PNF and holds come first inside `mov`, and the movements that
     also exist in /members/core/ or the activation matrix follow them. */
  const BASE = {
    run: {
      mov:  ["carsHip", "carsAnkle", "carsSpine", "nineNinety", "dogFlow", "deepSquatHold", "wgs", "legSwing"],
      act:  ["calfEcc", "bridgeSingle", "birdDog", "deadBug", "balance"],
      hold: ["pnfHam", "frog"] },
    bike: {
      mov:  ["carsSpine", "carsHip", "deepSquatHold", "threadNeedle", "openBook", "nineNinety", "spiderman", "catcow"],
      act:  ["clamshell", "birdDog", "tva", "sidePlank"],
      hold: ["pnfHip", "frog"] },
    swim: {
      mov:  ["carsShoulder", "neckCars", "carsSpine", "carsHip", "deepSquatHold", "wallAngel", "threadNeedle", "openBook", "catcow"],
      act:  ["ytwl", "scapPushup", "extRotation", "deadBug", "plantarFlex"],
      hold: ["pnfHip", "dragon"] },
    tri: {
      mov:  ["carsHip", "carsShoulder", "carsSpine", "dogFlow", "nineNinety", "deepSquatHold", "spiderman", "catcow"],
      act:  ["clamshell", "birdDog", "deadBug", "balance", "calfEcc"],
      hold: ["pnfHip", "frog"] },
    all: {
      mov:  ["carsHip", "carsShoulder", "carsSpine", "carsAnkle", "dogFlow", "deepSquatHold", "wgs", "catcow"],
      act:  ["bridgeSingle", "birdDog", "deadBug", "sidePlank", "balance"],
      hold: ["pnfHam", "frog"] }
  };

  const EXT = {
    run:  { mov: ["cossack", "kneeWall", "inchworm", "catcow"], act: ["latWalk", "sidePlank"], hold: ["pnfHip", "rollDown"] },
    bike: { mov: ["cossack", "kneeWall", "wallAngel", "legSwing"], act: ["latWalk", "bridgeSingle"], hold: ["pnfHam", "rollDown"] },
    swim: { mov: ["scorpion", "spiderman", "kneeWall", "wgs"], act: ["bearCrawl", "sidePlank"], hold: ["frog", "rollDown"] },
    tri:  { mov: ["inchworm", "cossack", "kneeWall", "wallAngel"], act: ["gluteBridgeMarch", "sidePlank"], hold: ["pnfHam", "rollDown"] },
    all:  { mov: ["cossack", "inchworm", "openBook", "legSwing"], act: ["reverseLunge", "bearCrawl"], hold: ["pnfHip", "rollDown"] }
  };

  const DEEP = {
    run:  { mov: ["sunFlow", "carsShoulder"], act: ["gluteBridgeMarch", "tva"], hold: ["dragon", "bodyScan"] },
    bike: { mov: ["sunFlow", "carsAnkle"], act: ["gluteBridgeMarch", "deadBug"], hold: ["dragon", "bodyScan"] },
    swim: { mov: ["sunFlow", "carsAnkle"], act: ["birdDog", "balance"], hold: ["pnfHam", "bodyScan"] },
    tri:  { mov: ["warriorFlow", "carsAnkle"], act: ["bearCrawl", "tva"], hold: ["dragon", "bodyScan"] },
    all:  { mov: ["sunFlow", "threadNeedle"], act: ["scapPushup", "tva"], hold: ["dragon", "bodyScan"] }
  };

  /* The block names ARE the honesty requirement from decision 4. Do not rename
     "Activación" to something softer: the athlete is entitled to know that this
     part of a recovery session is strength and control work. */
  const PHASE = { mov: "Movilidad", act: "Activación", hold: "Posturas largas" };

  const SPORT = {
    run:  "Recuperación para corredores",
    bike: "Recuperación para ciclistas",
    swim: "Recuperación para nadadores",
    tri:  "Recuperación para triatletas",
    all:  "Recuperación de cuerpo completo"
  };

  const SUBTITLE = {
    run:  "Cadera, tobillo y cadena posterior, con control lento y posturas largas. Es una sesión suave, no un día libre.",
    bike: "Rotación torácica, independencia de cadera y el glúteo que la bici apaga. Es una sesión suave, no un día libre.",
    swim: "Control escapular, torácica y cuello — y el tobillo, que en el agua empuja. Es una sesión suave, no un día libre.",
    tri:  "Las tres cadenas conectadas, más equilibrio y propiocepción. Es una sesión suave, no un día libre.",
    all:  "Recorrido completo de arriba a abajo, sin deporte asignado. Es una sesión suave, no un día libre."
  };

  const WHY = {
    run:  "Un día sin correr es cuando el tejido acepta trabajo que no aceptaría cansado: rango controlado, posturas pasivas largas y contracción-suelta. Nada de esto entra en los diez minutos antes de una sesión, y es exactamente lo que le falta a un corredor que solo corre.",
    bike: "La bici te deja tres deudas que no se pagan pedaleando: torácica que no rota, cadera que solo trabaja en un plano y glúteo que se apagó. Un día suelto es cuando se pueden atacar de verdad, porque hay tiempo para lo lento y para lo largo.",
    swim: "El hombro del nadador no se arregla estirando: se arregla con control escapular y rango que puedas sostener. Eso es trabajo lento y repetido, y necesita un día en el que no tengas que entrar al agua después.",
    tri:  "Tres deportes dejan tres patrones y ninguno se corrige apurado. Este es el día para lo que no entra en una activación: CARs largos, posturas pasivas, contracción-suelta y equilibrio, que es lo primero que se pierde con el volumen.",
    all:  "Un día de recuperación bien usado hace más por tu rango que tres activaciones apuradas. Aquí hay tiempo para lo lento, lo largo y lo aburrido, que es donde está casi todo el beneficio."
  };

  const DONE = {
    run:  "Listo. Eso es una sesión, no un descanso — tenlo en cuenta mañana.",
    bike: "Listo. Eso es una sesión, no un descanso — tenlo en cuenta mañana.",
    swim: "Listo. Eso es una sesión, no un descanso — tenlo en cuenta mañana.",
    tri:  "Listo. Eso es una sesión, no un descanso — tenlo en cuenta mañana.",
    all:  "Listo. Eso es una sesión, no un descanso — tenlo en cuenta mañana."
  };

  /* Same sport-aware hand-off as /members/movilidad/, same reason:
     methodology.md §11 in the product. Mobility and recovery are not rehab. */
  const PAIN = {
    run:  'Si algo <strong>duele</strong> en vez de sentirse duro, esto no es lo tuyo hoy: pasa por <a href="/members/rodillas/">Rodillas</a> o <a href="/members/aquiles/">Aquiles</a>. Y si el dolor sigue, es consulta médica, no una rutina.',
    bike: 'Si algo <strong>duele</strong> en vez de sentirse duro, esto no es lo tuyo hoy: pasa por <a href="/members/rodillas/">Rodillas</a>. Y si el dolor sigue, es consulta médica, no una rutina.',
    swim: 'Si el hombro <strong>duele</strong> en vez de sentirse duro, esto no es lo tuyo hoy: pasa por <a href="/members/hombro/">Hombro de nadador</a>. Y si el dolor sigue, es consulta médica, no una rutina.',
    tri:  'Si algo <strong>duele</strong> en vez de sentirse duro, esto no es lo tuyo hoy: pasa por <a href="/members/rodillas/">Rodillas</a>, <a href="/members/aquiles/">Aquiles</a> u <a href="/members/hombro/">Hombro</a>. Y si el dolor sigue, es consulta médica, no una rutina.',
    all:  'Si algo <strong>duele</strong> en vez de sentirse duro, esto no es lo tuyo hoy: pasa por <a href="/members/rodillas/">Rodillas</a>, <a href="/members/aquiles/">Aquiles</a> u <a href="/members/hombro/">Hombro</a>. Y si el dolor sigue, es consulta médica, no una rutina.'
  };

  const SPORT_HINT = {
    run: "", bike: "", swim: "",
    tri:  "Para el que hace los tres: prioriza cadera y hombro, y suma equilibrio.",
    all:  "Sin deporte asignado. Sirve igual para un día de gimnasio o para uno de escritorio."
  };

  /* Chrome the shared engine would otherwise render as "activación". See
     ai-infrastructure-documentation.md §39 and §40 — three strings, three
     different landing places, and `doneTitle` is markup rather than an engine
     string. *** THESE TRAVEL WITH ANY TRANSLATION OF THIS PAGE. *** */
  const UI_OVERRIDE = { startRoutine: "Empezar la sesión →" };
  const DONE_TITLE = "Sesión completa";

  function build(sport, mins) {
    const m = String(mins);
    if (!BASE[sport]) throw new Error("Unknown sport: " + sport);
    if (["30", "45", "60"].indexOf(m) === -1) throw new Error("Unknown duration: " + m);

    const pick = ids => ids.map(id => {
      const ex = L[id];
      if (!ex) throw new Error("Unknown exercise id: " + id);
      return Object.assign({ video: null, variants: [] }, ex);
    });

    const merge = block => {
      let ids = BASE[sport][block].slice();
      if (m === "45" || m === "60") ids = ids.concat(EXT[sport][block]);
      if (m === "60") ids = ids.concat(DEEP[sport][block]);
      return ids;
    };

    return {
      title: SPORT[sport],
      crumb: "Recuperación",
      subtitle: SUBTITLE[sport],
      context: m + " minutos",
      why: WHY[sport],
      doneSub: DONE[sport],
      kicker: "Recuperación activa",
      restSeconds: 10,
      phases: ["mov", "act", "hold"].map(b => ({ name: PHASE[b], exercises: pick(merge(b)) }))
    };
  }

  return { build: build, library: L, base: BASE, ext: EXT, deep: DEEP,
           phase: PHASE, pain: PAIN, sportHint: SPORT_HINT, ui: UI_OVERRIDE,
           doneTitle: DONE_TITLE };
})();

/* --------------------------------------------------------------- SETUP UI
   Same two-question shape as /members/movilidad/. What is sport-aware here is
   the pain hand-off; the load warning and the "are you training today?" aside
   are constant, because they are true for every sport. */
(function () {
  const M = window.RECOVERY_MATRIX;
  const choice = { sport: "run", mins: "30" };

  function renderSportBits() {
    const hint = document.getElementById("sportHint");
    hint.innerHTML = M.sportHint[choice.sport] || "";
    hint.hidden = !M.sportHint[choice.sport];
    document.getElementById("painAside").innerHTML = M.pain[choice.sport];
  }

  document.querySelectorAll(".setup-opts[data-axis]").forEach(group => {
    const axis = group.dataset.axis;
    group.querySelectorAll(".setup-opt").forEach(btn => {
      btn.addEventListener("click", () => {
        choice[axis] = btn.dataset.val;
        group.querySelectorAll(".setup-opt").forEach(b =>
          b.setAttribute("aria-pressed", String(b === btn)));
        if (axis === "sport") renderSportBits();
      });
    });
  });

  renderSportBits();

  document.getElementById("setupGo").addEventListener("click", () => {
    window.ACTIVATION_DATA = M.build(choice.sport, choice.mins);
    Object.assign(window.ACTIVATION_UI, M.ui);

    document.getElementById("setup").hidden = true;
    document.getElementById("toolWrap").hidden = false;

    document.getElementById("doneSub").textContent = window.ACTIVATION_DATA.doneSub;
    document.getElementById("crumbLabel").textContent = window.ACTIVATION_DATA.crumb;
    document.getElementById("doneTitle").textContent = M.doneTitle;

    const s = document.createElement("script");
    s.src = "/assets/js/activation-tool.js";
    document.body.appendChild(s);

    s.addEventListener("load", () => {
      const back = document.createElement("button");
      back.className = "change-link setup-back";
      back.textContent = "← Cambiar opciones";
      back.addEventListener("click", () => location.reload());
      document.querySelector(".tool").prepend(back);
    });
  });
})();
</script>
