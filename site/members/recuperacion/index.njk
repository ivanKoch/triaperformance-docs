    carsShoulder: { name: "CARs de hombro", mode: "uni", tag: "Sin equipo", secs: 60,
      cue: "Brazo estirado, súbelo por adelante hasta arriba, rótalo y baja por atrás, dibujando el círculo más amplio posible. <strong>Costillas abajo y la otra mano en el esternón para sentir si el tronco se mueve.</strong> Dos o tres vueltas en el minuto, con tensión en todo el brazo." },

    carsSpine: { name: "CARs de columna", mode: "bi", tag: "Sin equipo", secs: 90,
