<script>
window.MOBILITY_MATRIX = (function () {

  /* ---------------------------------------------------------------- LIBRARY
     One definition per exercise, one cue. An exercise shared by four sports
     cannot drift into four slightly different cues, which is the whole reason
     this is a library and a set of id lists rather than 15 written routines.

     `secs` is the hold. The engine's default is 40; post-session the standard
     here is 45 (60 for the decompression pieces, 30 for the light ones), which
     is deliberately SHORTER than the source doc's 2-4 minutes per movement.
     Long passive holds are the recovery-day tool's job.

     `variants` carry the roller and ball versions. The base routine never needs
     them, and the engine hides its own "Cambiar ejercicio" button on any
     exercise that has none. */
  const L = {

    /* ------------------------------------------------------- PIERNA / CADERA */
    calfWall: { name: "Sóleo en pared", mode: "uni", tag: "Pared", secs: 45,
      cue: "Punta del pie contra la pared, talón en el piso, y <strong>llevá la rodilla hacia la pared manteniéndola flexionada</strong>. Rodilla doblada es sóleo, y el sóleo es el que se come la carga cuando corrés. Si lo sentís en la panza del gemelo, doblá más la rodilla.",
      variants: [{ name: "Gemelos con rodillo", mode: "uni", tag: "Rodillo",
        cue: "Sentado, el gemelo sobre el rodillo y la otra pierna cruzada encima para cargar. <strong>Parate 20 segundos en el punto que más se queja</strong> en vez de ir y venir rápido." }] },

    calfGastro: { name: "Gemelo en pared", mode: "uni", tag: "Pared", secs: 45,
      cue: "Misma posición, pero ahora <strong>con la rodilla estirada y el talón clavado en el piso</strong>. Rodilla derecha es gemelo. Cadera adelante y tronco erguido — si te vas de espaldas, perdiste el estiramiento." },

    hamSupine: { name: "Isquios boca arriba", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Agarrate por detrás del muslo y <strong>estirá la rodilla hasta donde llegue sin que la cadera se despegue del piso</strong>. La otra pierna queda apoyada. La punta del pie hacia vos recién al final, no desde el principio.",
      variants: [{ name: "Isquios con toalla", mode: "uni", tag: "Toalla",
        cue: "Toalla en la planta del pie, pierna extendida hacia el techo. <strong>Tirá desde la toalla, no desde el cuello.</strong>" }] },

    fig4: { name: "Figura 4 boca arriba", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Cruzá un tobillo sobre la rodilla contraria y traé la pierna de abajo hacia el pecho. <strong>Empujá suave la rodilla cruzada hacia afuera con el codo.</strong> Empezá por el lado que sentís más rígido.",
      variants: [{ name: "Glúteo con pelota", mode: "uni", tag: "Pelota",
        cue: "Sentado sobre la pelota, buscá el punto del glúteo que se queja y <strong>quedate quieto ahí respirando</strong> en vez de rodar. Cruzá el tobillo sobre la rodilla para llegar más profundo." }] },

    psoas: { name: "Psoas de rodillas con apriete", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Media rodilla, pie de adelante plano. <strong>Meté la pelvis y apretá fuerte el glúteo de atrás antes de avanzar</strong> — sin ese apriete estás estirando la lumbar y no el psoas. Ese apriete es el ejercicio." },

    quadSide: { name: "Cuádriceps de costado", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "De costado, agarrá el tobillo de arriba y llevá el talón a la cola <strong>con la pelvis metida y la rodilla apuntando al piso</strong>, no abierta hacia afuera. Si la lumbar se arquea, aflojá el rango.",
      variants: [{ name: "Cuádriceps con rodillo", mode: "uni", tag: "Rodillo",
        cue: "Boca abajo, el muslo sobre el rodillo, del pliegue de la cadera hasta arriba de la rodilla. <strong>Presión media: si tenés que aguantar la respiración, es demasiada.</strong>" },
        { name: "Couch stretch en pared", mode: "uni", tag: "Pared",
        cue: "De rodillas de espaldas a la pared, el empeine apoyado en ella. <strong>Meté la pelvis antes de subir el tronco</strong> — casi nadie necesita subir tanto como cree." }] },

    itCross: { name: "Cruce de cadera externa", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Boca arriba, llevá una rodilla cruzada al lado opuesto <strong>dejando que la pelvis rote con ella</strong>, brazos abiertos. Buscás el tensor y el glúteo, por fuera de la cadera. <strong>La cintilla iliotibial no se estira ni se ablanda a golpes: lo que se afloja es lo que tira de ella.</strong>",
      variants: [{ name: "Tensor y vasto externo con rodillo", mode: "uni", tag: "Rodillo",
        cue: "El rodillo justo debajo del hueso de la cadera por fuera, y después en el lateral del muslo. <strong>Presión moderada y lenta.</strong> No busques la cintilla: buscá el músculo de arriba y el de adelante-afuera." }] },

    adductor: { name: "Estocada lateral en media rodilla", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "De rodillas, una pierna estirada al costado con el pie apoyado, y <strong>llevá la cadera hacia atrás y hacia el lado contrario</strong>. Espalda larga. Es el aductor largo, que en carrera y en bici trabaja mucho más de lo que nadie cree." },

    butterfly: { name: "Mariposa", mode: "bi", tag: "Sin equipo", secs: 60,
      cue: "Plantas de los pies juntas, y <strong>inclinate desde la cadera con la espalda larga</strong> — no redondees para llegar más abajo, que es puro engaño. Los codos pueden empujar suave las rodillas." },

    footArch: { name: "Arco y dedos del pie", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Sentado sobre los talones con los dedos de los pies flexionados hacia adelante — si es mucho, apoyá las manos y sacá peso. Después abrí y cerrá los dedos. <strong>La fascia plantar se endurece después de correr y nadie la toca hasta que duele.</strong>",
      variants: [{ name: "Fascia plantar con pelota", mode: "uni", tag: "Pelota",
        cue: "Rodá la planta del pie sobre la pelota, del talón a los dedos, lento, <strong>frenando en los puntos que se quejan</strong>. Presión que puedas sostener respirando normal." }] },

    ankleKick: { name: "Tobillos y empeine", mode: "bi", tag: "Sin equipo", secs: 45,
      cue: "Sentado sobre los talones con los empeines planos en el piso, <strong>y subí apenas las rodillas para cargar el empeine</strong>. Después, círculos amplios de tobillo. Si venís de nadar, un tobillo que no apunta frena la patada; si venís de correr, es el que se te puso duro.",
      variants: [{ name: "Empeine y tibial con rodillo", mode: "bi", tag: "Rodillo",
        cue: "En cuadrupedia, el rodillo sobre la parte de adelante de la tibia, y rodá despacio de la rodilla al tobillo. Zona sensible: <strong>menos presión de la que creés.</strong>" }] },

    /* ------------------------------------------------------- TRONCO / ESPALDA */
    childPose: { name: "Postura del niño", mode: "bi", tag: "Sin equipo", secs: 60,
      cue: "Sentado sobre los talones, brazos largos adelante, frente al piso. <strong>Respirá hacia la espalda baja</strong> y dejá que la cadera baje un poco más con cada exhalación. Acá el objetivo es bajar pulsaciones, no estirar más." },

    childReach: { name: "Niño con alcance lateral", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Desde la postura del niño, caminá las manos hacia un costado hasta sentir el dorsal por el lateral del tronco. <strong>La cadera se queda atrás</strong>, no la sigas con el tronco." },

    twist: { name: "Torsión boca arriba", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Rodilla cruzada al lado opuesto, brazos abiertos, mirada al lado contrario. <strong>El hombro no se despega del piso</strong> — si se despega, bajá la rodilla. Soltá un poco más en cada exhalación." },

    sphinx: { name: "Esfinge suave", mode: "bi", tag: "Sin equipo", secs: 60,
      cue: "Boca abajo, codos debajo de los hombros, pelvis pesada en el piso. <strong>Es una extensión suave y sostenida, no una cobra.</strong> Si te aprieta la lumbar, llevá los codos más adelante hasta que deje de apretar." },

    openBook: { name: "Libro abierto", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "De costado, rodillas flexionadas y apiladas, brazos juntos adelante. <strong>Abrí el brazo de arriba siguiendo la mano con la mirada, y dejá las rodillas quietas.</strong> Si las rodillas se separan, la rotación se te fue a la lumbar." },

    catcow: { name: "Gato-camello", mode: "bi", tag: "Sin equipo", secs: 45,
      cue: "En cuadrupedia, alterná redondear y arquear al ritmo de la respiración. <strong>Vértebra por vértebra</strong>, no en bloque. Lento: post-entreno esto es para soltar, no para movilizar fuerte." },

    thoracicExt: { name: "Extensión torácica en cuadrupedia", mode: "bi", tag: "Sin equipo", secs: 60,
      cue: "De rodillas, antebrazos apoyados adelante y la cola hacia los talones. <strong>Hundí el pecho hacia el piso dejando que se abran las axilas.</strong> El movimiento es de la espalda alta: si se arquea la lumbar, acercá más la cola a los talones." },

    /* --------------------------------------------------------- HOMBRO / CUELLO
       El cruce de hombro reemplaza al sleeper stretch del documento original, y
       la apertura boca abajo reemplaza al estiramiento en el marco de la puerta.
       Las dos razones están arriba, en el bloque de notas. */
    crossBody: { name: "Cruce de hombro", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Llevá el brazo cruzado por delante del pecho y <strong>empujá desde el codo, nunca desde la muñeca</strong>. La clave: bajá el omóplato y no dejes que el hombro se vaya adelante. Si se va adelante, estás moviendo la escápula en vez de soltar la parte de atrás del hombro." },

    pecFloor: { name: "Apertura de pecho boca abajo", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Boca abajo, un brazo extendido en cruz a la altura del hombro, y rodá el cuerpo hacia ese lado apoyando el pie contrario. <strong>Buscá el pecho, no el frente del hombro</strong> — si lo sentís dentro de la articulación, bajá el brazo unos centímetros y volvé a probar.",
      variants: [{ name: "Pectoral menor con pelota", mode: "uni", tag: "Pelota",
        cue: "Boca abajo, la pelota debajo de la clavícula, por dentro del hombro. <strong>Presión suave y quieta.</strong> Esta zona no se rodea, se sostiene." }] },

