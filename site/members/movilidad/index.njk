  const DONE = {
    run:  "Listo. Come algo en la próxima media hora.",
    bike: "Listo. Come algo en la próxima media hora.",
    swim: "Listo. Come algo en la próxima media hora.",
    tri:  "Listo. Come algo en la próxima media hora.",
    all:  "Listo. Eso es la sesión completa."
