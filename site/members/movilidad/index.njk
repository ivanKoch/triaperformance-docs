<script>
window.MOBILITY_MATRIX = (function () {

  /* ---------------------------------------------------------------- LIBRARY
     One definition per exercise, one cue. An exercise shared by four sports
     cannot drift into four slightly different cues, which is the whole reason
     this is a library and a set of id lists rather than 15 written routines.

     `secs` is the hold. The engine's default is 40; post-session the standard
     here is 45 (60 for the decompression pieces, 30 for the light ones), which
     is deliberately SHORTER than the source doc's 2-4 minutes per movement.
     Long passive holds are the recovery-day tool's job.

     `variants` carry the roller and ball versions. The base routine never needs
     them, and the engine hides its own "Cambiar ejercicio" button on any
     exercise that has none. */
  const L = {

    /* ------------------------------------------------------- PIERNA / CADERA */
    calfWall: { name: "Sóleo en pared", mode: "uni", tag: "Pared", secs: 45,
      cue: "Punta del pie contra la pared, talón en el piso. Lleva la rodilla hacia la pared manteniéndola flexionada. Rodilla doblada es sóleo. Si lo sientes en el vientre del gemelo, dobla más la rodilla.",
      variants: [{ name: "Rodillo: vientre del gemelo", mode: "uni", tag: "Rodillo",
        cue: "<strong>Solo la parte carnosa del gemelo: nunca pases el rodillo por el tendón</strong> — es tejido muy inervado y la fricción ahí solo lo empeora. Sentado, el gemelo sobre el rodillo y la otra pierna cruzada encima para cargar. Cuando encuentres el punto que más se queja, párate ahí en vez de ir y venir rápido." }] },

    calfGastro: { name: "Gemelo en pared", mode: "uni", tag: "Pared", secs: 45,
      cue: "Manos en la pared, pierna de atrás recta, talón clavado. Rodilla estirada es gemelo. Cadera adelante y tronco erguido: si te vas de espaldas, perdiste el estiramiento." },

    hamSupine: { name: "Isquios boca arriba", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Agárrate por detrás del muslo y estira la rodilla hasta donde llegue sin que la cadera se despegue. La otra pierna apoyada. La punta del pie hacia ti solo al final, no desde el principio.",
      variants: [{ name: "Isquios con toalla", mode: "uni", tag: "Toalla",
        cue: "Toalla en la planta del pie, pierna extendida hacia el techo. <strong>Tira desde la toalla, no desde el cuello.</strong> La otra pierna queda apoyada en el piso." }] },

    fig4: { name: "Figura 4 boca arriba", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Boca arriba, cruza un tobillo sobre la rodilla contraria y trae el muslo de abajo hacia el pecho. Empuja suave la rodilla cruzada hacia afuera con el codo. <strong>Empieza por el lado que sientes más rígido.</strong> Respira largo y no fuerces el rango.",
      variants: [{ name: "Glúteo con pelota", mode: "uni", tag: "Pelota",
        cue: "Sentado sobre la pelota, busca el punto del glúteo que se queja y quédate quieto ahí respirando, no ruedes. Cruza el tobillo sobre la rodilla para llegar más profundo." }] },

    psoas: { name: "Psoas con apriete de glúteo", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Media rodilla, pie de adelante plano. <strong>Mete la pelvis y aprieta fuerte el glúteo de la pierna de atrás antes de avanzar la cadera.</strong> Sin ese apriete estás estirando la lumbar y no el psoas: ese apriete es el ejercicio." },

    quadSide: { name: "Cuádriceps de costado", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "De costado, agarra el tobillo de arriba y lleva el talón al glúteo. Pelvis metida, rodilla apuntando al piso, no abierta hacia afuera. Si la lumbar se arquea, afloja el rango.",
      variants: [{ name: "Rodillo: cuádriceps", mode: "uni", tag: "Rodillo",
        cue: "Boca abajo, el muslo sobre el rodillo, del pliegue de la cadera hasta justo arriba de la rótula. Presión media: si tienes que aguantar la respiración, es demasiada. <strong>Cuando encuentres un punto sensible, párate ahí y flexiona y estira la rodilla.</strong>" },
        { name: "Couch stretch", mode: "uni", tag: "Pared",
        cue: "De rodillas de espaldas a una pared o a la base de la cama, empeine de atrás apoyado y el otro pie adelante en zancada. <strong>Mete la pelvis y aprieta el glúteo de la pierna de atrás antes de subir el tronco.</strong> Sin eso, la pelvis rota y el estiramiento se lo lleva la lumbar en vez del psoas y el cuádriceps. Casi nadie necesita subir tanto como cree." }] },

    itCross: { name: "Cruce de cadera externa", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Boca arriba, lleva una rodilla cruzada al lado opuesto dejando que la pelvis rote, brazos abiertos. Buscas tensor y glúteo, por fuera de la cadera. La cintilla no se estira a golpes. <strong>No se ablanda a golpes: lo que se afloja es lo que tira de ella.</strong>",
      variants: [{ name: "Tensor y vasto externo con rodillo", mode: "uni", tag: "Rodillo",
        cue: "Rodillo justo debajo del hueso de la cadera por fuera, después en el lateral del muslo, arriba y adelante. Presión moderada y lenta. No ruedes la cintilla: es tendón, y se inflama." }] },

    adductor: { name: "Estocada lateral en media rodilla", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "De rodillas, una pierna estirada al costado con el pie apoyado. Lleva la cadera atrás y hacia el lado contrario. Espalda larga. Es el aductor largo." },

    butterfly: { name: "Mariposa", mode: "bi", tag: "Sin equipo", secs: 60,
      cue: "Plantas juntas. Inclínate desde la cadera con la espalda larga: redondear para llegar más abajo es puro engaño. Los codos pueden empujar suave las rodillas." },

    footArch: { name: "Arco y dedos del pie", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Sentado sobre los talones con los dedos flexionados hacia adelante. Si es mucho, apóyate con las manos. Después abre y cierra los dedos.",
      variants: [{ name: "Fascia plantar con pelota", mode: "uni", tag: "Pelota",
        cue: "De pie o sentado, rueda la planta sobre la pelota del talón a los dedos, lento. Cuando un punto se queje, párate ahí. Presión que puedas sostener respirando normal." }] },

    ankleKick: { name: "Tobillos y empeine", mode: "bi", tag: "Sin equipo", secs: 45,
      cue: "Sentado sobre los talones con los empeines planos en el piso. Sube apenas las rodillas para cargar el empeine. Después, círculos amplios de tobillo.",
      variants: [{ name: "Empeine y tibial con rodillo", mode: "bi", tag: "Rodillo",
        cue: "En cuadrupedia, el rodillo sobre la parte de adelante de la tibia. Rueda despacio de la rodilla al tobillo. Zona sensible: menos presión de la que crees." }] },

    /* ------------------------------------------------------- TRONCO / ESPALDA */
    childPose: { name: "Postura del niño", mode: "bi", tag: "Sin equipo", secs: 60,
      cue: "Sentado sobre los talones, brazos largos adelante, frente al piso. Respira profundo hacia la espalda baja y deja que la cadera baje un poco más con cada exhalación. <strong>El objetivo es bajar revoluciones, no estirar más.</strong>" },

    childReach: { name: "Postura del niño con alcance lateral", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Desde la postura del niño, camina las manos hacia un costado hasta sentir el dorsal por el lateral del tronco. <strong>La cadera se queda atrás</strong>, no la sigas con el tronco." },

    twist: { name: "Torsión espinal", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Acostado, rodilla cruzada al lado opuesto, brazos abiertos, mirada al lado contrario. <strong>El hombro no se despega del piso</strong>: si se despega, baja la rodilla. Suelta un poco más en cada exhalación." },

    sphinx: { name: "Esfinge suave", mode: "bi", tag: "Sin equipo", secs: 60,
      cue: "Boca abajo, codos debajo de los hombros, pelvis pesada en el piso. Extensión suave y sostenida, no una cobra. Si aprieta la lumbar, adelanta los codos." },

    openBook: { name: "Libro abierto", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "De costado, rodillas flexionadas y apiladas, brazos juntos adelante. Abre el brazo de arriba siguiéndolo con la mirada y <strong>deja las rodillas quietas</strong>. Si las rodillas se separan, la rotación se te fue a la lumbar." },

    catcow: { name: "Gato-camello", mode: "bi", tag: "Sin equipo", secs: 45,
      cue: "En cuadrupedia, alterna redondear y arquear la columna al ritmo de la respiración. <strong>Muévete desde la pelvis y deja que la columna la siga vértebra por vértebra</strong> — no en bloque, y no solo cuello y hombros. Esto es control pélvico y articular, no un estiramiento. Rango cómodo, no máximo." },

    thoracicExt: { name: "Extensión torácica en cuadrupedia", mode: "bi", tag: "Sin equipo", secs: 60,
      cue: "De rodillas, antebrazos adelante y glúteos hacia los talones. Hunde el pecho hacia el piso dejando que se abran las axilas. Si se arquea la lumbar, acerca más los glúteos a los talones." },

    /* --------------------------------------------------------- HOMBRO / CUELLO
       El cruce de hombro reemplaza al sleeper stretch del documento original, y
       la apertura boca abajo reemplaza al estiramiento en el marco de la puerta.
       Las dos razones están arriba, en el bloque de notas. */
    crossBody: { name: "Estiramiento cruzado de hombro", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Lleva el brazo cruzado por delante del pecho y sostenlo por arriba del codo, nunca desde la muñeca. <strong>Antes de tirar, baja el omóplato y no dejes que el hombro viaje adelante</strong>: si el omóplato se corre, estiras la espalda y no la parte de atrás del hombro. Tiene que sentirse atrás, nunca un pinchazo adelante." },

    pecFloor: { name: "Apertura de pecho boca abajo", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Boca abajo, un brazo en cruz a la altura del hombro. Rueda el cuerpo hacia ese lado apoyando el pie contrario. Busca el pecho, no el frente del hombro: si pinza adentro, baja el brazo unos centímetros.",
      variants: [{ name: "Pelota: pectoral menor", mode: "uni", tag: "Pelota",
        cue: "Coloca la pelota bajo la clavícula, por dentro del frente del hombro. <strong>Presión suave y quieta: esta zona no se rodea, se sostiene.</strong> No aplastes — aquí hay nervios y tendones, y esto no es un punto para pelear." }] },

    tricep: { name: "Tríceps y dorsal por encima de la cabeza", mode: "uni", tag: "Sin equipo", secs: 30,
      cue: "Codo arriba junto a la oreja, mano entre los omóplatos. Empuja suave el codo con la otra mano. Costillas abajo: si la lumbar se arquea, ganaste rango con la espalda y no con el hombro." },

    neckTrap: { name: "Cuello y trapecio", mode: "uni", tag: "Sin equipo", secs: 30,
      cue: "Sentado, la mano del lado que estiras sujeta el asiento. Lleva la oreja al hombro contrario sin encoger el hombro. No tires con la otra mano: el peso de la cabeza alcanza." },

    forearm: { name: "Antebrazos y muñecas", mode: "uni", tag: "Sin equipo", secs: 30,
      cue: "En cuadrupedia, gira la mano hasta que los dedos apunten a las rodillas y siéntate lento hacia atrás. Después apoya el dorso de la mano para el otro lado. No fuerces si pinza." },

    /* --------------------------------------------------------------- CIERRE */
    wallLegs: { name: "Piernas en la pared", mode: "bi", tag: "Pared", secs: 120,
      cue: "Glúteos cerca de la pared, piernas verticales apoyadas, brazos al costado. No estás estirando: estás bajando pulsaciones. Si tira mucho de los isquios, aléjate un poco." },

    breathClose: { name: "Respiración de cierre", mode: "bi", tag: "Sin equipo", secs: 180,
      cue: "Boca arriba, rodillas dobladas, una mano en el pecho y otra en el abdomen. Inhala 4 segundos por la nariz al abdomen, exhala 6 por la boca. La exhalación larga es la que baja el sistema. Si quieres un protocolo con timer, tienes <a href=\"/members/respiracion/\">Respiración en caja</a>." }
  };

  /* ------------------------------------------------------------- ROUTINES
     Three tables, not fifteen routines. BASE is the 10-minute session; 20
     minutes is BASE + EXT; 30 is BASE + EXT + DEEP. That is the source doc's
     own additive design (Núcleo -> Extensión -> Inmersión) and the reason 15
     routines are 3 lists per sport rather than 15 written ones.

     The closing block is NOT in these tables. It is appended by tier, because
     it has to be last: `wallLegs` is a closing item by nature, and a routine
     that lies down for two minutes and then gets up to do more mobility is
     sequenced wrong. So 10 has no close, 20 closes on the wall, and 30 closes
     on the wall plus the breathing. */
  const BASE = {
    run:  ["calfWall", "hamSupine", "fig4", "psoas", "quadSide", "childPose"],
    bike: ["sphinx", "psoas", "quadSide", "fig4", "openBook", "neckTrap"],
    swim: ["childReach", "crossBody", "pecFloor", "tricep", "ankleKick", "neckTrap"],
    tri:  ["calfWall", "psoas", "childReach", "fig4", "quadSide", "childPose"],
    all:  ["hamSupine", "quadSide", "fig4", "pecFloor", "twist", "childPose"]
  };

  const EXT = {
    run:  ["footArch", "adductor", "itCross", "twist", "childReach"],
    bike: ["thoracicExt", "hamSupine", "forearm", "catcow", "childReach"],
    swim: ["openBook", "psoas", "thoracicExt", "footArch", "childPose"],
    tri:  ["hamSupine", "crossBody", "openBook", "ankleKick", "twist"],
    all:  ["psoas", "childReach", "butterfly", "calfWall", "neckTrap"]
  };

  const DEEP = {
    run:  ["calfGastro", "sphinx", "ankleKick", "butterfly", "neckTrap"],
    bike: ["pecFloor", "butterfly", "adductor", "calfWall", "twist"],
    swim: ["catcow", "fig4", "calfWall", "twist", "adductor"],
    tri:  ["sphinx", "itCross", "footArch", "butterfly", "adductor"],
    all:  ["catcow", "crossBody", "itCross", "sphinx", "adductor"]
  };

  /* The tail, by tier. See the note above the tables for why it lives here. */
  const CLOSE = { 10: [], 20: ["wallLegs"], 30: ["wallLegs", "breathClose"] };

  const PHASE = {
    base:  "Descarga",
    ext:   "Cadena completa",
    deep:  "Zonas olvidadas",
    close: "Cierre"
  };

  const SPORT = {
    run:  "Movilidad post-carrera",
    bike: "Movilidad post-bici",
    swim: "Movilidad post-natación",
    tri:  "Movilidad post-combinado",
    all:  "Movilidad de cuerpo completo"
  };

  const SUBTITLE = {
    run:  "Cadena posterior, psoas y glúteo, que es lo que te acaba de trabajar. Sostienes cada posición, no rebotas.",
    bike: "Abrir lo que la posición de bici cerró: cadera, pecho y espalda alta. Sostienes cada posición, no rebotas.",
    swim: "Descomprimir el hombro y la espalda alta — y las piernas, que patearon una hora y nadie estira.",
    tri:  "Lo que dejaron las tres cosas juntas: cuádriceps y gemelos de correr, cadera de la bici, dorsal de nadar.",
    all:  "Sin deporte asignado: recorrido completo de arriba a abajo. Sirve igual después del gimnasio o de un día largo."
  };

  const WHY = {
    run:  "Correr deja el sóleo y los isquios con tono alto y el psoas corto, y después te sientas ocho horas encima de eso. Diez minutos en el piso ahora valen más que media hora mañana, porque el tejido todavía está caliente y todavía te acuerdas de qué te molestó.",
    bike: "En la bici estás una hora o cinco en la misma posición: cadera cerrada, espalda alta redondeada, cuello extendido para mirar adelante y las manos agarrando. Nada de eso se arregla solo, y es acumulativo — la molestia lumbar del ciclista casi nunca empieza en la lumbar.",
    swim: "Nadar deja el dorsal y el pectoral menor tirando del hombro hacia adelante, que es exactamente la posición desde la que se pincha. Y deja las piernas afuera de la conversación: pateaste una hora con el tobillo en punta y mañana sales a correr con eso.",
    tri:  "Un día combinado deja tres deudas distintas y ninguna se paga con la misma postura. Esta sesión toca las tres: lo que corriste, lo que pedaleaste y lo que nadaste, en ese orden de prioridad.",
