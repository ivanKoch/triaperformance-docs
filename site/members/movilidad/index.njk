    /* --------------------------------------------------------------- CIERRE */
    wallLegs: { name: "Piernas en la pared", mode: "bi", tag: "Pared", secs: 120,
      cue: "Cola cerca de la pared, piernas verticales apoyadas en ella, brazos al costado. <strong>Dos minutos enteros, y no estás estirando nada: estás bajando pulsaciones y sacándote el peso de las piernas.</strong> Si tira mucho de los isquios, alejá la cola de la pared." },

