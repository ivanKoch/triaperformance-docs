  /* The tail, by tier. See the note above the tables for why it lives here. */
  const CLOSE = { 10: [], 20: ["wallLegs"], 30: ["wallLegs", "breathClose"] };

  const PHASE = {
    base:  "Descarga",
    ext:   "Cadena completa",
    deep:  "Zonas olvidadas",
    close: "Cierre"
  };

  const SPORT = {
    run:  "Movilidad post-carrera",
    bike: "Movilidad post-bici",
    swim: "Movilidad post-natación",
    tri:  "Movilidad post-combinado",
    all:  "Movilidad de cuerpo completo"
  };

  const SUBTITLE = {
