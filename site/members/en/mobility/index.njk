{#- MOVILIDAD POST-ENTRENO, ENGLISH SIBLING of /members/movilidad/.
    Derived from the Spanish page by `automation/mobility-i18n.py`, which
    substitutes string literals and nothing else — so the exercise ids, the
    three routine tables, the phase composition, every hold and every mode are
    identical to the Spanish page by construction, not by review.

    *** DO NOT HAND-EDIT THE STRUCTURE HERE. *** If a routine changes, it
    changes in the Spanish page and this one is regenerated. If a CUE changes,
    fix it in both places in the same pass — the script's map is the record of
    which string corresponds to which.

    Home doc: `mobility-brief.md`. It owns all of it: the five decisions that
    reversed the source doc (durations are 10/20/30, mat-only base, intensity
    rather than depth, triathlon is the brick, "todo el cuerpo"), and the three
    clinical reversals — NO sleeper stretch, NO doorframe pec stretch, NO camel.

    *** THE CLINICAL REVERSALS ARE THE REASON THIS FILE IS TESTED IN ITS OWN
    LANGUAGE. A translation is exactly where a clinical decision silently
    reverts, because the reviewer is reading for fluency and "sleeper stretch"
    has a plausible-sounding rendering in both English and Portuguese. The same
    assertions that run against the Spanish page run against this one. ***

    *** EVERY NOTE ABOUT THIS PAGE BELONGS IN THIS BLOCK. Almost the whole page
    is inside {% raw %}, where a Nunjucks comment is NOT a comment — it is
    literal text that renders to the reader. Use an HTML comment or write it
    here. -#}
{% raw %}
<div class="setup" id="setup">
  <div class="crumb-bar"><div class="wrap"><a href="/members/en/#biblioteca">Library</a> / Mobility</div></div>

  <div class="setup-head">
    <span class="label">Mobility</span>
    <h1>Your cool-down</h1>
    <p>Two questions and the session builds itself. Every exercise is timed, single-side ones per side — there is nothing to count.</p>
  </div>

  <div class="setup-q">
    <div class="setup-label">What are you coming off?</div>
    <div class="setup-opts setup-opts--wrap" data-axis="sport">
      <button type="button" class="setup-opt" data-val="run" aria-pressed="true">Running</button>
      <button type="button" class="setup-opt" data-val="bike" aria-pressed="false">Riding</button>
      <button type="button" class="setup-opt" data-val="swim" aria-pressed="false">Swimming</button>
      <button type="button" class="setup-opt" data-val="tri" aria-pressed="false">Multi-sport</button>
      <button type="button" class="setup-opt" data-val="all" aria-pressed="false">Full body</button>
    </div>
    <p class="setup-hint" id="sportHint"></p>
  </div>

  <div class="setup-q">
    <div class="setup-label">How long do you have?</div>
    <div class="setup-opts" data-axis="mins">
      <button type="button" class="setup-opt" data-val="10" aria-pressed="true">10 min</button>
      <button type="button" class="setup-opt" data-val="20" aria-pressed="false">20 min</button>
      <button type="button" class="setup-opt" data-val="30" aria-pressed="false">30 min</button>
    </div>
    <p class="setup-hint">All three start the same way. Twenty adds the rest of the chain; thirty adds the spots nobody stretches, and a long close to bring your heart rate down.</p>
  </div>

  <p class="setup-hint">A mat and a wall are enough. If you have a roller or a ball, some exercises offer that version through the <strong>Change exercise</strong>.</p>

  <p class="setup-hint setup-aside" id="painAside"></p>

  <button type="button" class="btn-primary setup-go" id="setupGo">Build my session →</button>
</div>

<div id="toolWrap" hidden>
{% endraw %}
  {% include "partials/activation-tool.njk" %}
{% raw %}
</div>

<script>
window.MOBILITY_MATRIX = (function () {

  /* ---------------------------------------------------------------- LIBRARY
     One definition per exercise, one cue. An exercise shared by four sports
     cannot drift into four slightly different cues, which is the whole reason
     this is a library and a set of id lists rather than 15 written routines.

     `secs` is the hold. The engine's default is 40; post-session the standard
     here is 45 (60 for the decompression pieces, 30 for the light ones), which
     is deliberately SHORTER than the source doc's 2-4 minutes per movement.
     Long passive holds are the recovery-day tool's job.

     `variants` carry the roller and ball versions. The base routine never needs
     them, and the engine hides its own "Change exercise" button on any
     exercise that has none. */
  const L = {

    /* ------------------------------------------------------- LEG / HIP */
    calfWall: { name: "Wall Soleus Stretch", mode: "uni", tag: "Wall", secs: 45,
      cue: "Toes against the wall, heel down. Drive the knee toward the wall and keep it bent. Bent knee is soleus. If you feel it in the calf belly, bend the knee more.",
      variants: [{ name: "Foam Roll: Calf Belly", mode: "uni", tag: "Roller",
        cue: "<strong>Stay on the meaty part of the calf. Never roll the tendon</strong> — it is highly innervated tissue and friction there only makes it worse. Sit with the calf on the roller and the other leg crossed on top for load. When you find the spot that complains most, park there instead of sawing back and forth." }] },

    calfGastro: { name: "Wall Calf Stretch (Straight Knee)", mode: "uni", tag: "Wall", secs: 45,
      cue: "Hands on the wall, back leg straight, heel pinned. Straight knee is calf. Hip forward, torso upright: if you lean back, you lost the stretch." },

    hamSupine: { name: "Supine Hamstring Stretch", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Hold behind the thigh and straighten the knee as far as it goes without the hip leaving the floor. Other leg down. Toes toward you only at the end, not from the start.",
      variants: [{ name: "Towel Hamstring Stretch", mode: "uni", tag: "Towel",
        cue: "Loop a towel around the sole of the foot and send that leg toward the ceiling. <strong>Pull on the towel, not from your neck.</strong> The other leg stays on the floor." }] },

    fig4: { name: "Figure-4 Stretch", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Lie on your back, cross one ankle over the opposite knee and draw the bottom thigh toward your chest. Gently press the crossed knee out with your elbow. <strong>Start on the side that feels tighter.</strong> Breathe long and don't force the range.",
      variants: [{ name: "Glute Ball Release", mode: "uni", tag: "Ball",
        cue: "Sit on the ball, find the glute spot that complains and stay there breathing — don't roll around. Cross the ankle over the knee to go deeper." }] },

    psoas: { name: "Half-Kneeling Hip Flexor with Glute Squeeze", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Half-kneeling, front foot flat. <strong>Tuck the pelvis and squeeze the back glute hard before you shift the hip forward.</strong> Without that squeeze you're stretching the low back, not the psoas — the squeeze is the exercise." },

    quadSide: { name: "Side-Lying Quad Stretch", mode: "uni", tag: "No equipment", secs: 45,
      cue: "On your side, grab the top ankle and bring the heel to the glute. Pelvis tucked, knee pointing at the floor, not flared out. If the low back arches, ease off.",
      variants: [{ name: "Foam Roll: Quads", mode: "uni", tag: "Roller",
        cue: "Lie face down with the thigh on the roller, from the hip crease to just above the kneecap. Medium pressure: if you're holding your breath, it's too much. <strong>When you find a tender spot, stay there and bend and straighten the knee.</strong>" },
        { name: "Couch Stretch", mode: "uni", tag: "Wall",
        cue: "Kneel with your back to a wall or the foot of a bed, back instep resting up, other foot forward in a lunge. <strong>Tuck the pelvis and squeeze the rear glute before you lift the torso.</strong> Skip that and the pelvis dumps, so the low back takes the stretch instead of the psoas and quad. Almost nobody needs to sit up as tall as they think." }] },

    itCross: { name: "Supine Outer-Hip Cross", mode: "uni", tag: "No equipment", secs: 45,
      cue: "On your back, take one knee across and let the pelvis roll with it, arms open. You're after TFL and glute, on the outside of the hip. The IT band doesn't stretch by force. <strong>It does not soften under punishment either: what loosens is whatever is pulling on it.</strong>",
      variants: [{ name: "Foam Roll: TFL and Vastus Lateralis", mode: "uni", tag: "Roller",
        cue: "Roller just under the outside of the hip bone, then on the outer thigh, high and forward. Moderate, slow pressure. Don't roll the IT band: that's tendon, and it inflames." }] },

    adductor: { name: "Half-Kneeling Lateral Lunge", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Kneeling, one leg straight out to the side, foot down. Sit the hip back and toward the opposite side. Long spine. You're after the long adductor." },

    butterfly: { name: "Butterfly Stretch", mode: "bi", tag: "No equipment", secs: 60,
      cue: "Soles together. Hinge from the hips with a long spine: rounding to get lower is just cheating the shape. Elbows can gently press the knees." },

    footArch: { name: "Toe-Sit and Toe Spreads", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Sit on the heels with the toes tucked under. If that's too much, take weight into the hands. Then spread and close the toes.",
      variants: [{ name: "Plantar Fascia Ball Roll", mode: "uni", tag: "Ball",
        cue: "Standing or sitting, roll the sole over a ball from heel to toes, slowly. When a spot complains, park there. Pressure you can hold while breathing normally." }] },

    ankleKick: { name: "Ankle and Instep Sit", mode: "bi", tag: "No equipment", secs: 45,
      cue: "Sit on the heels with the insteps flat on the floor. Lift the knees slightly to load the top of the foot. Then big ankle circles.",
      variants: [{ name: "Shin and Instep Foam Roll", mode: "bi", tag: "Roller",
        cue: "On all fours, roller on the front of the shin. Roll slowly from knee to ankle. Sensitive area: less pressure than you think." }] },

    /* ------------------------------------------------------- TRUNK / BACK */
    childPose: { name: "Child's Pose", mode: "bi", tag: "No equipment", secs: 60,
      cue: "Sit back on your heels, arms long in front, forehead to the floor. Breathe into the low back and let the hips sink a little further on each exhale. <strong>The point is to drop the revs, not to stretch farther.</strong>" },

    childReach: { name: "Child's Pose with Side Reach", mode: "uni", tag: "No equipment", secs: 45,
      cue: "From child's pose, walk the hands to one side until you feel the lat along the side of the ribcage. <strong>Hips stay back</strong> — don't let the torso chase the hands." },

    twist: { name: "Supine Spinal Twist", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Lie on your back, take one knee across the body, arms open, eyes to the opposite side. <strong>The shoulder stays on the floor</strong>: if it lifts, lower the knee. Soften a little further on each exhale." },

    sphinx: { name: "Gentle Sphinx", mode: "bi", tag: "No equipment", secs: 60,
      cue: "Face down, elbows under the shoulders, pelvis heavy on the floor. A gentle held extension, not a cobra. If the low back pinches, walk the elbows forward." },

    openBook: { name: "Open Book", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Lie on your side, knees bent and stacked, arms reaching forward together. Open the top arm and follow the hand with your eyes. <strong>Keep the knees still.</strong> If they drift apart, the rotation leaked into the low back." },

    catcow: { name: "Cat-Cow", mode: "bi", tag: "No equipment", secs: 45,
      cue: "On all fours, round and arch your spine with your breath. <strong>Start from the pelvis and let the spine follow one vertebra at a time</strong> — not as a block, and not just from the neck and shoulders. This is pelvic and joint control, not a stretch. Stay in a comfortable range, not end range." },

    thoracicExt: { name: "Quadruped Thoracic Extension", mode: "bi", tag: "No equipment", secs: 60,
      cue: "Kneeling, forearms forward, hips toward the heels. Drop the chest toward the floor and let the armpits open. If the low back arches, sit the hips closer to the heels." },

    /* --------------------------------------------------------- SHOULDER / NECK
       The cross-body stretch replaces the source doc's sleeper stretch, and the
       prone chest opener replaces its doorframe stretch. Both reasons are in the
       header block above, and in `mobility-brief.md` §3. */
    crossBody: { name: "Cross-Body Shoulder Stretch", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Bring one arm across the chest and hold it above the elbow, never at the wrist. <strong>Before you pull, set the shoulder blade down and don't let the shoulder drift forward</strong>: if the blade slides, you're stretching the upper back instead of the back of the shoulder. You should feel it behind the shoulder, never a pinch in the front." },

    pecFloor: { name: "Prone Chest Opener", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Face down, one arm out in a T at shoulder height. Roll onto that side and plant the opposite foot. You're after the chest, not the front of the shoulder: if it pinches inside the joint, drop the arm a few centimeters.",
      variants: [{ name: "Ball: Pec Minor", mode: "uni", tag: "Ball",
        cue: "Place the ball under the collarbone, on the front of the shoulder toward the midline. <strong>Light, still pressure: this spot doesn't get rolled, it gets held.</strong> Don't crush it — there are nerves and tendons under here, and this is not a place to pick a fight." }] },

    tricep: { name: "Overhead Triceps and Lat Stretch", mode: "uni", tag: "No equipment", secs: 30,
      cue: "Elbow up by the ear, hand between the shoulder blades. Gently press the elbow with the other hand. Ribs down: if the low back arches, you stole range from the spine, not the shoulder." },

    neckTrap: { name: "Upper Trap Stretch", mode: "uni", tag: "No equipment", secs: 30,
      cue: "Sit, hold the seat with the hand on the side you're stretching. Ear toward the opposite shoulder without shrugging. Don't pull with the other hand: the weight of the head is enough." },

    forearm: { name: "Forearm and Wrist Stretch", mode: "uni", tag: "No equipment", secs: 30,
      cue: "On all fours, turn the hand so the fingers point at the knees and sit back slowly. Then flip to the back of the hand for the other side. Don't force a pinch." },

    /* --------------------------------------------------------------- CLOSE */
    wallLegs: { name: "Legs Up the Wall", mode: "bi", tag: "Wall", secs: 120,
      cue: "Hips near the wall, legs vertical against it, arms at your sides. You're not stretching: you're dropping the heart rate. If the hamstrings yank, scoot back." },

    breathClose: { name: "Closing Breath", mode: "bi", tag: "No equipment", secs: 180,
      cue: "On your back, knees bent, one hand on the chest and one on the belly. Inhale 4 seconds through the nose into the belly, exhale 6 through the mouth. The long exhale is what brings the system down. If you want a protocol with a timer, there is <a href=\"/members/en/breathing/\">Box Breathing</a>." }
  };

  /* ------------------------------------------------------------- ROUTINES
     Three tables, not fifteen routines. BASE is the 10-minute session; 20
     minutes is BASE + EXT; 30 is BASE + EXT + DEEP. That is the source doc's
     own additive design (Núcleo -> Extensión -> Inmersión) and the reason 15
     routines are 3 lists per sport rather than 15 written ones.

     The closing block is NOT in these tables. It is appended by tier, because
     it has to be last: `wallLegs` is a closing item by nature, and a routine
     that lies down for two minutes and then gets up to do more mobility is
     sequenced wrong. So 10 has no close, 20 closes on the wall, and 30 closes
     on the wall plus the breathing. */
  const BASE = {
    run:  ["calfWall", "hamSupine", "fig4", "psoas", "quadSide", "childPose"],
    bike: ["sphinx", "psoas", "quadSide", "fig4", "openBook", "neckTrap"],
    swim: ["childReach", "crossBody", "pecFloor", "tricep", "ankleKick", "neckTrap"],
    tri:  ["calfWall", "psoas", "childReach", "fig4", "quadSide", "childPose"],
    all:  ["hamSupine", "quadSide", "fig4", "pecFloor", "twist", "childPose"]
  };

  const EXT = {
    run:  ["footArch", "adductor", "itCross", "twist", "childReach"],
    bike: ["thoracicExt", "hamSupine", "forearm", "catcow", "childReach"],
    swim: ["openBook", "psoas", "thoracicExt", "footArch", "childPose"],
    tri:  ["hamSupine", "crossBody", "openBook", "ankleKick", "twist"],
    all:  ["psoas", "childReach", "butterfly", "calfWall", "neckTrap"]
  };

  const DEEP = {
    run:  ["calfGastro", "sphinx", "ankleKick", "butterfly", "neckTrap"],
    bike: ["pecFloor", "butterfly", "adductor", "calfWall", "twist"],
    swim: ["catcow", "fig4", "calfWall", "twist", "adductor"],
    tri:  ["sphinx", "itCross", "footArch", "butterfly", "adductor"],
    all:  ["catcow", "crossBody", "itCross", "sphinx", "adductor"]
  };

  /* The tail, by tier. See the note above the tables for why it lives here. */
  const CLOSE = { 10: [], 20: ["wallLegs"], 30: ["wallLegs", "breathClose"] };

  const PHASE = {
    base:  "Unload",
    ext:   "Full chain",
    deep:  "Forgotten spots",
    close: "Close"
  };

  const SPORT = {
    run:  "Post-run mobility",
    bike: "Post-ride mobility",
    swim: "Post-swim mobility",
    tri:  "Post-brick mobility",
    all:  "Full-body mobility"
  };

  const SUBTITLE = {
    run:  "Posterior chain, hip flexors and glutes — what you just worked. You hold each position; you do not bounce.",
    bike: "Opening what the bike position closed: hips, chest and upper back. You hold each position; you do not bounce.",
    swim: "Decompressing the shoulder and upper back — and the legs, which kicked for an hour and nobody stretches.",
    tri:  "What all three left behind: quads and calves from the run, hips from the bike, lats from the swim.",
    all:  "No sport assumed: a full pass from top to bottom. Works just as well after the gym or a long day."
  };

  const WHY = {
    run:  "Running leaves the soleus and hamstrings with high tone and the hip flexors short, and then you sit on top of that for eight hours. Ten minutes on the floor now is worth more than half an hour tomorrow, because the tissue is still warm and you still remember what bothered you.",
    bike: "On the bike you spend an hour or five in one position: hips closed, upper back rounded, neck extended to look ahead and hands gripping. None of that resolves on its own, and it accumulates — a cyclist's low-back complaint almost never starts in the low back.",
    swim: "Swimming leaves the lat and pec minor pulling the shoulder forward, which is exactly the position it gets pinched from. And it leaves the legs out of the conversation: you kicked for an hour with the ankle pointed and tomorrow you run on that.",
    tri:  "A multi-sport day leaves three different debts and no single position pays them off. This session covers all three: what you ran, what you rode and what you swam, in that order of priority.",
    all:  "When you do not know what left you stiff, or it was a bit of everything, the best use of the time is a full pass rather than hammering one area. That holds just as well for a gym day or a long day at a desk."
  };

  const DONE = {
    run:  "Done. Eat something in the next half hour.",
    bike: "Done. Eat something in the next half hour.",
    swim: "Done. Eat something in the next half hour.",
    tri:  "Done. Eat something in the next half hour.",
    all:  "Done. That is the full session."
  };

  /* Where to send someone whose problem is pain and not stiffness. Every sport
     here has somewhere to hand off to, which is methodology.md §11 respected in
     the product: this tool is movilidad, no rehabilitación. */
  const PAIN = {
    run:  'If something <strong>hurts</strong> rather than feels stiff, this is not the right tool today: go to <a href="/members/en/knees/">Knees</a> or <a href="/members/en/achilles/">Achilles</a>. And if the pain persists, that is a doctor, not a routine.',
    bike: 'If something <strong>hurts</strong> rather than feels stiff, this is not the right tool today: go to <a href="/members/en/knees/">Knees</a>. And if the pain persists, that is a doctor, not a routine.',
    swim: 'If the shoulder <strong>hurts</strong> rather than feels stiff, this is not the right tool today: go to <a href="/members/en/shoulder/">Swimmer’s Shoulder</a>. And if the pain persists, that is a doctor, not a routine.',
    tri:  'If something <strong>hurts</strong> rather than feels stiff, this is not the right tool today: go to <a href="/members/en/knees/">Knees</a>, <a href="/members/en/achilles/">Achilles</a> or <a href="/members/en/shoulder/">Shoulder</a>. And if the pain persists, that is a doctor, not a routine.',
    all:  'If something <strong>hurts</strong> rather than feels stiff, this is not the right tool today: go to <a href="/members/en/knees/">Knees</a>, <a href="/members/en/achilles/">Achilles</a> or <a href="/members/en/shoulder/">Shoulder</a>. And if the pain persists, that is a doctor, not a routine.'
  };

  const SPORT_HINT = {
    run:  "",
    bike: "",
    swim: "",
    tri:  "For a day with more than one sport: a brick, or a ride in the morning and a run in the afternoon.",
    all:  "If everything feels stiff, if it was a gym day, or if you would rather not choose."
  };

  function build(sport, mins) {
    const m = String(mins);
    if (!BASE[sport]) throw new Error("Unknown sport: " + sport);
    if (!CLOSE[m]) throw new Error("Unknown duration: " + m);

    const pick = ids => ids.map(id => {
      const ex = L[id];
      if (!ex) throw new Error("Unknown exercise id: " + id);
      return Object.assign({ video: null, variants: [] }, ex);
    });

    const phases = [{ name: PHASE.base, exercises: pick(BASE[sport]) }];
    if (m === "20" || m === "30") phases.push({ name: PHASE.ext, exercises: pick(EXT[sport]) });
    if (m === "30") phases.push({ name: PHASE.deep, exercises: pick(DEEP[sport]) });
    if (CLOSE[m].length) phases.push({ name: PHASE.close, exercises: pick(CLOSE[m]) });

    return {
      title: SPORT[sport],
      crumb: "Mobility",
      subtitle: SUBTITLE[sport],
      context: m + " minutes",
      why: WHY[sport],
      doneSub: DONE[sport],
      kicker: "Mobility",
      restSeconds: 10,
      phases: phases
    };
  }

  /* Chrome that would otherwise say "activación" on a mobility page. All of it
     comes from site/_data/activationUi.json, which is keyed by LANGUAGE and has
     no concept of which tool is asking, so each string is corrected where it
     actually lands — and the three land in three different ways:

       kicker       the engine already takes a per-routine override (D.kicker),
                    so it is set in build().
       startRoutine the engine reads it through t() at render time, so patching
                    window.ACTIVATION_UI before the engine boots is enough.
       doneTitle    is NOT an engine string. The partial bakes it into the
                    markup at build time, so it can only be written by id after
                    the tool is shown. A window.ACTIVATION_UI override for it
                    silently does nothing — which is exactly what happened, and
                    is why the partial got an id.

     *** WHEN THIS PAGE IS TRANSLATED, THESE THREE STRINGS TRAVEL WITH IT. They
     are the only interface text this tool owns, and they are the exact kind of
     thing a translation pass reads straight past. *** */
  const UI_OVERRIDE = { startRoutine: "Start the session →" };
  const DONE_TITLE = "Session complete";

  return { build: build, library: L, base: BASE, ext: EXT, deep: DEEP,
           close: CLOSE, pain: PAIN, sportHint: SPORT_HINT, ui: UI_OVERRIDE,
           doneTitle: DONE_TITLE };
})();

/* --------------------------------------------------------------- SETUP UI
   Two questions instead of the activation matrix's three, and neither one
   changes the other's options — so there is no equivalent here of that page's
   sport-aware equipment rebuild. What IS sport-aware is the pain hand-off,
   which changes which tool it points at. */
(function () {
  const M = window.MOBILITY_MATRIX;
  const choice = { sport: "run", mins: "10" };

  function renderSportBits() {
    const hint = document.getElementById("sportHint");
    hint.innerHTML = M.sportHint[choice.sport] || "";
    hint.hidden = !M.sportHint[choice.sport];
    document.getElementById("painAside").innerHTML = M.pain[choice.sport];
  }

  document.querySelectorAll(".setup-opts[data-axis]").forEach(group => {
    const axis = group.dataset.axis;
    group.querySelectorAll(".setup-opt").forEach(btn => {
      btn.addEventListener("click", () => {
        choice[axis] = btn.dataset.val;
        group.querySelectorAll(".setup-opt").forEach(b =>
          b.setAttribute("aria-pressed", String(b === btn)));
        if (axis === "sport") renderSportBits();
      });
    });
  });

  renderSportBits();

  document.getElementById("setupGo").addEventListener("click", () => {
    window.ACTIVATION_DATA = M.build(choice.sport, choice.mins);
    Object.assign(window.ACTIVATION_UI, M.ui);

    document.getElementById("setup").hidden = true;
    document.getElementById("toolWrap").hidden = false;

    // Labels the partial normally writes at parse time — done here instead,
    // because at parse time there was no routine yet.
    document.getElementById("doneSub").textContent = window.ACTIVATION_DATA.doneSub;
    document.getElementById("crumbLabel").textContent = window.ACTIVATION_DATA.crumb;
    document.getElementById("doneTitle").textContent = M.doneTitle;

    // Boot the shared engine. Injected rather than loaded with the page, so the
    // engine needs no awareness of this tool at all: by the time it runs,
    // window.ACTIVATION_DATA looks like any other activation routine.
    const s = document.createElement("script");
    // Fingerprinted engine URL, published by the partial as TP_ENGINE_SRC.
    // A literal path here would be unfingerprinted and therefore pinned in
    // the visitor's browser for a year by Caddy's immutable header on
    // /assets/js/* — the September 8, 2026 defect. Do not inline it back.
    s.src = window.TP_ENGINE_SRC;
    document.body.appendChild(s);

    // One way back. Reloads rather than re-initialising, for the same reason as
    // the activation matrix: the engine holds timer state in closure and has no
    // teardown, and a stale interval running under a second routine is a worse
    // bug than a page load.
    s.addEventListener("load", () => {
      const back = document.createElement("button");
      back.className = "change-link setup-back";
      back.textContent = "← Change options";
      back.addEventListener("click", () => location.reload());
      document.querySelector(".tool").prepend(back);
    });
  });
})();
</script>
