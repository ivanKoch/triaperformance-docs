---
layout: layouts/base.njk
navVariant: "none"
footerVariant: "none"
pageCss: "members-forgot-password.css"
title: "Password recovery — Triaperformance"
---
{#- See the note in site/members/forgot-password/index.njk: same endpoint, and
    the `lang` field is sent but not yet read by the n8n workflow. -#}
<div class="card">
  <h1>Password recovery</h1>
  <p class="sub" id="sub">Enter the email you subscribed to All-Access with. If it's registered, we'll send your password.</p>

  <form id="forgot-form">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required autocomplete="email">
    <button type="submit" id="submit-btn">Send</button>
  </form>

  <p class="result" id="result"></p>

  <p class="help"><a href="/members/en/login">Back to login</a></p>

  <p class="auth-lang">
    <a href="/members/forgot-password">Español</a><span class="sep">·</span><a href="/members/en/forgot-password" class="current">English</a><span class="sep">·</span><a href="/members/pt/forgot-password">Português</a>
  </p>
</div>

<script>
  var form = document.getElementById('forgot-form');
  var sub = document.getElementById('sub');
  var result = document.getElementById('result');
  var submitBtn = document.getElementById('submit-btn');

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    fetch('/members/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: document.getElementById('email').value.trim(), lang: 'en' })
    })
      .then(function () {
        result.textContent = "If that email is registered, we've sent your password. Check your inbox.";
        result.classList.add('show');
        form.style.display = 'none';
        sub.style.display = 'none';
      })
      .catch(function () {
        result.textContent = 'Something went wrong. Email us at coach@triaperformance.com.';
        result.classList.add('show');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send';
      });
  });
</script>
