<script>
window.RECOVERY_MATRIX = (function () {

  /* ---------------------------------------------------------------- LIBRARY
     One definition per exercise, one cue. `secs` is the hold or the block —
     longer than /members/en/mobility/ throughout, because this is the tool with
     the time: 60s CARs, 90s PNF, 120-240s flows and passive holds.

     `variants` carry everything that is not a mat and a wall. The base routine
     never needs them, and the engine hides its own "Change exercise" button
     on any exercise that has none. */
  const L = {

    /* ============================================== ONLY IN THIS TOOL
       CARs, flows, long holds, PNF and balance. This is what an activation
       cannot do in twelve minutes, and it is why these OPEN the routines rather
       than closing them. If this ever ends up at the bottom, the tool has gone
       back to being the activation matrix stretched out. */
    carsHip: { name: "Hip CARs", mode: "uni", tag: "No equipment", secs: 60,
      cue: "Standing or on all fours: knee to chest, open it to the side, rotate it back and lower. Biggest circle you can make without anything else moving. If the torso cheats, shrink the circle." },

    carsShoulder: { name: "Shoulder CARs", mode: "uni", tag: "No equipment", secs: 60,
      cue: "Arm straight: lift it forward, rotate, and lower it behind you — biggest circle you can own. Ribs down, other hand on the sternum to catch any trunk cheat." },

    carsSpine: { name: "Spinal CARs", mode: "bi", tag: "No equipment", secs: 90,
      cue: "Sit on the heels or on a chair. Segment by segment: mid-back flexion and extension, side bend each way, rotation. Hips don't move: if they do, you're no longer moving the spine." },

    carsAnkle: { name: "Ankle CARs", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Sit, leg straight. Draw the biggest circle you can with the toes, both directions. Knee and shin still. Find the edge of the range and pause a second at each point." },

    dogFlow: { name: "Down Dog to Up Dog", mode: "bi", tag: "No equipment", secs: 120,
      cue: "Flow with the breath: exhale into downward dog, heels reaching; inhale into upward dog, chest open. Don't rush the transition." },

    sunFlow: { name: "Slow Sun Salutation", mode: "bi", tag: "No equipment", secs: 240,
      cue: "Slow sequence, one movement per breath: stand, arms up, fold, half lift, plank, downward dog, step forward, and return. Alternate which leg steps." },

    warriorFlow: { name: "Warrior I to II to Triangle", mode: "uni", tag: "No equipment", secs: 120,
      cue: "Warrior I with the hip facing forward, open to Warrior II by turning the torso, then fold into triangle with a long arm. About five breaths in each. Front knee over the ankle, never past the toes." },

    deepSquatHold: { name: "Held Deep Squat", mode: "bi", tag: "No equipment", secs: 120,
      cue: "All the way down, heels down, elbows inside the knees pressing gently out. Move around inside the pose. If the heels lift, put something under them." },

    frog: { name: "Frog Pose", mode: "bi", tag: "No equipment", secs: 180,
      cue: "Knees wide in line with the hips, ankles behind the knees, forearms down. Sink to the first point of tension and stay there breathing — don't chase more. Time does the work. <strong>Recovery days only</strong> — it does not belong on tissue you just trained." },

    dragon: { name: "Flying Dragon (Lizard Variation)", mode: "uni", tag: "No equipment", secs: 90,
      cue: "Very long lunge, hands inside the front foot, back knee down. Let the front knee fall out and drop to the forearms if you get there. Stay at a 6 or 7 out of 10. No bouncing." },

    pnfHip: { name: "Hip Flexor Contract-Relax", mode: "uni", tag: "No equipment", secs: 90,
      cue: "Half-kneeling, pelvis tucked. Press the back knee into the floor at 20% for 5 seconds, release, then ease the hip forward a little. Three or four cycles. That contract-relax is what actually gains range." },

    pnfHam: { name: "Hamstring Contract-Relax", mode: "uni", tag: "No equipment", secs: 90,
      cue: "On your back, leg to the ceiling, hold behind the thigh. Press the heel into your hands at 20% for 5 seconds, release, then ease the leg a little higher. Three or four cycles. Bottom leg stays down." },

    balance: { name: "Single-Leg Balance", mode: "uni", tag: "No equipment", secs: 40,
      cue: "Stand on one leg, knee softly bent. <strong>Don't let the hip drop on the free side.</strong> Let the foot do the work: toes active, ankle making the corrections. If that's easy, close your eyes. Keep a wall or a chair within reach." },

    rollDown: { name: "Supine Segmental Bridge", mode: "bi", tag: "No equipment", secs: 90,
      cue: "On your back, knees bent. Peel up one vertebra at a time to the shoulder blades and lower just as slowly, top to bottom. You want the spine to articulate, not to get high." },

    bodyScan: { name: "Body Scan", mode: "bi", tag: "No equipment", secs: 180,
      cue: "On your back, legs long, palms up. Travel from the feet to the head, one breath per region, releasing whatever you find clenched. Jaw and upper traps last." },

    /* =========================================================== MOBILITY
       Movements that also exist in /members/core/ or in the activation matrix.
       They are here because they are the right ones, but they are a MINORITY and
       they come after the block above — see decision 1 in the header. */
    catcow: { name: "Cat-Cow", mode: "bi", tag: "No equipment", secs: 60,
      cue: "On all fours, round and arch with your breath. <strong>Go twice as slow as you would before a session</strong> and hunt for the segments that don't move. One vertebra at a time, not as a block. After training this is to let the spine go, not to crank mobility." },

    threadNeedle: { name: "Quadruped Thoracic Rotation", mode: "uni", tag: "No equipment", secs: 60,
      cue: "On all fours, one hand behind the head. Drive the elbow toward the opposite knee, then open and rotate the torso, following the elbow with your eyes. <strong>Hips stay square</strong>: if they travel with you, you're rotating from the low back, not the mid-back." },

    openBook: { name: "Open Book", mode: "uni", tag: "No equipment", secs: 60,
      cue: "Lie on your side, knees bent and stacked, arms reaching forward together. Open the top arm and follow the hand with your eyes. <strong>Keep the knees still.</strong> If they drift apart, the rotation leaked into the low back.",
      variants: [{ name: "Thoracic Extension on Foam Roller", mode: "bi", tag: "Roller",
        cue: "Roller across the upper back, hands behind the head. Ease backward as you exhale, then nudge the roller two fingers higher and repeat, segment by segment. Glutes stay on the floor: <strong>never drop it under the lower ribs</strong> — that's lumbar extension, and that isn't the stiff part." }] },

    wgs: { name: "World's Greatest Stretch", mode: "uni", tag: "No equipment", secs: 60,
      cue: "Long lunge, front foot outside the hand. Drop the inside elbow toward the floor, pause a second, then <strong>rotate that arm open to the ceiling and follow the hand with your eyes</strong>. Hip, adductor and mid-back in one move." },

    nineNinety: { name: "90/90 Hip Switch", mode: "uni", tag: "No equipment", secs: 60,
      cue: "Sit, one leg 90° in front, the other 90° to the side. Hinge over the front leg, come back, then switch sides by lifting the knees without using the hands. That active transition is the exercise." },

    spiderman: { name: "Spiderman Lunge with Rotation", mode: "uni", tag: "No equipment", secs: 60,
      cue: "From plank, step the foot outside the same-side hand. Drop the elbow toward the floor, then open the arm to the ceiling. A few slow reps per side, not one long hold." },

    inchworm: { name: "Inchworm", mode: "bi", tag: "No equipment", secs: 60,
      cue: "Stand, fold forward and walk the hands out to a plank without moving the feet. Walk them back in. Legs as straight as they'll allow." },

    cossack: { name: "Cossack Squat", mode: "uni", tag: "No equipment", secs: 60,
      cue: "Feet wide. Sit onto one leg, the other straight with the toes up. Chest tall, working heel down. Don't go all the way if the back rounds." },

    legSwing: { name: "Leg Swings (Front to Back)", mode: "uni", tag: "Wall", secs: 45,
      cue: "Hold a wall and swing the leg forward and back. <strong>Build the range gradually</strong> — starting at end range is how a hamstring goes before you even start." },

    kneeWall: { name: "Knee-to-Wall Ankle Drill", mode: "uni", tag: "Wall", secs: 45,
      cue: "Foot a hand-span from the wall. Touch the wall with the knee without the heel lifting. If that's easy, scoot the foot back a centimeter and try again. This improves with reps, not force." },

    wallAngel: { name: "Wall Angels", mode: "bi", tag: "Wall", secs: 60,
      cue: "Back against the wall, low back flat, arms in a W with elbows and the backs of the hands touching. Slide up and down without anything leaving the wall. <strong>Stop exactly where something peels off</strong> — that's today's range, and forcing past it doesn't make it bigger.",
      variants: [{ name: "Dowel Pass-Through (with a stop)", mode: "bi", tag: "Stick or broomstick",
        cue: "Very wide grip, arms straight. Pass the dowel from the thighs overhead and behind you, then back. This is not a flexibility contest: <strong>stop where the ribs flare, the low back arches, or the shoulders shrug</strong>. If you have to force it, narrow the grip." }] },

    scorpion: { name: "Prone Scorpion", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Face down, arms in a T. Sweep one heel across toward the opposite hand and let the hip rotate, chest as close to the floor as you can keep it. Slow out, slow back." },

    neckCars: { name: "Neck CARs", mode: "bi", tag: "No equipment", secs: 60,
      cue: "Sit, shoulders still. Chin to chest, roll toward one shoulder, ear back, complete the circle. Very slow. If dizziness or tingling shows up, stop." },

    /* ========================================================== ACTIVATION
       This is strength and control work, not mobility, which is why the block is
       named the way it is. See decision 4 above: the copy must never suggest this
       session comes for free. */
    clamshell: { name: "Slow Clamshell", mode: "uni", tag: "No equipment", secs: 45,
      cue: "On your side, knees bent, heels together. Open the top knee without the hip rolling back. Hand on the glute so you can feel it work there. Slow, one second at the top.",
      variants: [{ name: "Banded Clamshell", mode: "uni", tag: "Mini-band",
        cue: "On your side, band above the knees, heels together. Open the top knee without letting the hip roll back. Lower as slowly as you lift." }] },

    bridgeSingle: { name: "Single-Leg Glute Bridge", mode: "uni", tag: "No equipment", secs: 45,
      cue: "One heel close to the glutes, other knee hugged to the chest. Drive through the heel and squeeze the glute at the top. <strong>If you feel it in the low back, tuck the pelvis and lower the height</strong>: the point is to isolate the glute, not let the psoas do the work again." },

    gluteBridgeMarch: { name: "Glute Bridge March", mode: "bi", tag: "No equipment", secs: 60,
      cue: "Hold the bridge at the top. From there lift one foot a few centimeters, set it down, and switch. <strong>The hips don't drop and they don't twist.</strong> Slow: this is control, not reps." },

    birdDog: { name: "Bird Dog", mode: "uni", tag: "No equipment", secs: 45,
      cue: "On all fours, reach opposite arm and leg until they're in line with your torso and hold two or three seconds. <strong>Keep the hips square to the floor and the low back quiet</strong>: if a hip opens out or the back arches, lower the leg. Picture a glass of water on your low back that can't spill. Squeeze the glute as the leg reaches." },

    deadBug: { name: "Dead Bug", mode: "bi", tag: "No equipment", secs: 60,
      cue: "Lie on your back, arms to the ceiling, knees at 90°. Slowly extend opposite arm and leg without letting your lower back leave the floor. <strong>Exhale as you reach — the exhale is what pins the back down, not brute ab strength.</strong> If the low back peels up, don't lower the leg as far. This is control, not speed." },

    sidePlank: { name: "Dynamic Side Plank", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Forearm under the shoulder, hips up, body in a line. Lower the hip until it skims the floor and lift back up, slowly. Drop to the knees if the long-lever version breaks the line." },

    bearCrawl: { name: "Bear Crawl", mode: "bi", tag: "No equipment", secs: 60,
      cue: "All fours, knees a hand-span off the floor. Forward and back, opposite hand and foot, hips low, no side-to-side sway. Short steps." },

    scapPushup: { name: "Scapular Push-Up", mode: "bi", tag: "No equipment", secs: 45,
      cue: "High plank, elbows straight the whole time. Let the chest drop as the blades come together, then push the floor away and spread them. The movement is three or four centimeters." },

    ytwl: { name: "Prone Y-T-W", mode: "bi", tag: "No equipment", secs: 60,
      cue: "Lie face down, forehead down, thumbs toward the ceiling. Lift the arms into a Y, then a T, then a W (elbows at 90° by the ribs). <strong>Shoulder blades slide down, never up toward the ears</strong>: if you shrug, the upper traps steal the work.",
      variants: [{ name: "Banded Y-T-W", mode: "bi", tag: "Long band",
        cue: "Stand, band in front. Same Y, T and W pattern against light resistance. High reps, low tension. Blades down, never toward the ears." }] },

    extRotation: { name: "Isometric External Rotation", mode: "uni", tag: "Wall", secs: 45,
      cue: "Elbow pinned to the ribs at 90°, back of the wrist against a doorframe or wall. <strong>Press outward at about 50% and hold. Nothing should move.</strong> Don't let the shoulder drift forward or the elbow leave the side.",
      variants: [{ name: "Banded External Rotation", mode: "uni", tag: "Mini-band",
        cue: "Band anchored at elbow height, elbow pinned to the ribs. Rotate the forearm out and return slower than you went. Short, controlled range." }] },

    latWalk: { name: "Lateral Walk in Half Squat", mode: "bi", tag: "No equipment", secs: 60,
      cue: "Half squat, chest tall. Side-step with even strides, feet never fully together. Knees out, hips level. Out and back.",
      variants: [{ name: "Banded Lateral Walk", mode: "bi", tag: "Mini-band",
        cue: "Half squat, band at the ankles or above the knees. Side-step with even strides, back foot not dragging. Knees pressing out, hips level." }] },

    calfEcc: { name: "Eccentric Calf Raise", mode: "bi", tag: "No equipment", secs: 60,
      cue: "Rise onto the toes with both legs and lower on one in three seconds. The lowering is the exercise. Alternate which leg lowers. Don't bounce at the bottom.",
      variants: [{ name: "Step Eccentric Calf Raises", mode: "bi", tag: "Step",
        cue: "Ball of the foot on the step edge. Rise on two, lower on one and let the heel drop below, three seconds. If you're already on an Achilles protocol, count these toward that volume." }] },

    plantarFlex: { name: "Ankle Pointing for the Kick", mode: "bi", tag: "No equipment", secs: 45,
      cue: "Sit with the legs straight. Point the toes as far as you can and hold, then pull them back toward you. <strong>Active, not passive</strong>: that's the range that actually pushes water in the kick." },

    tva: { name: "Transverse Abdominis Activation", mode: "bi", tag: "No equipment", secs: 60,
      cue: "On your back, knees bent, hands inside the hip bones. Inhale into the belly; on the exhale draw the navel in and up without moving the pelvis. You should feel a gentle tension under the fingers." },

    reverseLunge: { name: "Reverse Lunge with Arms Overhead", mode: "uni", tag: "No equipment", secs: 45,
      cue: "Long step back, back knee lowering, arms straight overhead, ribs down. The overhead arms turn this into hip and mid-back work at once." }
  };

  /* ------------------------------------------------------------- ROUTINES
     Three tiers, three named blocks, and the tiers GROW THE BLOCKS rather than
     appending new ones. That is the difference from /members/en/mobility/, and it
     is deliberate: there the tiers were the story (unload, then the rest of the
     chain, then the forgotten spots), here the BLOCKS are the story, because
     the athlete has to be able to see that a third of this session is
     activation work and not mobility. Decision 4.

     So: 30 = BASE, 45 = BASE + EXT, 60 = BASE + EXT + DEEP, merged per block.
     `mov` always opens. Decision 1 lives in the ORDER of these lists — the
     CARs, flows, PNF and holds come first inside `mov`, and the movements that
     also exist in /members/core/ or the activation matrix follow them. */
  const BASE = {
    run: {
      mov:  ["carsHip", "carsAnkle", "carsSpine", "nineNinety", "dogFlow", "deepSquatHold", "wgs", "legSwing"],
      act:  ["calfEcc", "bridgeSingle", "birdDog", "deadBug", "balance"],
      hold: ["pnfHam", "frog"] },
    bike: {
      mov:  ["carsSpine", "carsHip", "deepSquatHold", "threadNeedle", "openBook", "nineNinety", "spiderman", "catcow"],
      act:  ["clamshell", "birdDog", "tva", "sidePlank"],
      hold: ["pnfHip", "frog"] },
    swim: {
      mov:  ["carsShoulder", "neckCars", "carsSpine", "carsHip", "deepSquatHold", "wallAngel", "threadNeedle", "openBook", "catcow"],
      act:  ["ytwl", "scapPushup", "extRotation", "deadBug", "plantarFlex"],
      hold: ["pnfHip", "dragon"] },
    tri: {
      mov:  ["carsHip", "carsShoulder", "carsSpine", "dogFlow", "nineNinety", "deepSquatHold", "spiderman", "catcow"],
      act:  ["clamshell", "birdDog", "deadBug", "balance", "calfEcc"],
      hold: ["pnfHip", "frog"] },
    all: {
      mov:  ["carsHip", "carsShoulder", "carsSpine", "carsAnkle", "dogFlow", "deepSquatHold", "wgs", "catcow"],
      act:  ["bridgeSingle", "birdDog", "deadBug", "sidePlank", "balance"],
      hold: ["pnfHam", "frog"] }
  };

  const EXT = {
    run:  { mov: ["cossack", "kneeWall", "inchworm", "catcow"], act: ["latWalk", "sidePlank"], hold: ["pnfHip", "rollDown"] },
    bike: { mov: ["cossack", "kneeWall", "wallAngel", "legSwing"], act: ["latWalk", "bridgeSingle"], hold: ["pnfHam", "rollDown"] },
    swim: { mov: ["scorpion", "spiderman", "kneeWall", "wgs"], act: ["bearCrawl", "sidePlank"], hold: ["frog", "rollDown"] },
    tri:  { mov: ["inchworm", "cossack", "kneeWall", "wallAngel"], act: ["gluteBridgeMarch", "sidePlank"], hold: ["pnfHam", "rollDown"] },
    all:  { mov: ["cossack", "inchworm", "openBook", "legSwing"], act: ["reverseLunge", "bearCrawl"], hold: ["pnfHip", "rollDown"] }
  };

  const DEEP = {
    run:  { mov: ["sunFlow", "carsShoulder"], act: ["gluteBridgeMarch", "tva"], hold: ["dragon", "bodyScan"] },
    bike: { mov: ["sunFlow", "carsAnkle"], act: ["gluteBridgeMarch", "deadBug"], hold: ["dragon", "bodyScan"] },
    swim: { mov: ["sunFlow", "carsAnkle"], act: ["birdDog", "balance"], hold: ["pnfHam", "bodyScan"] },
    tri:  { mov: ["warriorFlow", "carsAnkle"], act: ["bearCrawl", "tva"], hold: ["dragon", "bodyScan"] },
    all:  { mov: ["sunFlow", "threadNeedle"], act: ["scapPushup", "tva"], hold: ["dragon", "bodyScan"] }
  };

  /* The block names ARE the honesty requirement from decision 4. Do not rename
     "Activation" to something softer: the athlete is entitled to know that this
     part of a recovery session is strength and control work. */
  const PHASE = { mov: "Mobility", act: "Activation", hold: "Long holds" };

  const SPORT = {
    run:  "Recovery for runners",
    bike: "Recovery for cyclists",
    swim: "Recovery for swimmers",
    tri:  "Recovery for triathletes",
    all:  "Full-body recovery"
  };

  const SUBTITLE = {
    run:  "Hips, ankles and posterior chain, with slow control and long holds. It is an easy session, not a day off.",
    bike: "Thoracic rotation, hip independence and the glutes the bike switches off. It is an easy session, not a day off.",
    swim: "Scapular control, thoracic spine and neck — and the ankle, which is what pushes water. It is an easy session, not a day off.",
    tri:  "All three chains connected, plus balance and proprioception. It is an easy session, not a day off.",
    all:  "A full pass from top to bottom, no sport assumed. It is an easy session, not a day off."
  };

  const WHY = {
    run:  "A day without running is when tissue accepts work it would refuse when tired: controlled range, long passive holds and contract-relax. None of that fits into the ten minutes before a session, and it is exactly what a runner who only runs is missing.",
    bike: "The bike leaves you three debts that pedalling does not pay off: a thoracic spine that will not rotate, hips that only work in one plane, and glutes that have switched off. A free day is when you can actually go at them, because there is time for the slow and the long.",
    swim: "A swimmer's shoulder is not fixed by stretching: it is fixed with scapular control and range you can hold. That is slow, repeated work, and it needs a day when you do not have to get in the water afterwards.",
    tri:  "Three sports leave three patterns and none of them is corrected in a hurry. This is the day for what does not fit into an activation: long CARs, passive holds, contract-relax and balance, which is the first thing volume takes away.",
    all:  "A recovery day used well does more for your range than three rushed activations. Here there is time for the slow, the long and the boring, which is where almost all of the benefit lives."
  };

  const DONE = {
    run:  "Done. That was a session, not a rest — keep it in mind tomorrow.",
    bike: "Done. That was a session, not a rest — keep it in mind tomorrow.",
    swim: "Done. That was a session, not a rest — keep it in mind tomorrow.",
    tri:  "Done. That was a session, not a rest — keep it in mind tomorrow.",
    all:  "Done. That was a session, not a rest — keep it in mind tomorrow."
  };

  /* Same sport-aware hand-off as /members/en/mobility/, same reason:
     methodology.md §11 in the product. Mobility and recovery are not rehab. */
  const PAIN = {
    run:  'If something <strong>hurts</strong> rather than feels stiff, this is not the right tool today: go to <a href="/members/en/knees/">Knees</a> or <a href="/members/en/achilles/">Achilles</a>. And if the pain persists, that is a doctor, not a routine.',
    bike: 'If something <strong>hurts</strong> rather than feels stiff, this is not the right tool today: go to <a href="/members/en/knees/">Knees</a>. And if the pain persists, that is a doctor, not a routine.',
    swim: 'If the shoulder <strong>hurts</strong> rather than feels stiff, this is not the right tool today: go to <a href="/members/en/shoulder/">Swimmer’s Shoulder</a>. And if the pain persists, that is a doctor, not a routine.',
    tri:  'If something <strong>hurts</strong> rather than feels stiff, this is not the right tool today: go to <a href="/members/en/knees/">Knees</a>, <a href="/members/en/achilles/">Achilles</a> or <a href="/members/en/shoulder/">Shoulder</a>. And if the pain persists, that is a doctor, not a routine.',
    all:  'If something <strong>hurts</strong> rather than feels stiff, this is not the right tool today: go to <a href="/members/en/knees/">Knees</a>, <a href="/members/en/achilles/">Achilles</a> or <a href="/members/en/shoulder/">Shoulder</a>. And if the pain persists, that is a doctor, not a routine.'
  };

  const SPORT_HINT = {
    run: "", bike: "", swim: "",
    tri:  "For the athlete doing all three: it prioritises hips and shoulders, and adds balance.",
    all:  "No sport assumed. Works just as well for a gym day or a desk day."
  };

  /* Chrome the shared engine would otherwise render as "activación". See
     ai-infrastructure-documentation.md §39 and §40 — three strings, three
     different landing places, and `doneTitle` is markup rather than an engine
     string. *** THESE TRAVEL WITH ANY TRANSLATION OF THIS PAGE. *** */
  const UI_OVERRIDE = { startRoutine: "Start the session →" };
  const DONE_TITLE = "Session complete";

  function build(sport, mins) {
    const m = String(mins);
    if (!BASE[sport]) throw new Error("Unknown sport: " + sport);
    if (["30", "45", "60"].indexOf(m) === -1) throw new Error("Unknown duration: " + m);

    const pick = ids => ids.map(id => {
      const ex = L[id];
      if (!ex) throw new Error("Unknown exercise id: " + id);
      return Object.assign({ video: null, variants: [] }, ex);
    });

    const merge = block => {
      let ids = BASE[sport][block].slice();
      if (m === "45" || m === "60") ids = ids.concat(EXT[sport][block]);
      if (m === "60") ids = ids.concat(DEEP[sport][block]);
      return ids;
    };

    return {
      title: SPORT[sport],
      crumb: "Recovery",
      subtitle: SUBTITLE[sport],
      context: m + " minutes",
      why: WHY[sport],
      doneSub: DONE[sport],
      kicker: "Active recovery",
      restSeconds: 10,
      phases: ["mov", "act", "hold"].map(b => ({ name: PHASE[b], exercises: pick(merge(b)) }))
    };
  }

  return { build: build, library: L, base: BASE, ext: EXT, deep: DEEP,
           phase: PHASE, pain: PAIN, sportHint: SPORT_HINT, ui: UI_OVERRIDE,
           doneTitle: DONE_TITLE };
})();

/* --------------------------------------------------------------- SETUP UI
   Same two-question shape as /members/en/mobility/. What is sport-aware here is
   the pain hand-off; the load warning and the "are you training today?" aside
   are constant, because they are true for every sport. */
(function () {
  const M = window.RECOVERY_MATRIX;
  const choice = { sport: "run", mins: "30" };

  function renderSportBits() {
    const hint = document.getElementById("sportHint");
    hint.innerHTML = M.sportHint[choice.sport] || "";
    hint.hidden = !M.sportHint[choice.sport];
    document.getElementById("painAside").innerHTML = M.pain[choice.sport];
  }

  document.querySelectorAll(".setup-opts[data-axis]").forEach(group => {
    const axis = group.dataset.axis;
    group.querySelectorAll(".setup-opt").forEach(btn => {
      btn.addEventListener("click", () => {
        choice[axis] = btn.dataset.val;
        group.querySelectorAll(".setup-opt").forEach(b =>
          b.setAttribute("aria-pressed", String(b === btn)));
        if (axis === "sport") renderSportBits();
      });
    });
  });

  renderSportBits();

  document.getElementById("setupGo").addEventListener("click", () => {
    window.ACTIVATION_DATA = M.build(choice.sport, choice.mins);
    Object.assign(window.ACTIVATION_UI, M.ui);

    document.getElementById("setup").hidden = true;
    document.getElementById("toolWrap").hidden = false;

    document.getElementById("doneSub").textContent = window.ACTIVATION_DATA.doneSub;
    document.getElementById("crumbLabel").textContent = window.ACTIVATION_DATA.crumb;
    document.getElementById("doneTitle").textContent = M.doneTitle;

    const s = document.createElement("script");
    // Fingerprinted engine URL, published by the partial as TP_ENGINE_SRC.
    // A literal path here would be unfingerprinted and therefore pinned in
    // the visitor's browser for a year by Caddy's immutable header on
    // /assets/js/* — the September 8, 2026 defect. Do not inline it back.
    s.src = window.TP_ENGINE_SRC;
    document.body.appendChild(s);

    s.addEventListener("load", () => {
      const back = document.createElement("button");
      back.className = "change-link setup-back";
      back.textContent = "← Change options";
      back.addEventListener("click", () => location.reload());
      document.querySelector(".tool").prepend(back);
    });
  });
})();
</script>
