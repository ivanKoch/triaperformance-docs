{% raw %}
<script>
// Restructured August 13, 2026 (Iván): three phases by PURPOSE — activación,
// core, movilidad — instead of by body position. Everything is timed rather
// than counted: a rep count on a hotel-room floor turns into a race, and the
// point of this routine is control. Deep mobility holds use the engine's
// per-exercise `secs` override (60s) instead of the routine default (45s).
window.ACTIVATION_DATA = {
  title: "Core para el hotel",
  crumb: "Core",
  subtitle: "Activación, core y movilidad en una sola rutina, sin equipo. Todo por tiempo: 45 segundos por bloque, 60 en los estiramientos profundos. Los unilaterales son por lado.",
  context: "Habitación de hotel · sin equipo",
  why: "Los viajes rompen la rutina: vuelos, sillas, camas ajenas, comidas afuera. Esta rutina hace las tres cosas que se pierden en un viaje —despertar los glúteos y el core, sostener el tronco, y devolverle rango a la cadera— sin equipo y sin más espacio que el largo de tu cuerpo. No reemplaza una sesión, pero evita volver a casa tres semanas atrás.",
  doneSub: "Hecho. El viaje no es excusa.",
  workSeconds: 45,
  phases: [
    { name: "Activación", exercises: [
      { name: "Dead bug", mode: "alt", tag: "Boca arriba", video: null,
        cue: "Boca arriba, brazos al techo y rodillas a 90°. Extiende brazo y pierna contrarios, lentos, sin que la lumbar se despegue del piso. <strong>Exhala al extender: es la exhalación la que aplana la espalda, no la fuerza abdominal.</strong> Si la lumbar se levanta, baja menos la pierna. El objetivo es control, no velocidad.",
        variants: [
          { name: "Dead bug isométrico", mode: "bi", cue: "Boca arriba, brazos y rodillas a 90°. Empuja las manos contra las rodillas y sostén la tensión respirando normal. La lumbar no se despega." },
          { name: "Descenso de piernas", mode: "alt", cue: "Boca arriba, piernas a 90°, brazos quietos. Baja una pierna por vez hasta rozar el piso con el talón y vuelve. La lumbar no se despega: si se levanta, no bajes tanto." }
        ]},
      { name: "Toques de talón (pingüinos)", mode: "alt", tag: "Boca arriba", video: null,
        cue: "Rodillas flexionadas, pies apoyados, omóplatos apenas despegados y ahí se quedan. Inclínate a un lado hasta tocar el talón, después al otro. Rango corto y rápido. Si la cabeza se apoya entre reps, el estímulo se corta.",
        variants: [
          { name: "Crunch corto", mode: "bi", cue: "Boca arriba, manos detrás de la cabeza sin tirar del cuello. Despega solo los omóplatos y quédate en ese rango corto, con tensión constante. No subas hasta sentarte." },
          { name: "Bicicleta lenta", mode: "alt", cue: "Boca arriba, omóplatos despegados. Codo hacia la rodilla contraria mientras la otra pierna se extiende sin tocar el piso. Lento, con rotación real del tronco, no un vaivén de codo." }
        ]},
      { name: "Puente de glúteos", mode: "bi", tag: "Boca arriba", video: null,
        cue: "Pies cerca de los glúteos. Sube la cadera empujando con los talones y <strong>sostén dos segundos arriba apretando los glúteos</strong>. La pausa es el ejercicio; sin ella son solo repeticiones. Baja controlado, sin arquear la lumbar. Si lo sientes en los isquios, acerca los pies.",
        variants: [
          { name: "Puente de glúteos a una pierna", mode: "uni", cue: "Un talón apoyado cerca de los glúteos, la otra rodilla abrazada al pecho. Empuja con el talón y aprieta el glúteo arriba. <strong>Si lo sientes en la lumbar, mete la pelvis y baja la altura</strong>: la idea es aislar el glúteo, no que el psoas haga el trabajo." },
          { name: "Puente con marcha", mode: "alt", cue: "Puente arriba y sostenido. Desde ahí despega un pie unos centímetros, apoya, y cambia. <strong>La cadera no baja y no rota.</strong> Despacio: esto es control, no repeticiones." }
        ]},
      { name: "Gato-camello", mode: "bi", tag: "Cuadrupedia", video: null,
        cue: "En cuadrupedia, alterna redondear y arquear la columna al ritmo de la respiración. <strong>Muévete desde la pelvis y deja que la columna la siga vértebra por vértebra</strong> — no en bloque, y no solo cuello y hombros. Esto es control pélvico y articular, no un estiramiento. Rango cómodo, no máximo.",
        variants: [
          { name: "Gato-camello sentado", mode: "bi", cue: "Sentado al borde de una silla o de la cama, manos en las rodillas. Exhala redondeando la espalda, inhala arqueándola. Muévete desde la pelvis, vértebra por vértebra." },
          { name: "Thread the needle", mode: "uni", cue: "En cuadrupedia, pasa un brazo por debajo del cuerpo hasta apoyar el hombro; después abre el mismo brazo hacia el techo siguiéndolo con la mirada. <strong>La cadera se queda quieta y encuadrada</strong>: la rotación sale de la columna dorsal, no de la lumbar." }
        ]},
      { name: "Bird dog", mode: "alt", tag: "Cuadrupedia", video: null,
        cue: "En cuadrupedia, extiende brazo y pierna contrarios hasta la línea del tronco y sostén dos o tres segundos. <strong>La cadera queda cuadrada al piso y la lumbar quieta</strong>: si se abre hacia un costado o la espalda se arquea, baja la pierna. Imagina un vaso de agua sobre la lumbar que no se puede volcar. Aprieta el glúteo al estirar la pierna.",
        variants: [
          { name: "Bird dog isométrico", mode: "uni", cue: "En cuadrupedia, extiende brazo y pierna contrarios hasta la línea del tronco y quédate ahí todo el bloque. Cadera cuadrada, lumbar quieta. Imagina un vaso de agua sobre la lumbar." },
          { name: "Bird dog codo-rodilla", mode: "alt", cue: "En cuadrupedia, extiende brazo y pierna contrarios. Entre repeticiones, junta codo y rodilla debajo del cuerpo antes de volver a extender. La lumbar no se mueve en el cierre ni en la apertura." }
        ]}
    ]},

    { name: "Core", exercises: [
      { name: "Plancha alta con toque de hombro", mode: "alt", tag: "Boca abajo", video: null,
        cue: "Plancha alta, pies bien separados. Toca el hombro contrario y vuelve. El objetivo no es tocar rápido: es que la cadera no se mueva ni un centímetro. Si baila, separa más los pies o apoya las rodillas.",
        variants: [
          { name: "Plancha alta isométrica", mode: "bi", cue: "Plancha alta, manos bajo los hombros. Empuja el piso, espalda ancha, pelvis metida. Sostén sin movimiento. Si la lumbar se hunde, apoya las rodillas." },
          { name: "Plancha con rodillas apoyadas", mode: "alt", cue: "Plancha con las rodillas en el piso, pies despegados. Toca el hombro contrario con una mano y vuelve. La cadera no se mueve. Es la regresión correcta, no una versión menor." }
        ]},
      { name: "Plancha lateral", mode: "uni", tag: "De costado", video: null,
        cue: "Codo debajo del hombro, cuerpo en línea de cabeza a pies. Empuja la cadera de abajo hacia el techo en vez de solo aguantar. Si tiembla, está bien; si la cadera se cae, corta el bloque.",
        variants: [
          { name: "Plancha lateral con rodillas apoyadas", mode: "uni", cue: "De costado, antebrazo bajo el hombro, rodillas flexionadas y apoyadas. Cuerpo en línea de hombros a rodillas. Empuja la cadera de abajo hacia el techo. Misma línea de tronco, menos palanca." },
          { name: "Plancha lateral con elevación de pierna", mode: "uni", cue: "Antebrazo debajo del hombro, cuerpo en línea, cadera arriba. <strong>Una vez estable</strong>, sube y baja la pierna de arriba controlada. Oblicuos y glúteo medio." }
        ]},
      { name: "Plancha alta a perro boca abajo", mode: "bi", tag: "Boca abajo", video: null,
        cue: "Desde la plancha alta, empuja la cadera arriba y atrás hasta el perro boca abajo, talones al piso, y vuelve. Si los isquios están duros, flexiona un poco las rodillas: la espalda recta manda.",
        variants: [
          { name: "Perro boca abajo sostenido", mode: "bi", cue: "Manos y pies en el piso, cadera alta, talones buscando el suelo. Quédate ahí todo el bloque pedaleando suave con los talones. Espalda larga; si los isquios tiran, flexiona un poco las rodillas." },
          { name: "Plancha alta a rodillas", mode: "bi", cue: "Desde la plancha alta, baja las rodillas al piso y vuelve a extender. Pelvis metida en ambos puntos. Úsala si el hombro molesta en el perro boca abajo." }
        ]}
    ]},

    { name: "Movilidad", exercises: [
      { name: "El mejor estiramiento del mundo", mode: "uni", tag: "De pie a zancada", video: null,
        cue: "Zancada profunda, pie adelantado por fuera de la mano. Baja el codo de adentro hacia el piso, aguanta un segundo, y después <strong>rota ese brazo abriendo hacia el techo siguiendo la mano con la mirada</strong>. Cadera, aductor y torácica en un solo gesto.",
        variants: [
          { name: "Zancada baja con rotación", mode: "uni", cue: "Zancada con la rodilla de atrás apoyada, mano de adentro al piso junto al pie. Rota el tronco y abre el brazo de arriba hacia el techo, siguiendo la mano con la mirada." },
          { name: "Zancada con manos en el piso", mode: "uni", cue: "Zancada profunda, las dos manos al piso por dentro del pie de adelante. Sin rotación: deja caer la cadera y respira. Pecho alto, rodilla de atrás suave." }
        ]},
      { name: "Barridos 90-90 de cadera", mode: "alt", tag: "Sentado", video: null,
        cue: "Sentado, una pierna a 90° adelante y la otra a 90° al costado. Lleva las rodillas de un lado al otro como un limpiaparabrisas, lento. Pecho alto: si te encorvas, el movimiento sale de la lumbar. Ayúdate con las manos atrás si hace falta.",
        variants: [
          { name: "90-90 sostenido", mode: "uni", cue: "Sentado, una pierna a 90° adelante y la otra a 90° al costado. Quédate de un lado, pecho alto, inclinándote suave hacia adelante desde la cadera. No redondees la lumbar para llegar más lejos." },
          { name: "Mariposa sentado", mode: "bi", cue: "Plantas de los pies juntas, rodillas hacia afuera. Inclínate suave hacia adelante desde la cadera, espalda larga. No redondees para llegar más abajo." }
        ]},
      { name: "Postura de la paloma", mode: "uni", secs: 60, tag: "Piso", video: null,
        cue: "Pierna de adelante flexionada cruzada, la de atrás estirada y alineada, no abierta al costado. Presiona la espinilla de adelante contra el piso en vez de derrumbarte. Si la rodilla molesta, pon una almohada bajo la cadera.",
        variants: [
          { name: "Figura 4 boca arriba", mode: "uni", cue: "Boca arriba, cruza un tobillo sobre la rodilla contraria y trae el muslo de abajo hacia el pecho. Empuja suave la rodilla cruzada hacia afuera con el codo. <strong>Empieza por el lado que sientes más rígido.</strong> Respira largo y no fuerces el rango." },
          { name: "Figura 4 sentado", mode: "uni", cue: "Sentado al borde de una silla o de la cama, tobillo sobre la rodilla contraria. Inclínate suave hacia adelante desde la cadera, espalda larga. Empieza por el lado más rígido." }
        ]},
      { name: "Couch stretch", mode: "uni", secs: 60, tag: "Cama o pared", video: null,
        cue: "De rodillas de espaldas a una pared o a la base de la cama, empeine de atrás apoyado y el otro pie adelante en zancada. <strong>Mete la pelvis y aprieta el glúteo de la pierna de atrás antes de subir el tronco.</strong> Sin eso, la pelvis rota y el estiramiento se lo lleva la lumbar en vez del psoas y el cuádriceps. Casi nadie necesita subir tanto como cree.",
        variants: [
          { name: "Psoas con apriete de glúteo", mode: "uni", cue: "Media rodilla, pie de adelante plano. <strong>Mete la pelvis y aprieta fuerte el glúteo de la pierna de atrás antes de avanzar la cadera.</strong> Sin ese apriete estás estirando la lumbar y no el psoas: ese apriete es el ejercicio." },
          { name: "Cuádriceps de pie", mode: "uni", cue: "De pie, talón al glúteo, rodillas juntas y pelvis metida. Sujeta el tobillo, no el pie. Si la lumbar se arquea, afloja el rango. Es la versión de pie cuando el piso no es opción." }
        ]},
      { name: "Postura del niño a cobra", mode: "bi", tag: "Piso", video: null,
        cue: "Siéntate sobre los talones con los brazos adelante; deslízate hacia adelante dejando caer la cadera y abriendo el pecho. Ida y vuelta, respirando. Cierra quedándote en la postura del niño.",
        variants: [
          { name: "Postura del niño", mode: "bi", cue: "Sentado sobre los talones, brazos largos adelante, frente al piso. Sin flujo: solo respira hacia la espalda baja y deja que la cadera baje un poco más con cada exhalación." },
          { name: "Cobra sostenida", mode: "bi", cue: "Boca abajo, manos bajo los hombros, pecho arriba y cadera en el piso. Hombros lejos de las orejas. Si la lumbar aprieta, baja un poco el pecho o adelanta las manos." }
        ]}
    ]}
  ]
};
</script>
