      variants: [{ name: "Canela e peito do pé no rolo", mode: "bi", tag: "Rolo",
        cue: "Em quatro apoios, o rolo sobre a frente da canela, rolando devagar do joelho ao tornozelo. Região sensível: <strong>menos pressão do que você imagina.</strong>" }] },

    /* ------------------------------------------------------- TRONCO / COSTAS */
    childPose: { name: "Postura da criança", mode: "bi", tag: "Sem equipamento", secs: 60,
      cue: "Sentado sobre os calcanhares, braços longos à frente, testa no chão. <strong>Respire em direção à lombar</strong> e deixe o quadril descer um pouco mais a cada expiração. Aqui o objetivo é baixar os batimentos, não alongar mais." },

    childReach: { name: "Criança com alcance lateral", mode: "uni", tag: "Sem equipamento", secs: 45,
