  const SPORT_HINT = {
    run:  "",
    bike: "",
    swim: "",
    tri:  "Para um dia com mais de um esporte: um tijolo, ou bike de manhã e corrida à tarde.",
    all:  "Se está tudo duro, se foi dia de academia, ou se você prefere não escolher."
