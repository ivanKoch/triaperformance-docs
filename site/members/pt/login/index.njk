---
layout: layouts/base.njk
navVariant: "none"
footerVariant: "none"
pageCss: "members-login.css"
title: "Entrar — Área de Membros"
---
{#- Posts to /members/login, the same single endpoint the ES and EN pages use.
    See the note in site/members/login/index.njk. -#}
<div class="login-card">
  <h1>Área de Membros</h1>
  <p class="sub">Digite a senha que você recebeu por email ao assinar o All-Access.</p>

  <div class="error" id="login-error">Senha incorreta. Tente novamente.</div>

  <form method="POST" action="/members/login" id="login-form">
    <label for="password">Senha</label>
    <input type="password" id="password" name="password" required autocomplete="current-password">
    <input type="hidden" name="next" id="next-field" value="">
    <input type="hidden" name="lang" value="pt">
    <button type="submit">Entrar</button>
  </form>

  <p class="help"><a href="/members/pt/forgot-password">Esqueceu sua senha?</a></p>
  <p class="help">Problemas para entrar? Escreva para <a href="mailto:coach@triaperformance.com">coach@triaperformance.com</a></p>

  <p class="auth-lang">
    <a href="/members/login">Español</a><span class="sep">·</span><a href="/members/en/login">English</a><span class="sep">·</span><a href="/members/pt/login" class="current">Português</a>
  </p>
</div>

<script>
  if (new URLSearchParams(window.location.search).get('error') === '1') {
    document.getElementById('login-error').classList.add('show');
  }
  var next = new URLSearchParams(window.location.search).get('next');
  if (next && /^\/[^/\\]/.test(next)) document.getElementById('next-field').value = next;
</script>
