  </div>

  <div class="setup-q">
    <div class="setup-label">Qual é o seu esporte?</div>
    <div class="setup-opts setup-opts--wrap" data-axis="sport">
      <button type="button" class="setup-opt" data-val="run" aria-pressed="true">Corrida</button>
      <button type="button" class="setup-opt" data-val="bike" aria-pressed="false">Bike</button>
      <button type="button" class="setup-opt" data-val="swim" aria-pressed="false">Natação</button>
