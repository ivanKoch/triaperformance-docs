<script>
window.RECOVERY_MATRIX = (function () {

  /* ---------------------------------------------------------------- LIBRARY
     One definition per exercise, one cue. `secs` is the hold or the block —
     longer than /members/pt/mobilidade/ throughout, because this is the tool with
     the time: 60s CARs, 90s PNF, 120-240s flows and passive holds.

     `variants` carry everything that is not a mat and a wall. The base routine
     never needs them, and the engine hides its own "Trocar exercício" button
     on any exercise that has none. */
  const L = {

    /* ============================================== SÓ NESTA FERRAMENTA
       CARs, fluxos, posturas longas, PNF e equilíbrio. É o que uma ativação não
       consegue fazer em doze minutos, e por isso ABREM as rotinas em vez de
       fechá-las. Se um dia isto ficar no fim, a ferramenta voltou a ser a matriz
       de ativação esticada. */
    carsHip: { name: "CARs de quadril", mode: "uni", tag: "Sem equipamento", secs: 60,
      cue: "Em pé ou em quatro apoios: joelho ao peito, abra ao lado, gire para trás e desça. O círculo maior que conseguir sem nada mais se mexer além do quadril. Se o tronco compensar, diminua o círculo." },

    carsShoulder: { name: "CARs de ombro", mode: "uni", tag: "Sem equipamento", secs: 60,
      cue: "Braço esticado: suba pela frente, gire e desça por trás, o círculo mais amplo possível. Costelas para baixo, a outra mão no esterno para sentir se o tronco se mexe." },

    carsSpine: { name: "CARs de coluna", mode: "bi", tag: "Sem equipamento", secs: 90,
      cue: "Sentado sobre os calcanhares ou numa cadeira. Segmento por segmento: flexão e extensão torácica, inclinação para cada lado, rotação. O quadril não se mexe: se mexer, você já não está movendo a coluna." },

    carsAnkle: { name: "CARs de tornozelo", mode: "uni", tag: "Sem equipamento", secs: 45,
      cue: "Sentado, perna esticada. Desenhe o círculo maior que conseguir com a ponta do pé, nos dois sentidos. Joelho e perna quietos. Busque a borda da amplitude e fique um segundo em cada ponto." },

    dogFlow: { name: "Cachorro para baixo ao cachorro para cima", mode: "bi", tag: "Sem equipamento", secs: 120,
      cue: "Flua no ritmo da respiração: expire para o cachorro olhando para baixo empurrando os calcanhares; inspire para o cachorro olhando para cima abrindo o peito. Sem apressar a passagem." },

    sunFlow: { name: "Saudação ao sol lenta", mode: "bi", tag: "Sem equipamento", secs: 240,
      cue: "Sequência lenta, um movimento por respiração: em pé, mãos no alto, dobre, meia elevação, prancha, cachorro olhando para baixo, passo à frente e volte. Alterne a perna que avança." },

    warriorFlow: { name: "Guerreiro I para II e Triângulo", mode: "uni", tag: "Sem equipamento", secs: 120,
      cue: "Guerreiro I com o quadril à frente, abra para Guerreiro II girando o tronco e dali desça ao triângulo com o braço longo. Umas cinco respirações em cada. Joelho da frente sobre o tornozelo, nunca à frente do pé." },

    deepSquatHold: { name: "Agachamento profundo sustentado", mode: "bi", tag: "Sem equipamento", secs: 120,
      cue: "Lá embaixo, calcanhares no chão, cotovelos por dentro dos joelhos empurrando de leve para fora. Mexa-se dentro da postura. Se os calcanhares subirem, apoie-os em alguma coisa." },

    frog: { name: "Postura da rã", mode: "bi", tag: "Sem equipamento", secs: 180,
      cue: "Joelhos abertos na linha do quadril, tornozelos atrás dos joelhos, antebraços no chão. Desça até o primeiro ponto de tensão e fique respirando, sem buscar mais. O tempo faz o trabalho. <strong>Só num dia sem sessão</strong> — sobre tecido recém-treinado não vai." },

    dragon: { name: "Dragão alado", mode: "uni", tag: "Sem equipamento", secs: 90,
      cue: "Passada bem longa, mãos por dentro do pé da frente, joelho de trás no chão. Deixe o joelho da frente cair para fora e desça aos antebraços se alcançar. Fique num 6 ou 7 de 10. Sem quiques." },

    pnfHip: { name: "Psoas com contrair e soltar", mode: "uni", tag: "Sem equipamento", secs: 90,
      cue: "Meio ajoelhado, pelve encaixada. Empurre o joelho de trás contra o chão a 20% por 5 segundos, solte e avance um pouco. Três ou quatro ciclos. Esse contrair-e-soltar é o que ganha amplitude." },

    pnfHam: { name: "Posteriores com contrair e soltar", mode: "uni", tag: "Sem equipamento", secs: 90,
      cue: "De barriga para cima, perna ao teto segurada atrás da coxa. Empurre o calcanhar contra as mãos a 20% por 5 segundos, solte e suba um pouco mais. Três ou quatro ciclos. A perna de baixo fica apoiada." },

    balance: { name: "Apoio em uma perna", mode: "uni", tag: "Sem equipamento", secs: 40,
      cue: "Em pé numa perna só, joelho levemente flexionado. <strong>O quadril não pode cair do lado que está no ar.</strong> Faça o pé trabalhar: dedos ativos, tornozelo corrigindo. Se estiver fácil, feche os olhos. Tenha uma parede ou uma cadeira ao alcance." },

    rollDown: { name: "Enrolar da coluna de barriga para cima", mode: "bi", tag: "Sem equipamento", secs: 90,
      cue: "De barriga para cima, joelhos dobrados. Suba vértebra por vértebra até as omoplatas e desça igualmente devagar, de cima para baixo. O que você busca é a coluna articular por segmentos, não subir alto." },

    bodyScan: { name: "Varredura corporal", mode: "bi", tag: "Sem equipamento", secs: 180,
      cue: "De barriga para cima, pernas longas, palmas para cima. Percorra o corpo dos pés à cabeça, uma respiração por zona, soltando o que achar preso. Mandíbula e trapézios no final." },

    /* =========================================================== MOBILIDADE
       Movimentos que também existem em /members/core/ ou na matriz de ativação.
       Estão aqui porque são os corretos, mas são MINORIA e vêm depois do bloco
       acima — ver a decisão 1 no cabeçalho. */
    catcow: { name: "Gato-vaca", mode: "bi", tag: "Sem equipamento", secs: 60,
      cue: "Em quatro apoios, alterne arredondar e arquear no ritmo da respiração. <strong>Faça o dobro de devagar do que faria antes de treinar</strong> e procure os segmentos que não se mexem. Vértebra por vértebra, não em bloco. Depois do treino isso é para soltar, não para mobilizar forte." },

    threadNeedle: { name: "Rotação torácica em quatro apoios", mode: "uni", tag: "Sem equipamento", secs: 60,
      cue: "Em quatro apoios, uma mão atrás da cabeça. Leve o cotovelo em direção ao joelho contrário e depois abra girando o tronco, acompanhando o cotovelo com o olhar. <strong>O quadril fica alinhado</strong>: se for junto, você está rodando pela lombar e não pelas costas altas." },

    openBook: { name: "Livro aberto", mode: "uni", tag: "Sem equipamento", secs: 60,
      cue: "De lado, joelhos dobrados e empilhados, braços juntos à frente. Abra o braço de cima acompanhando a mão com o olhar e <strong>deixe os joelhos quietos</strong>. Se os joelhos se separarem, a rotação foi para a lombar.",
      variants: [{ name: "Extensão torácica sobre o rolo", mode: "bi", tag: "Rolo",
        cue: "Rolo atravessado sob as costas altas, mãos atrás da nuca. Estenda para trás soltando o ar e mova o rolo dois dedos para cima, segmento por segmento. Os glúteos ficam apoiados: <strong>nunca abaixo das últimas costelas</strong>, ali quem estende é a lombar." }] },

    wgs: { name: "O melhor alongamento do mundo", mode: "uni", tag: "Sem equipamento", secs: 60,
      cue: "Passada profunda, pé da frente por fora da mão. Desça o cotovelo de dentro em direção ao chão, segure um segundo e depois <strong>gire esse braço abrindo para o teto, acompanhando a mão com o olhar</strong>. Quadril, adutor e torácica num gesto só." },

    nineNinety: { name: "Quadril 90/90", mode: "uni", tag: "Sem equipamento", secs: 60,
      cue: "Sentado, uma perna a 90° à frente e a outra a 90° ao lado. Incline sobre a da frente, volte e passe para o outro lado levantando os joelhos sem usar as mãos. Essa transição ativa é o exercício." },

    spiderman: { name: "Passada homem-aranha com rotação", mode: "uni", tag: "Sem equipamento", secs: 60,
      cue: "Da prancha, leve o pé por fora da mão do mesmo lado. Desça o cotovelo em direção ao chão e dali abra o braço para o teto. Várias repetições lentas por lado, não uma só sustentada." },

    inchworm: { name: "Caminhada da lagarta", mode: "bi", tag: "Sem equipamento", secs: 60,
      cue: "Em pé, dobre à frente e caminhe com as mãos até a prancha, sem mover os pés. Volte caminhando as mãos para trás. Pernas o mais esticadas que aguentarem." },

    cossack: { name: "Agachamento cossaco", mode: "uni", tag: "Sem equipamento", secs: 60,
      cue: "Pés bem abertos. Desça o peso sobre uma perna deixando a outra esticada com a ponta para cima. Peito alto, calcanhar da perna que desce colado no chão. Não vá até o fundo se as costas arredondarem." },

    legSwing: { name: "Balanço de perna (frente e trás)", mode: "uni", tag: "Parede", secs: 45,
      cue: "Apoie-se numa parede e balance a perna para frente e para trás. <strong>Aumente a amplitude aos poucos</strong>: começar no máximo é o jeito clássico de puxar o posterior." },

    kneeWall: { name: "Joelho na parede", mode: "uni", tag: "Parede", secs: 45,
      cue: "Pé a um palmo da parede. Toque a parede com o joelho sem o calcanhar descolar. Se chegar fácil, afaste o pé um centímetro e tente de novo. Melhora com repetições, não com força." },

    wallAngel: { name: "Anjos na parede", mode: "bi", tag: "Parede", secs: 60,
      cue: "Costas na parede, lombar colada, braços em W com cotovelos e dorso das mãos tocando. Suba e desça sem descolar nada. <strong>Pare exatamente onde alguma coisa sair da parede</strong>: até ali vai a sua amplitude de hoje, e forçar além disso não aumenta.",
      variants: [{ name: "Passagem de bastão (com limite)", mode: "bi", tag: "Bastão ou cabo",
        cue: "Pegada bem aberta, braços esticados, passe o bastão das coxas para trás e volte. Isso não é concurso de flexibilidade: <strong>pare onde as costelas abrirem, a lombar arquear ou os ombros subirem</strong>. Se precisar forçar, feche a pegada." }] },

    scorpion: { name: "Escorpião de bruços", mode: "uni", tag: "Sem equipamento", secs: 45,
      cue: "De bruços, braços em cruz. Leve um calcanhar cruzado até a mão contrária deixando o quadril girar, peito o mais colado no chão que conseguir. Devagar na ida e na volta." },

    neckCars: { name: "CARs de pescoço", mode: "bi", tag: "Sem equipamento", secs: 60,
      cue: "Sentado, ombros quietos. Queixo no peito, role até um ombro, orelha atrás, e complete o círculo. Bem devagar. Se aparecer tontura ou formigamento, pare." },

    /* ========================================================== ATIVAÇÃO
       Isto é trabalho de força e controle, não mobilidade, e por isso o bloco se
       chama como se chama. Ver a decisão 4 acima: a copy não pode sugerir que
       esta sessão sai de graça. */
    clamshell: { name: "Concha lenta", mode: "uni", tag: "Sem equipamento", secs: 45,
      cue: "De lado, joelhos dobrados, calcanhares juntos. Abra o joelho de cima sem o quadril cair para trás. Mão no glúteo para sentir o trabalho ali. Devagar, um segundo no alto.",
      variants: [{ name: "Concha com miniband", mode: "uni", tag: "Miniband",
        cue: "De lado, faixa acima dos joelhos, calcanhares juntos. Abra o joelho de cima sem o quadril cair para trás. A descida tão lenta quanto a subida." }] },

    bridgeSingle: { name: "Ponte de glúteos unilateral", mode: "uni", tag: "Sem equipamento", secs: 45,
      cue: "Um calcanhar perto dos glúteos, o outro joelho abraçado no peito. Empurre pelo calcanhar e aperte o glúteo no alto. <strong>Se sentir na lombar, encaixe a pelve e baixe a altura</strong>: a ideia é isolar o glúteo, não deixar o psoas fazer o trabalho de novo." },

    gluteBridgeMarch: { name: "Ponte com marcha", mode: "bi", tag: "Sem equipamento", secs: 60,
      cue: "Ponte no alto e sustentada. Dali descole um pé alguns centímetros, apoie e troque. <strong>O quadril não desce e não gira.</strong> Devagar: isso é controle, não repetição." },

    birdDog: { name: "Bird dog", mode: "uni", tag: "Sem equipamento", secs: 45,
      cue: "Em quatro apoios, estenda o braço e a perna opostos até a linha do tronco e segure dois ou três segundos. <strong>O quadril fica quadrado com o chão e a lombar quieta</strong>: se abrir para o lado ou as costas arquearem, desça a perna. Imagine um copo d'água na lombar que não pode tombar. Aperte o glúteo ao estender a perna." },

    deadBug: { name: "Dead bug", mode: "bi", tag: "Sem equipamento", secs: 60,
      cue: "Deitado de barriga para cima, braços para o teto e joelhos a 90°. Estenda o braço e a perna opostos, devagar, sem deixar a lombar sair do chão. <strong>Expire ao estender: é a expiração que cola as costas no chão, não a força do abdômen.</strong> Se a lombar levantar, desça menos a perna. O objetivo é controle, não velocidade." },

    sidePlank: { name: "Prancha lateral dinâmica", mode: "uni", tag: "Sem equipamento", secs: 45,
      cue: "Antebraço sob o ombro, quadril alto, corpo em linha. Desça o quadril até roçar o chão e suba de novo, devagar. Joelhos apoiados se a versão longa quebrar a linha." },

    bearCrawl: { name: "Caminhada do urso", mode: "bi", tag: "Sem equipamento", secs: 60,
      cue: "Quatro apoios com os joelhos a um palmo do chão. Avance e recue movendo mão e pé opostos, quadril baixo, sem balançar de lado a lado. Passos curtos." },

    scapPushup: { name: "Flexão escapular", mode: "bi", tag: "Sem equipamento", secs: 45,
      cue: "Prancha alta, cotovelos esticados o tempo todo. Deixe o peito cair juntando as omoplatas e depois empurre o chão afastando-as ao máximo. O movimento tem três ou quatro centímetros." },

    ytwl: { name: "Y-T-W de bruços", mode: "bi", tag: "Sem equipamento", secs: 60,
      cue: "De bruços, testa apoiada, polegares para o teto. Descole os braços em Y, depois em T, depois em W (cotovelos a 90° junto das costelas). <strong>As omoplatas vão para baixo, nunca em direção às orelhas</strong>: se encolher os ombros, quem trabalha é o trapézio superior.",
      variants: [{ name: "Y-T-W com faixa", mode: "bi", tag: "Faixa longa",
        cue: "Em pé, faixa à frente. Mesma sequência Y, T e W contra resistência baixa. Muitas repetições, pouca tensão. Omoplatas para baixo, nunca em direção às orelhas." }] },

    extRotation: { name: "Rotação externa isométrica", mode: "uni", tag: "Parede", secs: 45,
      cue: "Cotovelo colado nas costelas a 90°, dorso do pulso contra o batente de uma porta ou uma parede. <strong>Empurre para fora a 50% e sustente, sem nada se mover.</strong> O ombro não vai para frente e o cotovelo não se afasta do corpo.",
      variants: [{ name: "Rotação externa com miniband", mode: "uni", tag: "Miniband",
        cue: "Faixa ancorada na altura do cotovelo, cotovelo colado nas costelas. Gire o antebraço para fora e volte mais lento do que foi. Amplitude curta e controlada." }] },

    latWalk: { name: "Caminhada lateral em meio agachamento", mode: "bi", tag: "Sem equipamento", secs: 60,
      cue: "Meio agachamento, peito alto. Ande de lado com passos iguais, sem juntar os pés por completo. Joelhos para fora e quadril na mesma altura. Ida e volta.",
      variants: [{ name: "Caminhada lateral com miniband", mode: "bi", tag: "Miniband",
        cue: "Meio agachamento, faixa nos tornozelos ou acima dos joelhos. Ande de lado com passos iguais, sem o pé de trás arrastar. Joelhos empurrando para fora e quadril na mesma altura." }] },

    calfEcc: { name: "Elevação de panturrilha excêntrica", mode: "bi", tag: "Sem equipamento", secs: 60,
      cue: "Suba nas pontas com as duas pernas e desça com uma só em três segundos. A descida é o exercício. Alterne a perna que desce. Não quique embaixo.",
      variants: [{ name: "Excentricas no degrau", mode: "bi", tag: "Degrau",
        cue: "Meia planta na beira do degrau. Suba com duas, desça com uma deixando o calcanhar cair abaixo, três segundos. Se já está num protocolo de aquiles, conte essas séries como parte daquele." }] },

    plantarFlex: { name: "Tornozelos para a pernada", mode: "bi", tag: "Sem equipamento", secs: 45,
      cue: "Sentado com as pernas esticadas, aponte as pontas dos pés o mais longe que conseguir e segure; depois puxe-as na sua direção. <strong>Ativo, não passivo</strong>: é a amplitude que empurra a água na pernada." },

    tva: { name: "Ativação do transverso", mode: "bi", tag: "Sem equipamento", secs: 60,
      cue: "De barriga para cima, joelhos dobrados, mãos por dentro dos ossos do quadril. Inspire no abdômen; ao expirar leve o umbigo para dentro e para cima sem mover a pelve. Você deve sentir uma tensão suave sob os dedos." },

    reverseLunge: { name: "Afundo inverso com braços acima", mode: "uni", tag: "Sem equipamento", secs: 45,
      cue: "Passo longo para trás descendo o joelho, braços esticados acima da cabeça e costelas para baixo. Os braços no alto transformam isso em trabalho de quadril e torácica ao mesmo tempo." }
  };

  /* ------------------------------------------------------------- ROUTINES
     Three tiers, three named blocks, and the tiers GROW THE BLOCKS rather than
     appending new ones. That is the difference from /members/pt/mobilidade/, and it
     is deliberate: there the tiers were the story (unload, then the rest of the
     chain, then the forgotten spots), here the BLOCKS are the story, because
     the athlete has to be able to see that a third of this session is
     activation work and not mobility. Decision 4.

     So: 30 = BASE, 45 = BASE + EXT, 60 = BASE + EXT + DEEP, merged per block.
     `mov` always opens. Decision 1 lives in the ORDER of these lists — the
     CARs, flows, PNF and holds come first inside `mov`, and the movements that
     also exist in /members/core/ or the activation matrix follow them. */
  const BASE = {
    run: {
      mov:  ["carsHip", "carsAnkle", "carsSpine", "nineNinety", "dogFlow", "deepSquatHold", "wgs", "legSwing"],
      act:  ["calfEcc", "bridgeSingle", "birdDog", "deadBug", "balance"],
      hold: ["pnfHam", "frog"] },
    bike: {
      mov:  ["carsSpine", "carsHip", "deepSquatHold", "threadNeedle", "openBook", "nineNinety", "spiderman", "catcow"],
      act:  ["clamshell", "birdDog", "tva", "sidePlank"],
      hold: ["pnfHip", "frog"] },
    swim: {
      mov:  ["carsShoulder", "neckCars", "carsSpine", "carsHip", "deepSquatHold", "wallAngel", "threadNeedle", "openBook", "catcow"],
      act:  ["ytwl", "scapPushup", "extRotation", "deadBug", "plantarFlex"],
      hold: ["pnfHip", "dragon"] },
    tri: {
      mov:  ["carsHip", "carsShoulder", "carsSpine", "dogFlow", "nineNinety", "deepSquatHold", "spiderman", "catcow"],
      act:  ["clamshell", "birdDog", "deadBug", "balance", "calfEcc"],
      hold: ["pnfHip", "frog"] },
    all: {
      mov:  ["carsHip", "carsShoulder", "carsSpine", "carsAnkle", "dogFlow", "deepSquatHold", "wgs", "catcow"],
      act:  ["bridgeSingle", "birdDog", "deadBug", "sidePlank", "balance"],
      hold: ["pnfHam", "frog"] }
  };

  const EXT = {
    run:  { mov: ["cossack", "kneeWall", "inchworm", "catcow"], act: ["latWalk", "sidePlank"], hold: ["pnfHip", "rollDown"] },
    bike: { mov: ["cossack", "kneeWall", "wallAngel", "legSwing"], act: ["latWalk", "bridgeSingle"], hold: ["pnfHam", "rollDown"] },
    swim: { mov: ["scorpion", "spiderman", "kneeWall", "wgs"], act: ["bearCrawl", "sidePlank"], hold: ["frog", "rollDown"] },
    tri:  { mov: ["inchworm", "cossack", "kneeWall", "wallAngel"], act: ["gluteBridgeMarch", "sidePlank"], hold: ["pnfHam", "rollDown"] },
    all:  { mov: ["cossack", "inchworm", "openBook", "legSwing"], act: ["reverseLunge", "bearCrawl"], hold: ["pnfHip", "rollDown"] }
  };

  const DEEP = {
    run:  { mov: ["sunFlow", "carsShoulder"], act: ["gluteBridgeMarch", "tva"], hold: ["dragon", "bodyScan"] },
    bike: { mov: ["sunFlow", "carsAnkle"], act: ["gluteBridgeMarch", "deadBug"], hold: ["dragon", "bodyScan"] },
    swim: { mov: ["sunFlow", "carsAnkle"], act: ["birdDog", "balance"], hold: ["pnfHam", "bodyScan"] },
    tri:  { mov: ["warriorFlow", "carsAnkle"], act: ["bearCrawl", "tva"], hold: ["dragon", "bodyScan"] },
    all:  { mov: ["sunFlow", "threadNeedle"], act: ["scapPushup", "tva"], hold: ["dragon", "bodyScan"] }
  };

  /* The block names ARE the honesty requirement from decision 4. Do not rename
     "Ativação" to something softer: the athlete is entitled to know that this
     part of a recovery session is strength and control work. */
  const PHASE = { mov: "Mobilidade", act: "Ativação", hold: "Posturas longas" };

  const SPORT = {
    run:  "Recuperação para corredores",
    bike: "Recuperação para ciclistas",
    swim: "Recuperação para nadadores",
    tri:  "Recuperação para triatletas",
    all:  "Recuperação de corpo inteiro"
  };

  const SUBTITLE = {
    run:  "Quadril, tornozelo e cadeia posterior, com controle lento e posturas longas. É uma sessão leve, não um dia de folga.",
    bike: "Rotação torácica, independência de quadril e o glúteo que a bike desliga. É uma sessão leve, não um dia de folga.",
    swim: "Controle escapular, torácica e pescoço — e o tornozelo, que na água empurra. É uma sessão leve, não um dia de folga.",
    tri:  "As três cadeias conectadas, mais equilíbrio e propriocepção. É uma sessão leve, não um dia de folga.",
    all:  "Uma passagem completa de cima a baixo, sem esporte definido. É uma sessão leve, não um dia de folga."
  };

  const WHY = {
    run:  "Um dia sem correr é quando o tecido aceita trabalho que recusaria cansado: amplitude controlada, posturas passivas longas e contração-soltura. Nada disso cabe nos dez minutos antes de uma sessão, e é exatamente o que falta a um corredor que só corre.",
    bike: "A bike deixa três dívidas que não se pagam pedalando: torácica que não gira, quadril que só trabalha num plano e glúteo que desligou. Um dia livre é quando dá para atacá-las de verdade, porque há tempo para o lento e para o longo.",
    swim: "O ombro do nadador não se resolve alongando: resolve-se com controle escapular e amplitude que você consiga sustentar. Isso é trabalho lento e repetido, e precisa de um dia em que você não tenha que entrar na água depois.",
    tri:  "Três esportes deixam três padrões e nenhum se corrige com pressa. Este é o dia para o que não cabe numa ativação: CARs longos, posturas passivas, contração-soltura e equilíbrio, que é a primeira coisa que o volume tira.",
    all:  "Um dia de recuperação bem usado faz mais pela sua amplitude do que três ativações apressadas. Aqui há tempo para o lento, o longo e o chato, que é onde está quase todo o benefício."
  };

  const DONE = {
    run:  "Pronto. Isso foi uma sessão, não um descanso — leve isso em conta amanhã.",
    bike: "Pronto. Isso foi uma sessão, não um descanso — leve isso em conta amanhã.",
    swim: "Pronto. Isso foi uma sessão, não um descanso — leve isso em conta amanhã.",
    tri:  "Pronto. Isso foi uma sessão, não um descanso — leve isso em conta amanhã.",
    all:  "Pronto. Isso foi uma sessão, não um descanso — leve isso em conta amanhã."
  };

  /* Same sport-aware hand-off as /members/pt/mobilidade/, same reason:
     methodology.md §11 in the product. Mobility and recovery are not rehab. */
  const PAIN = {
    run:  'Se algo <strong>dói</strong> em vez de estar duro, esta não é a ferramenta de hoje: passe por <a href="/members/pt/joelhos/">Joelhos</a> ou <a href="/members/pt/aquiles/">Aquiles</a>. E se a dor continuar, é consulta médica, não uma rotina.',
    bike: 'Se algo <strong>dói</strong> em vez de estar duro, esta não é a ferramenta de hoje: passe por <a href="/members/pt/joelhos/">Joelhos</a>. E se a dor continuar, é consulta médica, não uma rotina.',
    swim: 'Se o ombro <strong>dói</strong> em vez de estar duro, esta não é a ferramenta de hoje: passe por <a href="/members/pt/ombro/">Ombro de Nadador</a>. E se a dor continuar, é consulta médica, não uma rotina.',
    tri:  'Se algo <strong>dói</strong> em vez de estar duro, esta não é a ferramenta de hoje: passe por <a href="/members/pt/joelhos/">Joelhos</a>, <a href="/members/pt/aquiles/">Aquiles</a> ou <a href="/members/pt/ombro/">Ombro</a>. E se a dor continuar, é consulta médica, não uma rotina.',
    all:  'Se algo <strong>dói</strong> em vez de estar duro, esta não é a ferramenta de hoje: passe por <a href="/members/pt/joelhos/">Joelhos</a>, <a href="/members/pt/aquiles/">Aquiles</a> ou <a href="/members/pt/ombro/">Ombro</a>. E se a dor continuar, é consulta médica, não uma rotina.'
  };

  const SPORT_HINT = {
    run: "", bike: "", swim: "",
    tri:  "Para quem faz os três: prioriza quadril e ombro, e soma equilíbrio.",
    all:  "Sem esporte definido. Serve igual para um dia de academia ou de escritório."
  };

  /* Chrome the shared engine would otherwise render as "activación". See
     ai-infrastructure-documentation.md §39 and §40 — three strings, three
     different landing places, and `doneTitle` is markup rather than an engine
     string. *** THESE TRAVEL WITH ANY TRANSLATION OF THIS PAGE. *** */
  const UI_OVERRIDE = { startRoutine: "Começar a sessão →" };
  const DONE_TITLE = "Sessão completa";

  function build(sport, mins) {
    const m = String(mins);
    if (!BASE[sport]) throw new Error("Unknown sport: " + sport);
    if (["30", "45", "60"].indexOf(m) === -1) throw new Error("Unknown duration: " + m);

    const pick = ids => ids.map(id => {
      const ex = L[id];
      if (!ex) throw new Error("Unknown exercise id: " + id);
      return Object.assign({ video: null, variants: [] }, ex);
    });

    const merge = block => {
      let ids = BASE[sport][block].slice();
      if (m === "45" || m === "60") ids = ids.concat(EXT[sport][block]);
      if (m === "60") ids = ids.concat(DEEP[sport][block]);
      return ids;
    };

    return {
      title: SPORT[sport],
      crumb: "Recuperação",
      subtitle: SUBTITLE[sport],
      context: m + " minutos",
      why: WHY[sport],
      doneSub: DONE[sport],
      kicker: "Recuperação ativa",
      restSeconds: 10,
      phases: ["mov", "act", "hold"].map(b => ({ name: PHASE[b], exercises: pick(merge(b)) }))
    };
  }

  return { build: build, library: L, base: BASE, ext: EXT, deep: DEEP,
           phase: PHASE, pain: PAIN, sportHint: SPORT_HINT, ui: UI_OVERRIDE,
           doneTitle: DONE_TITLE };
})();

/* --------------------------------------------------------------- SETUP UI
   Same two-question shape as /members/pt/mobilidade/. What is sport-aware here is
   the pain hand-off; the load warning and the "are you training today?" aside
   are constant, because they are true for every sport. */
(function () {
  const M = window.RECOVERY_MATRIX;
  const choice = { sport: "run", mins: "30" };

  function renderSportBits() {
    const hint = document.getElementById("sportHint");
    hint.innerHTML = M.sportHint[choice.sport] || "";
    hint.hidden = !M.sportHint[choice.sport];
    document.getElementById("painAside").innerHTML = M.pain[choice.sport];
  }

  document.querySelectorAll(".setup-opts[data-axis]").forEach(group => {
    const axis = group.dataset.axis;
    group.querySelectorAll(".setup-opt").forEach(btn => {
      btn.addEventListener("click", () => {
        choice[axis] = btn.dataset.val;
        group.querySelectorAll(".setup-opt").forEach(b =>
          b.setAttribute("aria-pressed", String(b === btn)));
        if (axis === "sport") renderSportBits();
      });
    });
  });

  renderSportBits();

  document.getElementById("setupGo").addEventListener("click", () => {
    window.ACTIVATION_DATA = M.build(choice.sport, choice.mins);
    Object.assign(window.ACTIVATION_UI, M.ui);

    document.getElementById("setup").hidden = true;
    document.getElementById("toolWrap").hidden = false;

    document.getElementById("doneSub").textContent = window.ACTIVATION_DATA.doneSub;
    document.getElementById("crumbLabel").textContent = window.ACTIVATION_DATA.crumb;
    document.getElementById("doneTitle").textContent = M.doneTitle;

    const s = document.createElement("script");
    // Fingerprinted engine URL, published by the partial as TP_ENGINE_SRC.
    // A literal path here would be unfingerprinted and therefore pinned in
    // the visitor's browser for a year by Caddy's immutable header on
    // /assets/js/* — the September 8, 2026 defect. Do not inline it back.
    s.src = window.TP_ENGINE_SRC;
    document.body.appendChild(s);

    s.addEventListener("load", () => {
      const back = document.createElement("button");
      back.className = "change-link setup-back";
      back.textContent = "← Trocar opções";
      back.addEventListener("click", () => location.reload());
      document.querySelector(".tool").prepend(back);
    });
  });
})();
</script>
