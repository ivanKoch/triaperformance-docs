---
layout: layouts/base.njk
navVariant: "none"
footerVariant: "none"
pageCss: "members-forgot-password.css"
title: "Recuperar senha — Triaperformance"
---
{#- See the note in site/members/forgot-password/index.njk: same endpoint, and
    the `lang` field is sent but not yet read by the n8n workflow. -#}
<div class="card">
  <h1>Recuperar senha</h1>
  <p class="sub" id="sub">Informe o email com o qual você assinou o All-Access. Se estiver registrado, enviamos sua senha.</p>

  <form id="forgot-form">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required autocomplete="email">
    <button type="submit" id="submit-btn">Enviar</button>
  </form>

  <p class="result" id="result"></p>

  <p class="help"><a href="/members/pt/login">Voltar ao login</a></p>

  <p class="auth-lang">
    <a href="/members/forgot-password">Español</a><span class="sep">·</span><a href="/members/en/forgot-password">English</a><span class="sep">·</span><a href="/members/pt/forgot-password" class="current">Português</a>
  </p>
</div>

<script>
  var form = document.getElementById('forgot-form');
  var sub = document.getElementById('sub');
  var result = document.getElementById('result');
  var submitBtn = document.getElementById('submit-btn');

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';

    fetch('/members/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: document.getElementById('email').value.trim(), lang: 'pt' })
    })
      .then(function () {
        result.textContent = 'Se o email estiver registrado, enviamos sua senha. Confira sua caixa de entrada.';
        result.classList.add('show');
        form.style.display = 'none';
        sub.style.display = 'none';
      })
      .catch(function () {
        result.textContent = 'Algo deu errado. Escreva para coach@triaperformance.com.';
        result.classList.add('show');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar';
      });
  });
</script>
