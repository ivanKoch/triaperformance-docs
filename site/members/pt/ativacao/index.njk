            opts: [{ v: "none", t: "Não" }, { v: "band", t: "Sim" }] },
    bike: { label: "Você tem miniband?", hint: "",
            opts: [{ v: "none", t: "Não" }, { v: "band", t: "Sim" }] },
    swim: { label: "O que você tem à mão?",
            hint: "Em um clube costuma haver elástico e algum cabo na área de material. Em um hotel, quase nunca — e sem nada a rotina fica completa do mesmo jeito.",
            opts: [{ v: "none", t: "Nada" }, { v: "band", t: "Elástico longo" }, { v: "stick", t: "Elástico e cabo" }] }
  };

  const WHY = {
    bike: "Pedalar com o quadril fechado e os glúteos desligados manda o trabalho para o quadríceps e para a lombar. A posição da bike já encurta o psoas; começar sem abri-lo é começar com a potência mal distribuída.",
    run: "Correr com os glúteos dormindo e o quadril rígido joga o trabalho na lombar, nos posteriores e nas panturrilhas. Dez minutos de ativação melhoram a técnica desde o primeiro quilômetro e reduzem o risco de incômodos.",
    swim: "Uma boa ativação em seco faz três coisas antes de você tocar a água: solta a parte alta das costas, que é de onde saem a rotação e a respiração; acorda as escápulas e o manguito rotador, que é o que protege o ombro em cada recuperação; e liga o core na posição de flecha, que é o que mantém o quadril alto. Entrar frio e curvado depois de oito horas de escritório é como começam a maioria dos ombros de nadador."
  };
  const CONTEXT = {
    "wake": "Acabei de acordar",
    "sit": "Depois de ficar sentado"
  };
  const SUBTITLE = {
    bike: "Do chão até de pé, sem voltar a descer. 40 segundos por exercício; os unilaterais, 40 por lado.",
    run: "Do chão até de pé, sem voltar a descer. 40 segundos por exercício; os unilaterais, 40 por lado.",
    swim: "Na borda da piscina, antes de entrar. Você aquece de pé, desce ao chão e termina no gesto da braçada."
  };
  const DONE = {
    run: "Pronto para correr.",
    bike: "Pronto para subir na bike.",
    swim: "Pronto para entrar na água."
  };
  /* The equipment suffix on the context pill, per sport — "mini-band" is
     meaningless for a swimmer holding a broomstick. */
  const EQUIP_LABEL = {
    run:  { none: "", band: " · com miniband" },
    bike: { none: "", band: " · com miniband" },
    swim: { none: "", band: " · com elástico", stick: " · com elástico e cabo" }
  };
  const SPORT = { bike: "Ativação para o ciclismo", run: "Ativação para a corrida", swim: "Ativação em seco" };

  function build(sport, moment, band) {
    const key = sport + "|" + moment + "|" + band;
    const r = R[key];
    if (!r) throw new Error("Unknown routine: " + key);
    const pick = ids => ids.map(id => {
      const ex = L[id];
      if (!ex) throw new Error("Unknown exercise id: " + id);
      return Object.assign({ video: null, variants: [] }, ex);
    });
    return {
      title: SPORT[sport],
      crumb: "Ativação",
      subtitle: SUBTITLE[sport],
      context: CONTEXT[moment] + (EQUIP_LABEL[sport][band] || ""),
      why: WHY[sport],
      doneSub: DONE[sport],
      phases: r.phases.map(ph => ({ name: ph.name, exercises: pick(ph.ids) }))
    };
  }

  return { build: build, library: L, routines: R, equip: EQUIP };
})();

/* --------------------------------------------------------------- SETUP UI */
(function () {
  const choice = { sport: "run", moment: "wake", band: "none" };
  const EQUIP = window.ACTIVATION_MATRIX.equip;

  /* The equipment question is rebuilt whenever the sport changes, because the
     question itself differs by sport. Rebuilding also resets the answer, which
     matters: "swim|wake|band" exists but "run|wake|stick" does not, so a stale
     answer carried across a sport switch would throw. */
  function renderEquip() {
    const cfg = EQUIP[choice.sport];
    const opts = document.getElementById("equipOpts");
    document.getElementById("equipLabel").textContent = cfg.label;
    const hint = document.getElementById("equipHint");
    hint.textContent = cfg.hint || "";
    hint.hidden = !cfg.hint;

    if (!cfg.opts.some(o => o.v === choice.band)) choice.band = cfg.opts[0].v;

    opts.innerHTML = "";
    cfg.opts.forEach(o => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "setup-opt";
      b.dataset.val = o.v;
      b.textContent = o.t;
      b.setAttribute("aria-pressed", String(o.v === choice.band));
      b.addEventListener("click", () => {
        choice.band = o.v;
        opts.querySelectorAll(".setup-opt").forEach(x =>
          x.setAttribute("aria-pressed", String(x === b)));
      });
      opts.appendChild(b);
    });
  }

  function renderSportBits() {
    // Swimming is the only sport where "it already hurts" has a tool to go to.
    document.getElementById("shoulderAside").hidden = choice.sport !== "swim";
    document.getElementById("momentHint").textContent = choice.sport === "swim"
      ? "Recém-acordado você está rígido e frio. Depois de oito horas sentado você está curvado: ombros à frente, peito fechado e pescoço duro — que é justamente a postura que faz o ombro fisgar ao nadar."
      : "Recém-acordado, o corpo está rígido mas neutro. Depois de oito horas sentado, o quadril está encurtado e os glúteos desligados — não se resolve com a mesma rotina.";
  }

  document.querySelectorAll(".setup-opts[data-axis='sport'], .setup-opts[data-axis='moment']").forEach(group => {
    const axis = group.dataset.axis;
    group.querySelectorAll(".setup-opt").forEach(btn => {
      btn.addEventListener("click", () => {
        choice[axis] = btn.dataset.val;
        group.querySelectorAll(".setup-opt").forEach(b =>
          b.setAttribute("aria-pressed", String(b === btn)));
        if (axis === "sport") { renderEquip(); renderSportBits(); }
      });
    });
  });

  renderEquip();
  renderSportBits();

  document.getElementById("setupGo").addEventListener("click", () => {
    window.ACTIVATION_DATA = window.ACTIVATION_MATRIX.build(choice.sport, choice.moment, choice.band);

    document.getElementById("setup").hidden = true;
    document.getElementById("toolWrap").hidden = false;

    // Labels the partial normally writes at parse time — done here instead,
    // because at parse time there was no routine yet.
    document.getElementById("doneSub").textContent = window.ACTIVATION_DATA.doneSub;
    document.getElementById("crumbLabel").textContent = window.ACTIVATION_DATA.crumb;

    // Boot the shared engine. Injected rather than loaded in the page, so the
    // engine itself needs no matrix-awareness at all: by the time it runs,
    // window.ACTIVATION_DATA looks exactly like any other activation tool's.
    const s = document.createElement("script");
    // Fingerprinted engine URL, published by the partial as TP_ENGINE_SRC.
    // A literal path here would be unfingerprinted and therefore pinned in
    // the visitor's browser for a year by Caddy's immutable header on
    // /assets/js/* — the September 8, 2026 defect. Do not inline it back.
    s.src = window.TP_ENGINE_SRC;
    document.body.appendChild(s);

    // One way back. Reloads rather than re-initialising: the engine holds timer
    // state in closure and has no teardown, and a stale interval running under
    // a second routine is a worse bug than a page load.
    s.addEventListener("load", () => {
      const back = document.createElement("button");
      back.className = "change-link setup-back";
      back.textContent = "← Trocar opções";
      back.addEventListener("click", () => location.reload());
      document.querySelector(".tool").prepend(back);
    });
  });
})();
</script>
