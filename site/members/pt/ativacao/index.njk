    floss: { name: "Deslizamento neural", mode: "uni", tag: "Sem equipamento", secs: 30,
      cue: "De barriga para cima, joelho ao peito. Estenda a perna ao teto levando a ponta do pé na sua direção; solte e repita, devagar. Não é alongamento: você quer o nervo deslizar. Se puxar forte, diminua a amplitude." },
    fig4: { name: "Figura 4 deitado", mode: "uni", tag: "Sem equipamento", secs: 45,
      cue: "Deitado de barriga para cima, cruze um tornozelo sobre o joelho contrário e puxe a coxa de baixo em direção ao peito. Empurre de leve o joelho cruzado para fora com o cotovelo. <strong>Comece pelo lado que está mais rígido.</strong> Respire longo e não force a amplitude." },
    bridge: { name: "Ponte de glúteos", mode: "bi", tag: "Sem equipamento",
      cue: "Pés perto dos glúteos. Suba o quadril empurrando pelos calcanhares e <strong>segure dois segundos no alto apertando os glúteos</strong>. A pausa é o exercício; sem ela são só repetições. Desça controlado, sem arquear a lombar. Se sentir nos posteriores, aproxime os pés." },
    bridgeBand: { name: "Ponte de glúteos com faixa", mode: "bi", tag: "Miniband",
      cue: "Pés perto dos glúteos, faixa acima dos joelhos. Suba empurrando pelos calcanhares e abra os joelhos contra a faixa o tempo todo. Segure um segundo no alto. Se os joelhos se juntarem, o glúteo médio apagou." },
    deadbug: { name: "Dead bug", mode: "alt", tag: "Sem equipamento",
      cue: "Deitado de barriga para cima, braços para o teto e joelhos a 90°. Estenda o braço e a perna opostos, devagar, sem deixar a lombar sair do chão. <strong>Expire ao estender: é a expiração que cola as costas no chão, não a força do abdômen.</strong> Se a lombar levantar, desça menos a perna. O objetivo é controle, não velocidade." },
    deadbugBand: { name: "Dead bug com faixa", mode: "alt", tag: "Miniband",
      cue: "De barriga para cima, faixa acima dos joelhos, pressão para fora constante. Estenda braço e perna opostos sem deixar a faixa ganhar e sem descolar a lombar. Expire ao estender." },
    catcow: { name: "Gato-vaca", mode: "bi", tag: "Sem equipamento",
