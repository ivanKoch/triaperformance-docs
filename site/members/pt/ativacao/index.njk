    ankleBand: { name: "Círculos de tornozelo + panturrilha com miniband", mode: "bi", tag: "Miniband",
      cue: "Círculos primeiro, depois elevações com a miniband nos tornozelos resistindo a subida. Descida lenta e completa." },

    /* ---------------------------------------------------------- NATAÇÃO
       Added Sept 3, 2026. Shares only catcow and child with run/bike — the
       overlap really is that small, and that is fine: this sport's problem is
       thoracic, scapular and core, not hip. Times replace the source doc's rep
       counts because this engine is timed and the whole matrix is. */

    /* -- aquecimento: vai PRIMEIRO, ao contrário do documento original -- */
    armCircles: { name: "Círculos de braços completos", mode: "bi", tag: "Sem equipamento",
