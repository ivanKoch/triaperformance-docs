    kneeChest: { name: "Joelho ao peito", mode: "uni", tag: "Sem equipamento", secs: 30,
      cue: "De barriga para cima, traga um joelho ao peito com a outra perna estendida no chão. Se a perna de baixo descolar, solte a amplitude. Não puxe o pescoço." },
    twist: { name: "Torção da coluna", mode: "uni", tag: "Sem equipamento", secs: 45,
      cue: "Deitado, joelho cruzado para o lado oposto, braços abertos, olhar para o lado contrário. <strong>O ombro não descola do chão</strong>: se descolar, desça o joelho. Solte um pouco mais a cada expiração." },
    hamSupine: { name: "Posteriores de barriga para cima", mode: "uni", tag: "Sem equipamento", secs: 45,
