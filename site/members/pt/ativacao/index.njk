      { name: "Chão", ids: ["floss","fig4","bridgeBand","deadbugBand","hamSupine"] },
      { name: "Ajoelhado", ids: ["catcow","hipflex","wgs"] },
      { name: "Em pé", ids: ["swingFB","swingLat","aSkip","march","ankleBand"] }] },
    "run|sit|none": { phases: [
      { name: "Chão", ids: ["kneeChest","fig4","bridge","twist","deadbug"] },
