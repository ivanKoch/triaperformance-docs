    aSkip: { name: "Skip A lento", mode: "alt", tag: "Sem equipamento",
      cue: "Joelho na altura do quadril, pé de apoio firme, braços de corrida. Postura alta e contato curto. É técnica, não cardio: se desmontar, diminua o ritmo." },
    march: { name: "Marcha com joelho alto", mode: "alt", tag: "Sem equipamento",
      cue: "Marcha no lugar, joelho alto, pé de apoio ativo, tronco ereto. Não jogue o tronco para trás para levantar mais: essa é a trapaça." },
    marchBand: { name: "Marcha com joelho alto e faixa", mode: "alt", tag: "Miniband",
      cue: "Faixa nos tornozelos. Marcha com joelho alto, tronco ereto. Devagar na descida: a faixa quer devolver o pé ao chão e é aí que se perde o controle." },
    ankle: { name: "Círculos de tornozelo + elevação", mode: "bi", tag: "Sem equipamento",
