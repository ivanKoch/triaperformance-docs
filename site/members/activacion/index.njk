<script>
window.ACTIVATION_MATRIX = (function () {

  /* ---------------------------------------------------------------- LIBRARY
     One definition per exercise. A cue written once here cannot disagree with
     itself across the eight routines that share it. `secs` overrides the 40s
     default where a hold needs longer to be a stretch rather than a gesture. */
  const L = {
    floss: { name: "Deslizamiento neural", mode: "uni", tag: "Sin equipo", secs: 30,
      cue: "Boca arriba, rodilla al pecho. Extiende la pierna hacia el techo mientras llevas la punta del pie hacia ti; suelta y repite, lento. No es un estiramiento: buscas que el nervio deslice. Si tira fuerte, achica el rango." },
    fig4: { name: "Figura 4 boca arriba", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Boca arriba, cruza un tobillo sobre la rodilla contraria y trae el muslo de abajo hacia el pecho. Empuja suave la rodilla cruzada hacia afuera con el codo. <strong>Empieza por el lado que sientes más rígido.</strong> Respira largo y no fuerces el rango." },
    bridge: { name: "Puente de glúteos", mode: "bi", tag: "Sin equipo",
      cue: "Pies cerca de los glúteos. Sube la cadera empujando con los talones y <strong>sostén dos segundos arriba apretando los glúteos</strong>. La pausa es el ejercicio; sin ella son solo repeticiones. Baja controlado, sin arquear la lumbar. Si lo sientes en los isquios, acerca los pies." },
    bridgeBand: { name: "Puente de glúteos con banda", mode: "bi", tag: "Minibanda",
      cue: "Pies cerca de los glúteos, banda por encima de las rodillas. Sube empujando con los talones y abre las rodillas contra la banda todo el tiempo. Sostén un segundo arriba. Si las rodillas se juntan, el glúteo medio se apagó." },
    deadbug: { name: "Dead bug", mode: "alt", tag: "Sin equipo",
      cue: "Boca arriba, brazos al techo y rodillas a 90°. Extiende brazo y pierna contrarios, lentos, sin que la lumbar se despegue del piso. <strong>Exhala al extender: es la exhalación la que aplana la espalda, no la fuerza abdominal.</strong> Si la lumbar se levanta, baja menos la pierna. El objetivo es control, no velocidad." },
    deadbugBand: { name: "Dead bug con banda", mode: "alt", tag: "Minibanda",
      cue: "Boca arriba, banda por encima de las rodillas, presión hacia afuera constante. Extiende brazo y pierna contrarios sin que la banda gane y sin despegar la lumbar. Exhala al extender." },
    catcow: { name: "Gato-camello", mode: "bi", tag: "Sin equipo",
      cue: "En cuadrupedia, alterna redondear y arquear la columna al ritmo de la respiración. <strong>Muévete desde la pelvis y deja que la columna la siga vértebra por vértebra</strong> — no en bloque, y no solo cuello y hombros. Esto es control pélvico y articular, no un estiramiento. Rango cómodo, no máximo." },
    kneeChest: { name: "Rodilla al pecho", mode: "uni", tag: "Sin equipo", secs: 30,
      cue: "Boca arriba, trae una rodilla al pecho con la otra pierna extendida en el piso. Si la pierna de abajo se despega, afloja el rango. No tires del cuello." },
    twist: { name: "Torsión espinal", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Acostado, rodilla cruzada al lado opuesto, brazos abiertos, mirada al lado contrario. <strong>El hombro no se despega del piso</strong>: si se despega, baja la rodilla. Suelta un poco más en cada exhalación." },
    hamSupine: { name: "Isquios boca arriba", mode: "uni", tag: "Sin equipo", secs: 45,
      cue: "Boca arriba, sujeta el muslo por detrás de la rodilla. Desde ahí estira la rodilla hacia el techo hasta sentir el isquio, y no más. La otra pierna queda apoyada en el piso.",
      variants: [{ name: "Isquios con toalla", mode: "uni", tag: "Toalla o cinta", secs: 45,
