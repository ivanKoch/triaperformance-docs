    "swim|sit|stick": { phases: [
      { name: "Entrada en calor", ids: ["armCircles","neckRot"] },
      { name: "Suelo",            ids: ["threadNeedle","childSwim","ytw","swimStreamline","ankleSwim"] },
      { name: "Antes de entrar",  ids: ["stickPass","pullApart","catchSim"] }] }
  };

  /* Equipment options per sport. A mini-band is the right question for run and
     bike and the wrong object for swimming, so the question itself changes —
     not just the answer. The setup script renders this. */
  const EQUIP = {
    run:  { label: "¿Tenés minibanda?", hint: "",
            opts: [{ v: "none", t: "No" }, { v: "band", t: "Sí" }] },
    bike: { label: "¿Tenés minibanda?", hint: "",
            opts: [{ v: "none", t: "No" }, { v: "band", t: "Sí" }] },
    swim: { label: "¿Qué tenés a mano?",
            hint: "En un club suele haber banda y algún palo en la zona de material. En un hotel, casi nunca — y sin nada la rutina igual queda completa.",
            opts: [{ v: "none", t: "Nada" }, { v: "band", t: "Banda larga" }, { v: "stick", t: "Banda y bastón" }] }
  };

  const WHY = {
    bike: "Pedalear con la cadera cerrada y los glúteos apagados manda el trabajo a los cuádriceps y a la lumbar. La posición de bici ya te acorta el psoas; empezar sin abrirlo es empezar con la potencia repartida mal.",
    run: "Correr con los glúteos dormidos y la cadera rígida carga el trabajo en la lumbar, los isquios y las pantorrillas. Diez minutos de activación mejoran la técnica desde el primer kilómetro y bajan el riesgo de molestias.",
    swim: "Una buena activación en seco hace tres cosas antes de que toques el agua: te suelta la espalda alta, que es de donde salen la rotación y la respiración; te despierta las escápulas y el manguito rotador, que es lo que protege el hombro en cada recobro; y te enciende el core en posición de flecha, que es lo que mantiene la cadera arriba. Entrar frío y encorvado después de ocho horas de escritorio es cómo empiezan la mayoría de los hombros de nadador."
  };
  const CONTEXT = {
    "wake": "Recién levantado",
    "sit": "Después de estar sentado"
  };
  const SPORT = {
    bike: "Activación de ciclismo",
    run: "Activación de running",
    swim: "Activación en seco"
  };
  const SUBTITLE = {
    bike: "Del suelo a estar de pie, sin volver a bajar. 40 segundos por ejercicio; los unilaterales, 40 por lado.",
    run: "Del suelo a estar de pie, sin volver a bajar. 40 segundos por ejercicio; los unilaterales, 40 por lado.",
    swim: "En el borde de la pileta, antes de entrar. Entrás en calor de pie, bajás al piso y terminás con el gesto de brazada."
  };
  const DONE = {
    run: "Listo para correr.",
    bike: "Listo para subirte a la bici.",
    swim: "Listo para entrar al agua."
  };
  /* The equipment suffix on the context pill, per sport — "con minibanda" is
     meaningless for a swimmer holding a broomstick. */
  const EQUIP_LABEL = {
    run:  { none: "", band: " · con minibanda" },
    bike: { none: "", band: " · con minibanda" },
    swim: { none: "", band: " · con banda", stick: " · con banda y bastón" }
  };

  function build(sport, moment, band) {
    const key = sport + "|" + moment + "|" + band;
    const r = R[key];
    if (!r) throw new Error("Unknown routine: " + key);
    const pick = ids => ids.map(id => {
      const ex = L[id];
      if (!ex) throw new Error("Unknown exercise id: " + id);
      return Object.assign({ video: null, variants: [] }, ex);
    });
    return {
      title: SPORT[sport],
      crumb: "Activación",
      subtitle: SUBTITLE[sport],
      context: CONTEXT[moment] + (EQUIP_LABEL[sport][band] || ""),
      why: WHY[sport],
      doneSub: DONE[sport],
      phases: r.phases.map(ph => ({ name: ph.name, exercises: pick(ph.ids) }))
    };
  }

  return { build: build, library: L, routines: R, equip: EQUIP };
})();

/* --------------------------------------------------------------- SETUP UI */
(function () {
  const choice = { sport: "run", moment: "wake", band: "none" };
  const EQUIP = window.ACTIVATION_MATRIX.equip;

  /* The equipment question is rebuilt whenever the sport changes, because the
     question itself differs by sport — three options for swimming, two for the
     others. Rebuilding also resets the answer to "none", which matters: an
     athlete who picked "Sí" for a mini-band and then switched to swimming must
     not silently keep a value that means something else, or no routine at all
     ("swim|wake|band" exists, but "run|wake|stick" does not). */
  function renderEquip() {
    const cfg = EQUIP[choice.sport];
    const opts = document.getElementById("equipOpts");
    document.getElementById("equipLabel").textContent = cfg.label;
    const hint = document.getElementById("equipHint");
    hint.textContent = cfg.hint || "";
    hint.hidden = !cfg.hint;

    if (!cfg.opts.some(o => o.v === choice.band)) choice.band = cfg.opts[0].v;

    opts.innerHTML = "";
    cfg.opts.forEach(o => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "setup-opt";
      b.dataset.val = o.v;
      b.textContent = o.t;
      b.setAttribute("aria-pressed", String(o.v === choice.band));
      b.addEventListener("click", () => {
        choice.band = o.v;
        opts.querySelectorAll(".setup-opt").forEach(x =>
          x.setAttribute("aria-pressed", String(x === b)));
      });
      opts.appendChild(b);
    });
  }

  function renderSportBits() {
    // Swimming is the only sport where "it already hurts" has a tool to go to.
    document.getElementById("shoulderAside").hidden = choice.sport !== "swim";
    document.getElementById("momentHint").textContent = choice.sport === "swim"
      ? "Recién levantado estás rígido y frío. Después de ocho horas sentado estás encorvado: hombros adelante, pecho cerrado y cuello duro — que es justo la postura que hace pinchar el hombro al nadar."
      : "Recién levantado, el cuerpo está rígido pero neutro. Después de ocho horas sentado, la cadera está acortada y los glúteos apagados — no se arregla con lo mismo.";
  }

  document.querySelectorAll(".setup-opts[data-axis='sport'], .setup-opts[data-axis='moment']").forEach(group => {
    const axis = group.dataset.axis;
    group.querySelectorAll(".setup-opt").forEach(btn => {
      btn.addEventListener("click", () => {
        choice[axis] = btn.dataset.val;
        group.querySelectorAll(".setup-opt").forEach(b =>
          b.setAttribute("aria-pressed", String(b === btn)));
        if (axis === "sport") { renderEquip(); renderSportBits(); }
      });
    });
  });

  renderEquip();
  renderSportBits();

  document.getElementById("setupGo").addEventListener("click", () => {
    window.ACTIVATION_DATA = window.ACTIVATION_MATRIX.build(choice.sport, choice.moment, choice.band);

    document.getElementById("setup").hidden = true;
    document.getElementById("toolWrap").hidden = false;

    // Labels the partial normally writes at parse time — done here instead,
    // because at parse time there was no routine yet.
    document.getElementById("doneSub").textContent = window.ACTIVATION_DATA.doneSub;
    document.getElementById("crumbLabel").textContent = window.ACTIVATION_DATA.crumb;

    // Boot the shared engine. Injected rather than loaded in the page, so the
    // engine itself needs no matrix-awareness at all: by the time it runs,
    // window.ACTIVATION_DATA looks exactly like any other activation tool's.
    const s = document.createElement("script");
    s.src = "/assets/js/activation-tool.js";
    document.body.appendChild(s);

    // One way back. Reloads rather than re-initialising: the engine holds timer
    // state in closure and has no teardown, and a stale interval running under
    // a second routine is a worse bug than a page load.
    s.addEventListener("load", () => {
      const back = document.createElement("button");
      back.className = "change-link setup-back";
      back.textContent = "← Cambiar opciones";
      back.addEventListener("click", () => location.reload());
      document.querySelector(".tool").prepend(back);
    });
  });
})();
</script>
