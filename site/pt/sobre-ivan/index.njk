{%- set cr = credentials.pt -%}

{%- if aboutPhotos.hero %}
<figure class="about-figure-hero">
  <img src="{{ ("/assets/images/about/" + aboutPhotos.hero.file) | v }}" alt="{{ aboutPhotos.hero.alt.pt or aboutPhotos.hero.alt.es }}"
