---
layout: layouts/base.njk
lang: pt
transKey: blog-index
pageCss: blog.css
title: "Blog de treinamento — corrida, ciclismo e triatlo"
description: "Treino de corrida e triatlo baseado em dados: como escolher um plano, como testar, e o que fazer com os números."
---
{%- set t = i18n[lang] -%}
{%- set posts = collections.posts | byLang(lang) -%}
<section class="blog-hero">
  <div class="wrap">
    <span class="label">{{ t.blogTitle }}</span>
    <h1>{{ t.blogTitle }}</h1>
    <p class="standfirst">{{ t.blogIntro }}</p>
    {% include "partials/topic-pills.njk" %}
  </div>
</section>

<div class="wrap">
  <section class="post-grid" data-post-grid>
    {%- for post in posts %}
      {#- The newest article leads. Set here rather than in CSS (:first-child)
          because after filtering a different card leads, and blog-filter.js
          moves the class — CSS can't know which cards are hidden. -#}
      {%- set featured = loop.first -%}
      {% include "partials/post-card.njk" %}
    {%- else %}
    <p class="post-grid__empty">Ainda não há artigos publicados.</p>
    {%- endfor %}
  </section>
</div>
