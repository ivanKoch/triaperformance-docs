{# Site navigation.

   Variants, selected by the page's `navVariant` front matter:
     "public"       (default) — sticky nav + language switcher. Marketing pages.
     "members-home"           — members landing: Biblioteca / FAQ + logout button.
     "members-page"           — members content pages: back to the members area.
                                Set `noPrint: true` to add the no-print classes
                                (the testing-protocols page is meant to be printed).
     "none"                   — login, forgot-password, and kettlebell, which
                                either have no nav or carry their own inline.

   Menu contents come from site/_data/nav.json. Editing the nav is one edit
   there rather than 19 edits across the site. #}

{# Members nav menus are keyed by language as of Aug 10, 2026 — resolve off the
   page's own `lang`, falling back to ES so a page that somehow has no lang set
   renders the Spanish menu rather than crashing the build. #}
{%- set mHome = nav.membersHome[lang] or nav.membersHome.es -%}
{%- set mPage = nav.membersPage[lang] or nav.membersPage.es -%}

{% if navVariant == "members-home" %}
<nav class="site-nav">
  <div class="wrap">
    <a href="{{ mHome.home }}" class="logo">{{ site.name }}</a>
    <button class="nav-toggle" id="navToggle" aria-label="{{ mHome.menuLabel }}" onclick="toggleNav()"><span></span><span></span><span></span></button>
    <nav id="siteNav">
      {%- for item in mHome.items %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {%- endfor %}
      {#- `lang` is posted so the auth service knows which language's login page
          to drop the person back on after logging out. Without it, an EN
          subscriber logs out and lands on the Spanish login screen. -#}
      <form method="POST" action="/members/logout" style="display:inline; margin:0;">
        <input type="hidden" name="lang" value="{{ lang }}">
        <button type="submit" class="nav-cta">{{ mHome.logoutLabel }}</button>
      </form>
    </nav>
  </div>
</nav>
<div class="nav-overlay" id="navOverlay" onclick="closeNav()"></div>

{% elif navVariant == "members-page" %}
<div class="site-nav-sticky{% if noPrint %} no-print{% endif %}">
<div class="wrap">
  <header>
    <a href="{{ mPage.home }}" class="logo">{{ site.name }}</a>
    <button class="nav-toggle" id="navToggle" aria-label="{{ mPage.menuLabel }}" onclick="toggleNav()"><span></span><span></span><span></span></button>
    <nav id="siteNav">
      {%- for item in mPage.items %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </header>
</div>
</div>
<div class="nav-overlay{% if noPrint %} no-print{% endif %}" id="navOverlay" onclick="closeNav()"></div>

{% elif navVariant != "none" %}
{%- set menu = nav[lang] -%}
<div class="site-nav-sticky">

{#- Utility strip (Aug 10, 2026). Language switcher + members access live here,
    not in the main row. The single-row nav had run out of width and pushed the
    language switcher onto a second line; the real problem was that content
    items and utility items were competing for the same 1080px. Hidden below
    860px — on mobile both items move into the hamburger drawer, where a second
    bar would only cost vertical space. -#}
<div class="nav-utility">
  <div class="wrap">
    <span class="lang-switch">
      {%- set alts = collections.translations[transKey] -%}
      {%- for code in site.langOrder -%}
      {%- if not loop.first %}<span class="sep">·</span>{% endif -%}
      {%- set target = alts[code] if alts and alts[code] else site.languages[code].home -%}
      <a href="{{ target }}"{% if code == lang %} class="lang-active"{% endif %}>{{ site.languages[code].label }}</a>
      {%- endfor -%}
    </span>
    {%- if menu.utility %}
    <a href="{{ menu.utility.url }}" class="nav-member"><svg class="nav-member-lock" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="10.5" width="16" height="10.5" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>{{ menu.utility.label }}</a>
    {%- endif %}
  </div>
</div>

<div class="wrap">
  <header>
    <a href="{{ site.languages[lang].home }}" class="logo">{{ site.name }}</a>
    <button class="nav-toggle" id="navToggle" aria-label="{{ menu.menuLabel }}" onclick="toggleNav()"><span></span><span></span><span></span></button>
    <nav id="siteNav">
      {%- for item in menu.items %}
      {%- if item.children %}
      <div class="nav-dropdown">
        {#- `menuOnly` renders the parent as a plain label rather than a link.
            "Recursos" groups the blog and the calculators but has no page of its
            own, and a dropdown parent that links nowhere real is worse than one
            that doesn't pretend to. A /recursos/ hub would be the proper fix —
            see the note in nav.json. -#}
        {%- if item.menuOnly %}
        <span class="nav-dropdown-label" tabindex="0" role="button" aria-haspopup="true">{{ item.label }}</span>
        {%- else %}
        <a href="{{ item.url }}">{{ item.label }}</a>
        {%- endif %}
        <div class="nav-dropdown-menu">
          {%- for child in item.children %}
          <a href="{{ child.url }}">{{ child.label }}</a>
          {%- endfor %}
        </div>
      </div>
      {%- elif item.cta %}
      <a href="{{ item.url }}" class="nav-cta">{{ item.label }}</a>
      {%- else %}
      {#- Highlight the nav item for the page you're on. Dropdown parents are
          excluded above, matching how the hand-written pages behaved. -#}
      <a href="{{ item.url }}"{% if item.url == page.url %} class="lang-active"{% endif %}>{{ item.label }}</a>
      {%- endif %}
      {%- endfor %}

      {#- Mobile only. The utility strip above is hidden below 860px, so its two
          items are repeated inside the drawer — otherwise a phone loses both the
          language switcher and the members link entirely. -#}
      <div class="nav-drawer-utility">
        {%- if menu.utility %}
        <a href="{{ menu.utility.url }}" class="nav-member"><svg class="nav-member-lock" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="10.5" width="16" height="10.5" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>{{ menu.utility.label }}</a>
        {%- endif %}
        <span class="lang-switch">
          {%- set alts = collections.translations[transKey] -%}
          {%- for code in site.langOrder -%}
          {%- if not loop.first %}<span class="sep">·</span>{% endif -%}
          {%- set target = alts[code] if alts and alts[code] else site.languages[code].home -%}
          <a href="{{ target }}"{% if code == lang %} class="lang-active"{% endif %}>{{ site.languages[code].label }}</a>
          {%- endfor -%}
        </span>
      </div>
    </nav>
  </header>
</div>
</div>
<div class="nav-overlay" id="navOverlay" onclick="closeNav()"></div>
{% endif %}

{% if navVariant != "none" %}
<script>
  function toggleNav() {
    document.getElementById('siteNav').classList.toggle('mobile-open');
    document.getElementById('navToggle').classList.toggle('open');
    document.getElementById('navOverlay').classList.toggle('show');
  }
  function closeNav() {
    document.getElementById('siteNav').classList.remove('mobile-open');
    document.getElementById('navToggle').classList.remove('open');
    document.getElementById('navOverlay').classList.remove('show');
  }
  document.querySelectorAll('#siteNav a').forEach(function (a) {
    a.addEventListener('click', function () { if (window.innerWidth <= 860) closeNav(); });
  });
</script>
{% endif %}
