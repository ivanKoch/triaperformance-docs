{# Site navigation.

   Variants, selected by the page's `navVariant` front matter:
     "public"       (default) — sticky nav + language switcher. Marketing pages.
     "members-home"           — members landing: Biblioteca / FAQ + logout button.
     "members-page"           — members content pages: back to the members area.
                                Set `noPrint: true` to add the no-print classes
                                (the testing-protocols page is meant to be printed).
     "none"                   — login, forgot-password, and kettlebell, which
                                either have no nav or carry their own inline.

   Menu contents come from site/_data/nav.json. Editing the nav is one edit
   there rather than 19 edits across the site. #}

{# Members nav menus are keyed by language as of Aug 10, 2026 — resolve off the
   page's own `lang`, falling back to ES so a page that somehow has no lang set
   renders the Spanish menu rather than crashing the build. #}
{%- set mHome = nav.membersHome[lang] or nav.membersHome.es -%}
{%- set mPage = nav.membersPage[lang] or nav.membersPage.es -%}

{% if navVariant == "members-home" %}
<nav class="site-nav">
  <div class="wrap">
    <a href="{{ mHome.home }}" class="logo">{{ site.name }}</a>
    <button class="nav-toggle" id="navToggle" aria-label="{{ mHome.menuLabel }}" onclick="toggleNav()"><span></span><span></span><span></span></button>
    <nav id="siteNav">
      {#- Mobile only. The hamburger is a non-positioned child of the same
          stacking context as the drawer, so the open drawer paints over it and
          the toggle cannot be used to close the menu. Without this button the
          only way out is the overlay strip beside the panel. -#}
      <div class="nav-drawer-head">
        <button type="button" class="nav-drawer-close" onclick="closeNav()" aria-label="{{ mHome.closeLabel or mHome.menuLabel }}"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
      </div>
      {%- for item in mHome.items %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {%- endfor %}
      {#- `lang` is posted so the auth service knows which language's login page
          to drop the person back on after logging out. Without it, an EN
          subscriber logs out and lands on the Spanish login screen. -#}
      <form method="POST" action="/members/logout" style="display:inline; margin:0;">
        <input type="hidden" name="lang" value="{{ lang }}">
        <button type="submit" class="nav-cta">{{ mHome.logoutLabel }}</button>
      </form>
    </nav>
  </div>
</nav>
<div class="nav-overlay" id="navOverlay" onclick="closeNav()"></div>

{% elif navVariant == "members-page" %}
<div class="site-nav-sticky{% if noPrint %} no-print{% endif %}">
<div class="wrap">
  <header>
    <a href="{{ mPage.home }}" class="logo">{{ site.name }}</a>
    <button class="nav-toggle" id="navToggle" aria-label="{{ mPage.menuLabel }}" onclick="toggleNav()"><span></span><span></span><span></span></button>
    <nav id="siteNav">
      {#- Mobile only. The hamburger is a non-positioned child of the same
          stacking context as the drawer, so the open drawer paints over it and
          the toggle cannot be used to close the menu. Without this button the
          only way out is the overlay strip beside the panel. -#}
      <div class="nav-drawer-head">
        <button type="button" class="nav-drawer-close" onclick="closeNav()" aria-label="{{ mPage.closeLabel or mPage.menuLabel }}"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
      </div>
      {%- for item in mPage.items %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </header>
</div>
<div class="nav-overlay{% if noPrint %} no-print{% endif %}" id="navOverlay" onclick="closeNav()"></div>
</div>

{% elif navVariant != "none" %}
{%- set menu = nav[lang] -%}
<div class="site-nav-sticky">

{#- Utility strip (Aug 10, 2026). Language switcher + members access live here,
    not in the main row. The single-row nav had run out of width and pushed the
    language switcher onto a second line; the real problem was that content
    items and utility items were competing for the same 1080px. Hidden below
    860px — on mobile both items move into the hamburger drawer, where a second
    bar would only cost vertical space. -#}
<div class="nav-utility">
  <div class="wrap">
    <span class="lang-switch">
      {%- set alts = collections.translations[transKey] -%}
      {%- for code in site.langOrder -%}
      {%- if not loop.first %}<span class="sep">·</span>{% endif -%}
      {%- set target = alts[code] if alts and alts[code] else site.languages[code].home -%}
      <a href="{{ target }}"{% if code == lang %} class="lang-active"{% endif %}>{{ site.languages[code].label }}</a>
      {%- endfor -%}
    </span>
    {%- if menu.utility %}
    <a href="{{ menu.utility.url }}" class="nav-member"><svg class="nav-member-lock" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="10.5" width="16" height="10.5" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>{{ menu.utility.label }}</a>
    {%- endif %}
  </div>
</div>

<div class="wrap">
  <header>
    <a href="{{ site.languages[lang].home }}" class="logo">{{ site.name }}</a>
    <button class="nav-toggle" id="navToggle" aria-label="{{ menu.menuLabel }}" onclick="toggleNav()"><span></span><span></span><span></span></button>
    <nav id="siteNav">
      {#- Mobile only. The hamburger is a non-positioned child of the same
          stacking context as the drawer, so the open drawer paints over it and
          the toggle cannot be used to close the menu. Without this button the
          only way out is the overlay strip beside the panel. -#}
      <div class="nav-drawer-head">
        <button type="button" class="nav-drawer-close" onclick="closeNav()" aria-label="{{ menu.closeLabel or menu.menuLabel }}"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
      </div>
      {%- for item in menu.items %}
      {%- if item.children %}
      <div class="nav-dropdown">
        {#- `menuOnly` renders the parent as a plain label rather than a link.
            "Recursos" groups the blog and the calculators but has no page of its
            own, and a dropdown parent that links nowhere real is worse than one
            that doesn't pretend to. A /recursos/ hub would be the proper fix —
            see the note in nav.json. -#}
        {%- if item.menuOnly %}
        <span class="nav-dropdown-label" tabindex="0" role="button" aria-haspopup="true">{{ item.label }}<svg class="nav-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"></path></svg></span>
        {%- else %}
        <a href="{{ item.url }}">{{ item.label }}<svg class="nav-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"></path></svg></a>
        {%- endif %}
        <div class="nav-dropdown-menu">
          {#- `sub: true` marks a child as subordinate to the child above it —
              the three sport calculators sit under "Calculadora de Zonas".
              Indentation carries the hierarchy; they are siblings in the DOM
              because they are siblings in the IA (four indexable pages), and
              only the reading order is nested. -#}
          {%- for child in item.children %}
          <a href="{{ child.url }}"{% if child.sub %} class="nav-sub"{% endif %}>{{ child.label }}</a>
          {%- endfor %}
        </div>
      </div>
      {%- elif item.cta %}
      <a href="{{ item.url }}" class="nav-cta">{{ item.label }}</a>
      {%- else %}
      {#- Highlight the nav item for the page you're on. Dropdown parents are
          excluded above, matching how the hand-written pages behaved. -#}
      <a href="{{ item.url }}"{% if item.url == page.url %} class="lang-active"{% endif %}>{{ item.label }}</a>
      {%- endif %}
      {%- endfor %}

      {#- Mobile only. The utility strip above is hidden below 860px, so its two
          items are repeated inside the drawer — otherwise a phone loses both the
          language switcher and the members link entirely. -#}
      <div class="nav-drawer-utility">
        {%- if menu.utility %}
        <a href="{{ menu.utility.url }}" class="nav-member"><svg class="nav-member-lock" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="10.5" width="16" height="10.5" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>{{ menu.utility.label }}</a>
        {%- endif %}
        <span class="lang-switch">
          {%- set alts = collections.translations[transKey] -%}
          {%- for code in site.langOrder -%}
          {%- if not loop.first %}<span class="sep">·</span>{% endif -%}
          {%- set target = alts[code] if alts and alts[code] else site.languages[code].home -%}
          <a href="{{ target }}"{% if code == lang %} class="lang-active"{% endif %}>{{ site.languages[code].label }}</a>
          {%- endfor -%}
        </span>
      </div>
    </nav>
  </header>
</div>
{#- The overlay lives INSIDE `.site-nav-sticky` (moved Aug 26, 2026). It is
    `position: fixed` either way, but `position: sticky` always creates a
    stacking context, so an overlay outside it could never paint above the
    header — which is why the logo bar stayed bright white while the rest of
    the page dimmed. Inside, at z-index 90, it covers the header's own
    (non-positioned) contents and still sits under the drawer at 95. -#}
<div class="nav-overlay" id="navOverlay" onclick="closeNav()"></div>
</div>
{% endif %}

{% if navVariant != "none" %}
<script>
  var MOBILE_NAV = 860;

  function setNav(open) {
    var nav = document.getElementById('siteNav');
    var toggle = document.getElementById('navToggle');
    nav.classList.toggle('mobile-open', open);
    toggle.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.getElementById('navOverlay').classList.toggle('show', open);
    /* Scroll lock. Without it the page behind scrolls under the drawer, which
       on a phone reads as the menu itself having come unstuck. */
    document.body.classList.toggle('nav-open', open);
  }
  function toggleNav() {
    setNav(!document.getElementById('siteNav').classList.contains('mobile-open'));
  }
  function closeNav() { setNav(false); }

  /* Mobile: dropdown parents are accordions, collapsed by default (Aug 26,
     2026). Fully expanded, the drawer was 1368px of content in an 844px
     viewport — Contacto and the language switcher were both below the fold,
     and the two group headings were the same 17px as their own children, so
     there was no hierarchy to scan. Nothing is lost by not navigating on tap:
     "Planes" and its first child "Ver todos los planes" are the same URL, and
     "Recursos" is `menuOnly` — it has no page at all. Desktop hover is
     untouched. */
  document.querySelectorAll('#siteNav .nav-dropdown').forEach(function (dd) {
    var head = dd.querySelector(':scope > a, :scope > .nav-dropdown-label');
    if (!head) return;
    head.setAttribute('aria-expanded', 'false');
    head.addEventListener('click', function (e) {
      if (window.innerWidth > MOBILE_NAV) return;
      e.preventDefault();
      /* Stops the close-on-link-click handler below, which is registered on
         this same element later and would otherwise shut the drawer on the
         tap that opened the group. */
      e.stopImmediatePropagation();
      var open = !dd.classList.contains('open');
      dd.classList.toggle('open', open);
      head.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });

  document.querySelectorAll('#siteNav a').forEach(function (a) {
    a.addEventListener('click', function () { if (window.innerWidth <= MOBILE_NAV) closeNav(); });
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' || e.key === 'Esc') closeNav();
  });

  /* Rotating past the breakpoint with the drawer open would otherwise leave
     the body scroll-locked against a desktop nav. */
  window.addEventListener('resize', function () {
    if (window.innerWidth > MOBILE_NAV) closeNav();
  });
</script>
{% endif %}
