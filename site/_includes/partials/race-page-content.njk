{#- Shared content for every race landing page (ES/EN/PT). Included by the three
    thin pagination shells under site/planes/running/, site/en/plans/running/
    and site/pt/planos/maratona/ — each sets `lang` and paginates a different
    slice of races.byLanguage. `race` comes from the pagination alias.

    Block order is race-page-content-outline.md, and it is not the order a coach
    would assume: what kind of race -> course -> conditions -> getting in ->
    how to train -> plans. Every block answers "does this change how I train, or
    whether I choose this race". Kit collection, expo hours and bag drop fail
    that test and are deliberately absent. -#}
{%- set u = planUi[lang] -%}
{%- set r = raceUi[lang] -%}
{%- set home = site.languages[lang].home -%}
{%- set plansUrl = { es: "/planes/", en: "/en/plans/", pt: "/pt/planos/" }[lang] -%}
{%- set hubUrl = { es: "/planes/running/", en: "/en/plans/running/", pt: "/pt/planos/running/" }[lang] -%}
{%- set guidesUrl = { es: "/planes/running/guias-de-carrera/", en: "/en/plans/running/race-guides/", pt: "/pt/planos/running/guias-de-prova/" }[lang] -%}
{#- Every (intensity x gym) ladder the catalogue actually holds for this
    language. Variant 1 is heart-rate / no-gym everywhere; Spanish is currently
    the only catalogue with more than one populated variant at 42 km, so it is
    the only language that gets the facet controls. The condition is the DATA,
    not a hardcoded language check — English fills in the moment its third
    variant is worth exposing. -#}
{%- set variants = plans.byLanguage[lang] | raceLadderVariants(race.distance, race.weeksToRace) -%}
{%- set ladder = variants[0].plans if variants | length else [] -%}
{%- set showFacets = variants | length > 1 and lang == "es" -%}
{#- The lead plan is the Intermediate short block: the middle of the ladder, and
    the one the capture form attributes to. A race page has no single product,
    so without this the form would have no plan_id and the lead would arrive in
    Twenty with nothing to say what it was about. -#}
{%- set plan = ladder[2] if ladder | length > 2 else ladder[0] -%}

{#- ── Hero. Carbon, per brand-guidelines §3.3: the hero is one of the four
    public surfaces the dark system is allowed on. The image is an <img>, not a
    CSS background — its URL varies per page, so it has to come from data, and
    an <img> gets fetchpriority on its own without the LQIP and preload flag the
    homepage hero needs. -#}
<section class="race-hero">
  <picture class="race-hero-img">
    <source type="image/webp"
            srcset="{{ (race.image.base + '-960.webp') | v }} 960w, {{ (race.image.base + '-1600.webp') | v }} 1600w, {{ (race.image.base + '-2560.webp') | v }} 2560w"
            sizes="100vw">
    <img src="{{ (race.image.base + '-1600.jpg') | v }}"
         srcset="{{ (race.image.base + '-960.jpg') | v }} 960w, {{ (race.image.base + '-1600.jpg') | v }} 1600w, {{ (race.image.base + '-2560.jpg') | v }} 2560w"
         sizes="100vw" width="2560" height="1280"
         alt="{{ race.city }}, {{ race.country }}"
         fetchpriority="high" decoding="async">
  </picture>
  <div class="race-hero-body">
    <div class="wrap">
      <p class="breadcrumb"><a href="{{ home }}">{{ r.breadcrumbHome }}</a> / <a href="{{ plansUrl }}">{{ r.breadcrumbPlans }}</a> / <a href="{{ hubUrl }}">{{ r.breadcrumbHub }}</a> / <span>{{ race.name }}</span></p>
      <span class="label">{{ r.eyebrow }} · {{ race.city }}</span>
      <h1>{{ race.name }}</h1>
      <p class="race-date">
        {%- if race.nextEditionDate %}{{ r.nextEdition }}: <strong>{{ race.nextEditionDate | raceDate(lang, race.usDates) }}</strong>
        {%- else %}{{ r.typicalWindow }}: <strong>{{ race.typicalWindow }}</strong>{% endif %}
      </p>
      {%- if race.hook %}<p class="race-hook">{{ race.hook }}</p>{% endif %}
      {#- The byline. Name and credential are NOT typed here: they come from
          credentials.json, which is the one home for both, and the link resolves
          to that language's About page. The full Person schema with every
          credential lives there; this page carries only the reference. -#}
      {%- set cr = credentials[lang] %}
      <p class="race-byline">{{ r.byline
           | replace("{author}", '<a href="' + cr.aboutHref + '">Iván Koch</a>')
           | replace("{cred}", cr.items[0].name) | safe }}</p>
    </div>
  </div>
</section>

{#- ── 1. What kind of race this is. The cut-off lives here rather than in its
    own section: it is an answer to "is this for me", not a topic. -#}
{%- if race.field or race.cutOff %}
<section class="race-verdict">
  <div class="wrap">
    <h2>{{ r.verdictTitle }}</h2>
    <div class="race-stats">
      {#- A combined median gets one tile with the split underneath. A race that
          publishes only per-sex medians (Boston) gets two tiles rather than
          none — dropping both because the combined figure is missing threw away
          the best numbers on the page. -#}
      {%- if race.field and race.field.median %}
      <div class="race-stat">
        <span class="race-stat-n">{{ race.field.median }}</span>
        <span class="race-stat-l">{{ r.statMedian }}</span>
        {%- if race.field.median_m and race.field.median_f %}
        <span class="race-stat-sub">{{ r.statMedianM }} {{ race.field.median_m }} · {{ r.statMedianF }} {{ race.field.median_f }}</span>
        {%- endif %}
      </div>
      {%- elif race.field and race.field.median_m %}
      <div class="race-stat">
        <span class="race-stat-n">{{ race.field.median_m }}</span>
        <span class="race-stat-l">{{ r.statMedian }} · {{ r.statMedianM }}</span>
      </div>
      {%- if race.field.median_f %}
      <div class="race-stat">
        <span class="race-stat-n">{{ race.field.median_f }}</span>
        <span class="race-stat-l">{{ r.statMedian }} · {{ r.statMedianF }}</span>
      </div>
      {%- endif %}
      {%- endif %}
      {%- if race.field and race.field.sub3_pct %}
      <div class="race-stat">
        <span class="race-stat-n">{{ race.field.sub3_pct | pct(lang) }}</span>
        <span class="race-stat-l">{{ r.statSub3 }}</span>
        {%- if race.field.sub3_count_low %}
        <span class="race-stat-sub">{{ race.field.sub3_count_low | thousands(lang) }}{% if race.field.sub3_count_high and race.field.sub3_count_high != race.field.sub3_count_low %}–{{ race.field.sub3_count_high | thousands(lang) }}{% endif %}</span>
        {%- endif %}
      </div>
      {%- endif %}
      {%- if race.field and race.field.entrants %}
      <div class="race-stat">
        <span class="race-stat-n">{{ race.field.entrants | thousands(lang) }}+</span>
        <span class="race-stat-l">{{ r.statEntrants }}</span>
      </div>
      {%- endif %}
      {%- if race.field and race.field.finishers_low %}
      <div class="race-stat">
        <span class="race-stat-n">{{ race.field.finishers_low | thousands(lang) }}{% if race.field.finishers_high and race.field.finishers_high != race.field.finishers_low %}+{% endif %}</span>
        <span class="race-stat-l">{{ r.statFinishers }}</span>
        {%- if race.field.finishers_high and race.field.finishers_high != race.field.finishers_low %}
        <span class="race-stat-sub">{{ race.field.finishers_low | thousands(lang) }}–{{ race.field.finishers_high | thousands(lang) }}</span>
        {%- endif %}
      </div>
      {%- endif %}
    </div>
    {%- if race.field and race.field.year %}
    <p class="race-stat-source">{{ r.fieldYearPrefix }} {{ race.field.year }}.</p>
    {%- endif %}
    {%- if race.field and race.field.note %}<div class="race-prose">{{ race.field.note | raceProse | safe }}</div>{% endif %}
    {%- if race.cutOff and race.cutOff.text %}
    <div class="race-callout">
      <span class="race-callout-l">{{ r.statCutOff }}{% if race.cutOff.year %} · {{ race.cutOff.year }}{% endif %}</span>
      <div class="race-prose">{{ race.cutOff.text | raceProse | safe }}</div>
    </div>
    {%- endif %}
  </div>
</section>
{%- endif %}

{#- ── 2. The course, and where the field comes apart. -#}
<section class="race-course">
  <div class="wrap">
    <h2>{{ r.courseTitle }}</h2>
    <dl class="race-facts">
      {%- if race.courseProfile %}<dt>{{ r.profileLabel }}</dt><dd>{{ race.courseProfile | raceProse | safe }}</dd>{% endif %}
      {%- if race.elevationGainM %}<dt>{{ r.elevationLabel }}</dt><dd>{{ race.elevationGainM }} m</dd>{% endif %}
      {%- if race.altitudeM %}<dt>{{ r.altitudeLabel }}</dt><dd>{{ race.altitudeM | thousands(lang) }} m</dd>{% endif %}
    </dl>
    {%- if race.elevationNote %}<div class="race-note">{{ race.elevationNote | raceProse | safe }}</div>{% endif %}
    {%- if race.courseNotes %}<div class="race-prose">{{ race.courseNotes | raceProse | safe }}</div>{% endif %}
    {%- if race.whereTheyStruggle %}
    <h3>{{ r.struggleTitle }}</h3>
    <div class="race-prose">{{ race.whereTheyStruggle | raceProse | safe }}</div>
    {%- endif %}
  </div>
</section>

{#- ── 3. Conditions. Start time is here because it is a body-clock and fuelling
    input, not because it is logistics. -#}
{%- if race.typicalWeather or race.startTime %}
<section class="race-conditions">
  <div class="wrap">
    <h2>{{ r.conditionsTitle }}</h2>
    <dl class="race-facts">
      {#- Both of these carry authored prose, not a single value: bold, and more
          than one paragraph. Rendered raw they printed their own asterisks on
          a live page. -#}
      {%- if race.typicalWeather %}<dt>{{ r.weatherLabel }}</dt><dd>{{ race.typicalWeather | raceProse | safe }}</dd>{% endif %}
      {%- if race.startTime %}<dt>{{ r.startLabel }}</dt><dd>{{ race.startTime | raceProse | safe }}</dd>{% endif %}
    </dl>
    {#- The heat tool, for the races where heat is a real variable. Inline prose
        and not a card: the page already carries three asks (the ladder, the
        capture, the coaching banner) and a fourth boxed CTA would split the
        attention on the last one rather than add a path. It renders only where
        a calculator exists in this language — `heatToolUrl` is absent in EN and
        PT until those are written. -#}
    {%- if race.heatTool and r.heatToolUrl %}
    <p class="race-heat-link">{{ r.heatToolText | replace(r.heatToolLink, '<a href="' + r.heatToolUrl + '">' + r.heatToolLink + '</a>') | safe }}</p>
    {%- endif %}
  </div>
</section>
{%- endif %}

{#- ── 4. Getting in. Decision input, not administration: when entries open and
    whether you can get a place. Everything below registration — kit, expo,
    corral hours — is deliberately not here. -#}
{%- if race.registrationWindow %}
<section class="race-entry">
  <div class="wrap">
    <h2>{{ r.entryTitle }}</h2>
    <dl class="race-facts">
      <dt>{{ r.regWindowLabel }}</dt><dd>{{ race.registrationWindow | raceProse | safe }}</dd>
      {%- if race.registrationModel %}<dt>{{ r.regModelLabel }}</dt><dd>{{ race.registrationModel | raceProse | safe }}</dd>{% endif %}
      {%- if race.qualifying %}<dt>{{ r.qualifyingLabel }}</dt><dd>{{ race.qualifying | raceProse | safe }}</dd>{% endif %}
      {%- if race.corralPolicy %}<dt>{{ r.corralLabel }}</dt><dd>{{ race.corralPolicy | raceProse | safe }}</dd>{% endif %}
    </dl>
    {%- if race.sellOutNote %}<div class="race-prose">{{ race.sellOutNote | raceProse | safe }}</div>{% endif %}
    {%- if race.officialUrl %}<p class="race-note"><a href="{{ race.officialUrl }}" rel="nofollow noopener" target="_blank">{{ r.officialSite }} →</a></p>{% endif %}
    {#- The stamp, not a promise. Ballot dates and prices move every season and
        this block is the one that rots; saying when it was last checked and
        pointing at the organiser is what we can actually maintain across
        nineteen races. -#}
    {%- if race.lastVerified %}<p class="race-verified">{{ r.verifiedOn | replace("{date}", race.lastVerified | raceDate(lang, race.usDates)) }}</p>{% endif %}
  </div>
</section>
{%- endif %}

{#- ── 5. How to train for this one. methodology.md applied to blocks 2 and 3 —
    not a restatement of the course. -#}
{%- if race.howToTrain %}
<section class="race-training">
  <div class="wrap">
    <h2>{{ r.trainingTitle }}</h2>
    <div class="race-prose">{{ race.howToTrain | raceProse | safe }}</div>
    {#- "12 or 18 weeks" is abstract; a date is the answer to "when do I start".
        Computed from next_edition_date, so it is different on every page and
        cannot be written by hand wrongly. No confirmed date, no invented one. -#}
    {#- Only durations you can still start are listed, and the note underneath
        depends on how close the race is. A page eight weeks out that offers an
        18-week block, or prints a start date in August, is a page that has not
        noticed what day it is. Rebuilt daily by the 6am cron. -#}
    <div class="race-startby">
      <span class="race-startby-l">{{ r.startByTitle }}</span>
      {%- if race.startBy %}
      <ul class="race-startby-list">
        {%- for w, d in race.startBy %}
        <li><strong>{{ w }} {{ r.weeksLabel }}</strong> — {{ r.startByItem | replace("{date}", d | raceDate(lang, race.usDates)) }}</li>
        {%- endfor %}
      </ul>
      {%- endif %}
      {%- if race.ladderPhase == "ample" and race.startBy %}
      {#- Far out, the start date alone reads as a delay rather than a plan.
          Saying what the weeks before it are FOR is the difference between a
          page that sells a block you start in three months and one that tells
          you what to do until then. -#}
      {%- for w, d in race.startBy %}{% if loop.last %}
      <p>{{ r.startByAmple | replace("{weeks}", w + " " + r.weeksLabel) | replace("{date}", d | raceDate(lang, race.usDates)) }}</p>
      {%- endif %}{% endfor %}
      {%- elif race.ladderPhase == "band" %}
      <p>{{ r.startByBand | replace("{weeks}", race.weeksToRace) }}</p>
      {%- elif race.ladderPhase == "imminent" %}
      {#- Days away. "tight" would tell the reader they are inside the 12-week
          window, which is false, and render "Faltan 1 semanas". -#}
      {%- set daysTxt = r.daysOne if race.daysToRace == 1 else (r.daysMany | replace("{n}", race.daysToRace)) -%}
      <p>{{ r.startByImminent | replace("{weeks}", daysTxt) }}</p>
      {%- elif race.ladderPhase == "late" %}
      {#- The shortest block has already started. Saying "you are inside the
          12-week window" here is the page contradicting its own arithmetic. -#}
      <p>{{ r.startByLate | replace("{weeks}", race.weeksToRace) }}</p>
      {%- elif race.ladderPhase == "tight" %}
      <p>{{ r.startByTight | replace("{weeks}", race.weeksToRace) }}</p>
      {%- elif race.ladderPhase == "undated" %}
      <p>{{ r.startByNoDate }}</p>
      {%- endif %}
    </div>
  </div>
</section>
{%- endif %}

{#- ── 6. The ladder. A constant, not a per-race lookup, and with no countdown
    filter — see the raceLadder filter for why. -#}
{%- if ladder | length %}
<section class="race-plans">
  <div class="wrap">
    <h2>{{ r.plansTitle }}</h2>
    <p class="race-plans-intro">{{ r.plansIntro }}</p>
    {#- The entry state, HERE and not only in "cómo entrar". A page that sells an
        18-week block for a sold-out race, with the sold-out line four sections
        further up, is the defect Monterrey shipped with. -#}
    {%- if race.registrationState == "sold_out" %}
    <p class="race-reg-state race-reg-closed"><span>{{ r.regSoldOut }}</span> {{ r.regSoldOutNote | replace("{year}", race.year) }}</p>
    {%- elif race.registrationState == "window" and race.registrationWhen %}
    <p class="race-reg-state race-reg-closed"><span>{{ r.regWindow }}</span> {{ r.regWindowNote | replace("{when}", race.registrationWhen) }}</p>
    {%- elif race.registrationState == "open" %}
    <p class="race-reg-state race-reg-open"><span>{{ r.regOpen }}</span></p>
    {%- endif %}

    {%- if showFacets %}
    {#- Server-rendered: every variant's grid is in the HTML and the buttons
        swap which one is visible. No fetch, no template on the client, and the
        page still shows a full ladder with JavaScript off — the first grid is
        the only one without `hidden`, and the controls simply do nothing. -#}
    {%- set availableKeys = [] -%}
    {%- for v in variants %}{% set availableKeys = (availableKeys.push(v.key), availableKeys) %}{% endfor -%}
    <div class="race-facets" data-race-facets data-available="{{ availableKeys | dump | escape }}">
      <div class="race-facet-group">
        <span class="race-facet-label">{{ r.facetMetricLabel }}</span>
        <div class="race-facet-btns" role="group" aria-label="{{ r.facetMetricLabel }}">
          <button type="button" data-facet="metric" data-value="hr" aria-pressed="true">{{ r.facetHr }}</button>
          <button type="button" data-facet="metric" data-value="pace" aria-pressed="false">{{ r.facetPace }}</button>
        </div>
      </div>
      <div class="race-facet-group">
        <span class="race-facet-label">{{ r.facetGymLabel }}</span>
        <div class="race-facet-btns" role="group" aria-label="{{ r.facetGymLabel }}">
          <button type="button" data-facet="gym" data-value="off" aria-pressed="true">{{ r.facetGymOff }}</button>
          <button type="button" data-facet="gym" data-value="on" aria-pressed="false">{{ r.facetGymOn }}</button>
        </div>
      </div>
    </div>
    {#- Only claim the gym dimension when a gym ladder exists in this language.
        On the default heart-rate view the gym toggle is disabled, so promising
        it unconditionally described a greyed-out option. -#}
    {%- set hasGym = false %}{% for v in variants %}{% if v.gym %}{% set hasGym = true %}{% endif %}{% endfor %}
    <p class="race-facet-hint">{{ r.facetHint if hasGym else r.facetHintNoGym }}</p>
    <p class="race-facet-note" data-facet-note hidden></p>
    {%- endif %}

    {%- set renderVariants = variants if showFacets else [variants[0]] %}
    {%- for v in renderVariants %}
    <div class="race-plan-grid" data-variant="{{ v.key }}"
         data-weeks="{{ v.weeks | join(',') }}"
         data-complete="{{ 'true' if v.complete else 'false' }}"
         {% if not loop.first %}hidden{% endif %}>
      {%- for p in v.plans %}
      <a class="race-plan-card" href="{{ p.pageUrl }}">
        <span class="race-plan-level">{{ u.difficulty[p.difficulty] }}</span>
        <span class="race-plan-weeks">{{ p.weeks }} {{ r.weeksLabel }}</span>
        {%- set vol = p.displayName | volumeBand %}
        {%- if vol %}<span class="race-plan-vol">{{ r.volumeLabel }} {{ vol }}</span>{% endif %}
        <span class="race-plan-name">{{ p.displayName | stripDuration }}</span>
        <span class="race-plan-price">US$ {{ p.price }}</span>
      </a>
      {%- endfor %}
    </div>
    {%- endfor %}
    <p class="race-plans-note">{{ r.plansNote }}</p>
    {#- The catalogue is billed by TrainingPeaks in USD in every market. On a
        Portuguese or Spanish page "US$ 24.00" reads like a typo without this. -#}
    <p class="race-plans-price-note">{{ r.priceNote }}</p>
    {%- if race.planNote %}<p class="race-plans-caveat">{{ race.planNote }}</p>{% endif %}

    {%- if plan %}
    <div class="race-capture">
      <h3>{{ u.captureHeading }}</h3>
      <p>{{ u.captureBody }}</p>
      {%- set captureSource = "race" -%}
      {% include "partials/plan-capture-form.njk" %}
    </div>
    {%- endif %}
  </div>
</section>
{%- endif %}

{#- ── The coach, as the alternative to a fixed plan.
    Carbon, which brand-guidelines §3.3 permits on exactly four public surfaces
    — and the final CTA is one of them. It sits AFTER the plan cards on purpose:
    the page has just explained a constraint (two gun-timed cuts on a climb, a
    09:35 wave running a different race in the heat) that a calendar PDF cannot
    absorb, and this is the reader that a US$ 50 SKU does not fit. One offer,
    one link. No All-Access, no members tools, no price in this block. -#}
<section class="race-coach">
  <div class="wrap race-coach-inner">
    <div class="race-coach-photo">
      <picture>
        <source type="image/webp" sizes="(max-width: 760px) 140px, 240px"
                srcset="{{ "/assets/images/ivan-560.webp" | v }} 560w, {{ "/assets/images/ivan-800.webp" | v }} 800w">
        <img src="{{ "/assets/images/ivan-560.jpg" | v }}"
             srcset="{{ "/assets/images/ivan-560.jpg" | v }} 560w, {{ "/assets/images/ivan-800.jpg" | v }} 800w"
             sizes="(max-width: 760px) 140px, 240px"
             width="560" height="700" alt="{{ r.coachAlt }}" loading="lazy" decoding="async">
      </picture>
    </div>
    <div class="race-coach-body">
      <span class="label">{{ r.coachEyebrow }}</span>
      <h2>{{ r.coachHeading }}</h2>
      {%- if race.coachHook %}<p class="race-coach-hook">{{ race.coachHook }}</p>{% endif %}
      <p>{{ r.coachBodyGeneric }}</p>
      <a href="{{ planUi[lang].ctaHref }}" class="btn-primary">{{ r.coachCta }}</a>
    </div>
  </div>
</section>

{#- ── FAQ. Built as one array and rendered twice — visible <h3>/<p> and
    FAQPage JSON-LD — because schema that does not match the DOM is a penalty
    risk and the only reliable way to match is to render both from the same
    strings rather than maintain two copies.

    Note on expectations: Google restricted FAQ rich results in 2023 to
    authoritative health and government sites, so this will almost certainly
    not produce a rich snippet. It is here because the questions are the ones
    people actually type, because it is what gets the page quoted by an
    assistant, and because the answers are already facts on the page. -#}
{%- set faq = [] -%}
{%- if race.nextEditionDate -%}
  {%- set faq = (faq.push({
      q: r.faqWhen | replace("{race}", race.name) | replace("{year}", race.year),
      a: (race.nextEditionDate | raceDate(lang, race.usDates)) + (". " + (race.startTime | plainProse) if race.startTime else ".")
    }), faq) -%}
{%- else -%}
  {%- set faq = (faq.push({
      q: r.faqWhenNoDate | replace("{race}", race.name),
      a: race.typicalWindow + "."
    }), faq) -%}
{%- endif -%}
{%- if race.cutOff and race.cutOff.text -%}
  {%- set faq = (faq.push({
      q: r.faqCutOff | replace("{race}", race.name),
      a: race.cutOff.text | plainProse(2)
    }), faq) -%}
{%- endif -%}
{%- if race.whereTheyStruggle -%}
  {%- set faq = (faq.push({
      q: r.faqStruggle | replace("{race}", race.name),
      a: race.whereTheyStruggle | plainProse(2)
    }), faq) -%}
{%- endif -%}
{%- if race.startBy -%}
  {%- set faq = (faq.push({
      q: r.faqWeeks,
      a: r.startByLine
           | replace("{date}", race.nextEditionDate | raceDate(lang, race.usDates))
           | replace("{d18}", race.startBy["18"] | raceDate(lang, race.usDates))
           | replace("{d12}", race.startBy["12"] | raceDate(lang, race.usDates))
    }), faq) -%}
{%- endif -%}
{%- if race.registrationWindow -%}
  {%- set faq = (faq.push({
      q: r.faqEntry | replace("{race}", race.name),
      a: (race.registrationWindow | plainProse(2)) + (" " + (race.sellOutNote | plainProse(1)) if race.sellOutNote else "")
    }), faq) -%}
{%- endif -%}

{%- if faq | length %}
<section class="race-faq">
  <div class="wrap">
    <h2>{{ r.faqTitle }}</h2>
    <dl class="race-faq-list">
      {%- for item in faq %}
      <dt>{{ item.q }}</dt>
      <dd>{{ item.a }}</dd>
      {%- endfor %}
    </dl>
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faq %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
    }{{ "," if not loop.last }}
    {%- endfor %}
  ]
}
</script>
{%- endif %}

{#- Article, with a named author. FAQPage says what the page answers and
    SportsEvent says what the race is; neither says who wrote this or when it
    was last checked, which is the half of E-E-A-T these pages were missing.

    The author is a REFERENCE, not a copy: name, url and sameAs only. Every
    credential lives in the Person schema on the About page, which `url` and
    `sameAs` resolve to. Duplicating hasCredential onto 26 pages would put the
    same claim in 27 places and guarantee that one of them goes stale — and
    the rule in person-schema.njk is that structured data cannot be recalled
    once indexed, so it gets one home. -#}
{%- set cr = credentials[lang] %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ (race.name + (" " + race.year if race.year else "")) | dump | safe }},
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ page.url | absoluteUrl }}" },
  "inLanguage": "{{ lang }}",
  "about": {{ race.name | dump | safe }},
  "author": {
    "@type": "Person",
    "name": "Iván Koch",
    "url": "{{ cr.aboutHref | absoluteUrl }}",
    "sameAs": {{ credentials.sameAs | dump | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": "Triaperformance",
    "url": "https://triaperformance.com/"
  }{% if race.lastVerified %},
  "dateModified": "{{ race.lastVerified }}"{% endif %}
}
</script>

{#- SportsEvent, emitted only where the organiser has published a date. An
    event without a startDate is not an event Google can place on a calendar,
    and guessing one to satisfy the validator is the exact thing the two-field
    date model exists to prevent. -#}
{%- if race.nextEditionDate %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": {{ race.name | dump | safe }},
  "startDate": "{{ race.nextEditionDate }}",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "sport": "Running",
  "url": "{{ page.url | absoluteUrl }}",
  "location": {
    "@type": "Place",
    "name": {{ race.city | dump | safe }},
    "address": {
      "@type": "PostalAddress",
      "addressLocality": {{ race.city | dump | safe }},
      "addressCountry": {{ race.country | dump | safe }}
    }
  }{% if race.officialUrl %},
  "organizer": { "@type": "Organization", "url": "{{ race.officialUrl }}" }{% endif %}
}
</script>
{%- endif %}

{#- ── Sibling guides. Editorial pairs, resolved by id in this page's own
    language — a sibling with no page here simply does not render, which is what
    lets a Spanish-only race sit in the list of a race that also publishes in
    Portuguese. Ids, never typed URLs: the Portuguese race pages moved once
    already, two days after they were built. -#}
{%- set sibs = [] -%}
{%- for id in race.siblings -%}
  {%- for p in races.byLanguage[lang] %}{% if p.id == id %}{% set sibs = (sibs.push(p), sibs) %}{% endif %}{% endfor -%}
{%- endfor -%}
{%- if sibs | length %}
<section class="race-siblings">
  <div class="wrap">
    <h2>{{ r.siblingsTitle }}</h2>
    <ul class="race-sibling-list">
      {%- for p in sibs %}
      <li><a href="{{ p.url }}">
        <span class="race-sibling-name">{{ p.name }}</span>
        <span class="race-sibling-when">{%- if p.nextEditionDate %}{{ p.nextEditionDate | raceDate(lang, p.usDates) }}{% else %}{{ p.typicalWindow }}{% endif %}</span>
      </a></li>
      {%- endfor %}
    </ul>
    <p class="race-sibling-all"><a href="{{ guidesUrl }}">{{ r.hubTitle }} →</a></p>
  </div>
</section>
{%- endif %}

{#- ── Sources. Not decoration: the standing rule is that an organiser's own
    document wins over any derived reading, so the page says where it looked. -#}
{%- if showFacets %}
<script src="{{ "/assets/js/race-facets.js" | v }}" defer
        data-unavailable="{{ r.facetUnavailable | escape }}"
        data-weeks-only="{{ r.facetWeeksOnly | escape }}"></script>
{%- endif %}

{%- if race.sources | length %}
<section class="race-sources">
  <div class="wrap">
    <h2>{{ r.sourcesTitle }}</h2>
    <ul>
      {%- for s in race.sources %}
      <li><a href="{{ s }}" rel="nofollow noopener" target="_blank">{{ s | hostname }}</a></li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}
