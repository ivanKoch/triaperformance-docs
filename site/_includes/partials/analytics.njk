{# Google Analytics 4 + Microsoft Clarity.
   Defined once here instead of pasted into every page — which is how
   Clarity ended up missing from all 9 members pages in the hand-written site.
   Set `noClarity: true` in a page's front matter to opt that page out. #}
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.ga4 }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', '{{ site.analytics.ga4 }}');
</script>
{% if not noClarity %}
<!-- Microsoft Clarity -->
<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "{{ site.analytics.clarity }}");
</script>
{% endif %}
