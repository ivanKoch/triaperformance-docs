{#- Facet filters + plan grid — the reusable half of the catalog. Included by:
    - the 3 catalog index pages (site/planes/, site/en/plans/, site/pt/planos/),
      unfiltered, with their own hero above this include.
    - the 4 existing hand-written category pages (site/planes/triatlon/,
      running/, hyrox/, bajar-de-peso/), which keep their own hero/intro
      copy and pass `presetSport` so the page loads pre-filtered to that sport.

    Expects: `catalogPlans` (the array for one language — deliberately not
    named `plans`, which is the global site/_data/plans.js data object, not
    an array), `lang`, `u` (planUi[lang]), and at most one of:
    `presetSport` (exact CSV `sport` value, e.g. "Triathlon"),
    `presetDistance` (exact CSV `distance` value — HYROX is a distance, not
    a sport, in the source data), `presetDistances` (a LIST of distance values,
    for a hub that legitimately spans more than one — the Ironman hub covers
    both `Half` and `Full`, since neither has the inventory to justify its own
    page; OR-within-a-group means the grid shows the union), `presetFeature`
    (one of the `features` facet's own values: strength | weightloss | hr |
    power | pace).

    One catalog per page. The mobile chip JS keys panels by an owner id that
    restarts at g0 for each container and looks the scrim up document-wide, so
    two grids on one page would collide — if a page ever needs two, that has to
    be scoped first.

    Static site, no backend: every card renders server-side (crawlable,
    works with JS off) and site/assets/js/catalog-filters.js just toggles
    visibility client-side by reading each card's data-* attributes. #}
{#- Each facet heading is a button so the mobile chip bar has something real to
    tap and announce. On desktop CSS strips the button chrome back to a plain
    heading and the panel below it is always open — see plan-page.css. The
    `aria-expanded` state is managed by catalog-filters.js, which removes the
    attribute entirely on desktop where it isn't a disclosure control. -#}
{#- `short` is the mobile chip label. The full label is a sidebar heading on
    desktop, but "Distancia / enfoque" as a chip pushed the bar to three rows
    (147px — a third of an iPhone screen once the nav is counted). -#}
{%- macro facetHead(label, short) -%}
<h3><button type="button" class="facet-toggle" data-facet-toggle><span class="facet-label-full">{{ label }}</span><span class="facet-label-short">{{ short or label }}</span><span class="facet-badge" data-facet-badge>0</span></button></h3>
{%- endmacro -%}
{%- set sports = catalogPlans | facetValues("sport") -%}
{%- set distances = catalogPlans | facetValues("distance") -%}
{%- set distanceSports = catalogPlans | facetCrossMap("distance", "sport") -%}
{%- set difficulties = catalogPlans | facetValues("difficulty") -%}
{%- set weeksBuckets = ["1-8", "9-12", "13-18", "19+"] -%}

<div class="catalog-layout plan-catalog" data-catalog>
  <aside class="facets">
    <div class="facet-group" data-facet-group>
      {{ facetHead(u.filterSport) }}
      <div class="facet-options" data-facet-panel>
        {%- for s in sports %}
        <label>
          <input type="checkbox" data-group="sport" value="{{ s }}" {% if presetSport and presetSport == s %}checked{% endif %}>
          {{ u.sport[s] or s }}
        </label>
        {%- endfor %}
      </div>
    </div>
    <div class="facet-group" data-facet-group>
      {{ facetHead(u.filterDistance, u.filterDistanceShort) }}
      <div class="facet-options" data-facet-panel>
        {%- for d in distances %}
        <label data-sports="{{ distanceSports[d] | join(' ') }}"><input type="checkbox" data-group="distance" value="{{ d }}" {% if (presetDistance and presetDistance == d) or (presetDistances and d in presetDistances) %}checked{% endif %}> {{ d }}</label>
        {%- endfor %}
      </div>
    </div>
    <div class="facet-group" data-facet-group>
      {{ facetHead(u.filterDifficulty) }}
      <div class="facet-options" data-facet-panel>
        {%- for diff in difficulties %}
        <label><input type="checkbox" data-group="difficulty" value="{{ diff }}"> {{ u.difficulty[diff] or diff }}</label>
        {%- endfor %}
      </div>
    </div>
    <div class="facet-group" data-facet-group>
      {{ facetHead(u.filterWeeks) }}
      <div class="facet-options" data-facet-panel>
        {%- for wb in weeksBuckets %}
        <label><input type="checkbox" data-group="weeksbucket" value="{{ wb }}"> {{ u.weeksBucket[wb] }}</label>
        {%- endfor %}
      </div>
    </div>
    <div class="facet-group" data-facet-group>
      {{ facetHead(u.filterFeatures, u.filterFeaturesShort) }}
      <div class="facet-options" data-facet-panel>
        <label><input type="checkbox" data-group="features" value="strength" {% if presetFeature == "strength" %}checked{% endif %}> {{ u.strengthFlag }}</label>
        <label><input type="checkbox" data-group="features" value="weightloss" {% if presetFeature == "weightloss" %}checked{% endif %}> {{ u.weightLossFlag }}</label>
        <label><input type="checkbox" data-group="features" value="hr" {% if presetFeature == "hr" %}checked{% endif %}> {{ u.metric.hr }}</label>
        <label><input type="checkbox" data-group="features" value="power" {% if presetFeature == "power" %}checked{% endif %}> {{ u.metric.power }}</label>
        <label><input type="checkbox" data-group="features" value="pace" {% if presetFeature == "pace" %}checked{% endif %}> {{ u.metric.pace }}</label>
      </div>
    </div>
    <button type="button" class="facet-reset" data-reset hidden><span class="facet-label-full">{{ u.filterReset }}</span><span class="facet-label-short">{{ u.filterResetShort or u.filterReset }}</span></button>
  </aside>

  <div class="catalog-results">
    <p class="catalog-count" data-count>{{ catalogPlans.length }} {{ u.resultsCount }}</p>
    {#- Capped on first paint (Sept 9, 2026). EVERY card is still rendered
        server-side and stays in the DOM — the cap is CSS on a class, so the
        catalogue remains crawlable and the 164 internal links to the plan
        pages are all still there. `<noscript>` lifts the cap for a reader
        without JS, who has no button to press. -#}
    <noscript><style>.catalog-grid--capped .catalog-card { display: flex !important; }</style></noscript>
    {%- set isPreset = presetSport or presetDistance or presetDistances or presetFeature -%}
    <div class="catalog-grid{% if not isPreset %} catalog-grid--capped{% endif %}" data-grid data-cap-mode="{% if isPreset %}count{% else %}recommended{% endif %}">
      {%- for plan in catalogPlans %}
      {%- set featureTokens = "" %}
      {%- if plan.strength %}{% set featureTokens = featureTokens + "strength " %}{% endif %}
      {%- if plan.weightLoss %}{% set featureTokens = featureTokens + "weightloss " %}{% endif %}
      {%- if plan.metric %}{% set featureTokens = featureTokens + plan.metric %}{% endif %}
      <a href="{{ plan.pageUrl }}" class="catalog-card{% if plan.recommended %} is-recommended{% endif %}"
         data-sport="{{ plan.sport }}"
         data-distance="{{ plan.distance }}"
         data-difficulty="{{ plan.difficulty }}"
         data-weeksbucket="{{ plan.weeksBucket }}"
         data-weeks="{{ plan.weeks }}"
         data-price="{{ plan.price }}"
         data-features="{{ featureTokens }}">
        <span class="label">{{ u.sport[plan.sport] or plan.sport }}{% if plan.distance %} · {{ plan.distance }}{% endif %}</span>
        <h3>{{ plan.displayName }}</h3>
        <p class="catalog-card-meta">
          {{ plan.weeks }} {{ u.weeksShort }}{% if plan.difficulty %} · {{ u.difficulty[plan.difficulty] or plan.difficulty }}{% endif %}
        </p>
        {#- Real weekly volume, from data/plan_weekly_breakdown.csv via
            plans.js `weeklyTotals`. Coverage is 92% ES / 87% EN / 49% PT, so
            this degrades in steps rather than assuming: hours when the plan's
            activities are duration-based, sessions alone when they are not
            (swim volume is metres, a handful of runs are miles, and neither is
            guessed at), and nothing at all for the plans with no breakdown. -#}
        {%- if plan.weeklyTotals %}
        <p class="catalog-card-vol">
          {%- if plan.weeklyTotals.sessions %}<span>{{ plan.weeklyTotals.sessions }}{{ u.sessionsPerWeekShort }}</span>{% endif %}
          {%- if plan.weeklyTotals.hoursText %}<span>{{ plan.weeklyTotals.hoursText }}{{ u.perWeekShort }}</span>{% endif %}
          {%- if plan.weeklyTotals.longestText %}<span>{{ u.longestShort }} {{ plan.weeklyTotals.longestText }}</span>{% endif %}
        </p>
        {%- endif %}
        <p class="catalog-card-price">US$ {{ plan.price }}</p>
        <span class="btn-primary">{{ u.viewPlan }}</span>
      </a>
      {%- endfor %}
    </div>
    <p class="catalog-empty" data-empty hidden>{{ u.noResults }}</p>
    {#- Removed by catalog-filters.js as soon as the cap is lifted, and also the
        moment any filter is touched — a filtered result set is already a short
        list and capping it twice would hide matches the athlete asked for. -#}
    <button type="button" class="catalog-showall" data-showall>{{ u.showAll }}</button>
  </div>
</div>

<script src="{{ "/assets/js/catalog-filters.js" | v }}" defer></script>
