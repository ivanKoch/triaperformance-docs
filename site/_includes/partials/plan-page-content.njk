{#- Shared content for every individual plan page (ES/EN/PT). Included by the
    three thin pagination shells: site/planes/p/plan.njk, site/en/plans/p/plan.njk,
    site/pt/planos/p/plan.njk — each just sets `lang` and paginates a different
    slice of plans.byLanguage. `plan` comes from the pagination alias.

    Standing decisions this implements (growth-roadmap.md storefront section):
    Option A (redirect to TP, no checkout) · email capture before the redirect,
    non-blocking · redirect carries UTM + plan_id · All-Access promo module ·
    Product schema. -#}
{%- set u = planUi[lang] -%}
{%- set aa = allAccess[lang] -%}
{%- set home = site.languages[lang].home -%}
{%- set plansUrl = { es: "/planes/", en: "/en/plans/", pt: "/pt/planos/" }[lang] -%}
{%- set sportLabel = u.sport[plan.sport] or plan.sport -%}
{%- set difficultyLabel = u.difficulty[plan.difficulty] -%}
{%- set metricLabel = u.metric[plan.metric] -%}
{%- set buyUrl = plan.url | withUtm(plan.id) -%}

<section class="plan-hero">
  <div class="wrap">
    <p class="breadcrumb"><a href="{{ home }}">{{ u.breadcrumbHome }}</a> / <a href="{{ plansUrl }}">{{ u.breadcrumbPlans }}</a> / {{ plan.displayName }}</p>
    <span class="label">{{ sportLabel }}{% if plan.distance %} · {{ plan.distance }}{% endif %}</span>
    <h1>{{ plan.displayName }}</h1>
    <p class="plan-meta">
      {{ plan.weeks }} {{ u.weeksLabel }}
      {%- if difficultyLabel %} · {{ difficultyLabel }}{% endif %}
      {%- if metricLabel %} · {{ metricLabel }}{% endif %}
    </p>
    {%- if plan.strength or plan.weightLoss or plan.timeGoal %}
    <div class="plan-flags">
      {%- if plan.strength %}<span class="flag">{{ u.strengthFlag }}</span>{% endif %}
      {%- if plan.weightLoss %}<span class="flag">{{ u.weightLossFlag }}</span>{% endif %}
      {%- if plan.timeGoal %}<span class="flag">{{ u.timeGoalFlag }}</span>{% endif %}
    </div>
    {%- endif %}
    <div class="plan-price">US$ {{ plan.price }}</div>
  </div>
</section>

<section class="plan-buy">
  <div class="wrap plan-buy-grid">
    <div class="plan-buy-cta">
      <a href="{{ buyUrl }}" class="btn-primary plan-buy-btn plan-card" target="_blank" rel="noopener">{{ u.ctaBuy }}</a>
      <p class="plan-buy-note">{{ u.ctaNote }}</p>
    </div>
    <div class="plan-capture">
      <h3>{{ u.captureHeading }}</h3>
      <p>{{ u.captureBody }}</p>
      <form class="plan-capture-form"
            data-plan-id="{{ plan.id }}"
            data-plan-name="{{ plan.displayName | escape }}"
            data-lang="{{ lang }}"
            data-page-url="{{ page.url | absoluteUrl }}">
        <div class="plan-capture-row">
          <label class="visually-hidden" for="pc-email-{{ plan.id }}">{{ u.captureEmailLabel }}</label>
          <input type="email" id="pc-email-{{ plan.id }}" name="email" placeholder="{{ u.capturePlaceholder }}" required>
          <button type="submit">{{ u.captureSubmit }}</button>
        </div>
        <p class="plan-capture-status"></p>
      </form>
    </div>
  </div>
</section>

<section class="plan-breakdown">
  <div class="wrap">
    <h2>{{ u.breakdownTitle }}</h2>
    {%- if plan.weeklyBreakdown %}
    <p class="section-intro">{{ u.breakdownIntro }}</p>
    <table class="breakdown-table">
      <thead>
        <tr><th scope="col"></th><th scope="col">{{ u.colSessions }}</th><th scope="col">{{ u.colAvg }}</th><th scope="col">{{ u.colLongest }}</th></tr>
      </thead>
      <tbody>
        {%- for a in plan.weeklyBreakdown.activities %}
        <tr>
          <th scope="row">{{ u.activity[a.type] or a.type }}</th>
          <td>{{ a.weeklyCount or "—" }}</td>
          <td>{{ a.weeklyAvg | formatWeeklyStat(a.weeklyAvgUnit) }}</td>
          <td>{{ a.longest | formatWeeklyStat(a.longestUnit) }}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
    {%- if plan.weeklyBreakdown.restDaysPerWeek %}
    <p class="rest-days">{{ u.restDays }}: {{ plan.weeklyBreakdown.restDaysPerWeek }}</p>
    {%- endif %}
    {%- else %}
    <p class="section-intro">{{ u.noBreakdown }}</p>
    {%- endif %}
  </div>
</section>

{#- ---------------------------------------------------------------------------
    Generated content sections (August 6, 2026).

    Written from the plan's own data — inventory flags plus the weekly-breakdown
    crawl — rather than copied from the TrainingPeaks listing. The hand-written
    listing rewrites cover 20 of 321 plans, so copying them would leave 301
    pages empty; and reusing that text verbatim would set these pages against
    trainingpeaks.com for the same queries, which this domain loses. Every
    bullet below is conditional: a plan with no breakdown data simply renders
    fewer of them rather than asserting something unmeasured.
--------------------------------------------------------------------------- -#}
{%- set totals = plan.weeklyTotals -%}
{%- set sib = plan.siblings -%}

<section class="plan-prose">
  <div class="wrap plan-prose-grid">

    <div class="plan-prose-block">
      <h2>{{ u.forWhoTitle }}</h2>
      <ul class="plan-list">
        {%- if u.forWhoLevel[plan.difficulty] %}<li>{{ u.forWhoLevel[plan.difficulty] }}</li>{% endif %}
        {%- if totals and totals.sessions %}
        <li>
          {%- if totals.hoursText -%}
            {{ u.forWhoTime | replace("{sessions}", totals.sessions) | replace("{hours}", totals.hoursText) }}
          {%- else -%}
            {{ u.forWhoTimeNoHours | replace("{sessions}", totals.sessions) }}
          {%- endif -%}
        </li>
        {%- endif %}
        {%- if totals and totals.longestText %}<li>{{ u.forWhoLongest | replace("{longest}", totals.longestText) }}</li>{% endif %}
        {%- if plan.weeks %}<li>{{ u.forWhoWeeks | replace("{weeks}", plan.weeks) }}</li>{% endif %}
        {%- if u.forWhoMetric[plan.metric] %}<li>{{ u.forWhoMetric[plan.metric] }}</li>{% endif %}
      </ul>
      {%- if sib and (sib.easier or sib.harder or sib.shorter or sib.longer) %}
      <p class="plan-siblings"><strong>{{ u.forWhoNotFit }}</strong>
        {%- if sib.easier %} <a href="{{ sib.easier.pageUrl }}">{{ u.siblingEasier | replace("{level}", u.difficulty[sib.easier.difficulty]) }}</a>{% endif %}
        {%- if sib.harder %} <a href="{{ sib.harder.pageUrl }}">{{ u.siblingHarder | replace("{level}", u.difficulty[sib.harder.difficulty]) }}</a>{% endif %}
        {%- if sib.shorter %} <a href="{{ sib.shorter.pageUrl }}">{{ u.siblingShorter | replace("{weeks}", sib.shorter.weeks) }}</a>{% endif %}
        {%- if sib.longer %} <a href="{{ sib.longer.pageUrl }}">{{ u.siblingLonger | replace("{weeks}", sib.longer.weeks) }}</a>{% endif %}
      </p>
      {%- endif %}
    </div>

    <div class="plan-prose-block">
      <h2>{{ u.methodTitle }}</h2>
      <ul class="plan-list">
        <li>{{ u.methodPolarized }}</li>
        <li>{{ u.methodProgression }}</li>
        {%- if plan.strength %}<li>{{ u.methodStrength }}</li>{% endif %}
        <li>{{ u.methodZones }}</li>
      </ul>
    </div>

    <div class="plan-prose-block">
      <h2>{{ u.gearTitle }}</h2>
      <ul class="plan-list">
        {%- if u.gearMetric[plan.metric] %}<li>{{ u.gearMetric[plan.metric] }}</li>{% endif %}
        {%- if u.gearSport[plan.sport] %}<li>{{ u.gearSport[plan.sport] }}</li>{% endif %}
        {%- if plan.strength %}<li>{{ u.gearStrength }}</li>{% endif %}
        <li>{{ u.gearTP }}</li>
      </ul>
    </div>

    <div class="plan-prose-block">
      <h2>{{ u.tpTitle }}</h2>
      <ul class="plan-list">
        <li>{{ u.tpSync }}</li>
        <li>{{ u.tpApp }}</li>
        <li>{{ u.tpStart }}</li>
        <li>{{ u.tpReusable }}</li>
        <li>{{ u.tpSupport }}</li>
      </ul>
    </div>

  </div>
</section>

{#- All-Access sits after the content, immediately before the closing buy CTA —
    the reader has just been told exactly what one plan involves, which is the
    moment "you could have all of them" actually lands. -#}
{% include "partials/all-access-module.njk" %}

<section class="plan-final-cta">
  <div class="wrap">
    <a href="{{ buyUrl }}" class="btn-primary plan-card" target="_blank" rel="noopener">{{ u.ctaBuy }}</a>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ plan.displayName | dump | safe }},
  {#- Schema description now carries the same measured facts the page shows —
      sessions per week and average weekly hours — instead of restating the
      title. More useful in a rich result, and still no duplicated TP copy. -#}
  "description": {{ (plan.weeks + " " + u.weeksLabel + " — " + sportLabel
      + (", " + plan.distance if plan.distance else "")
      + (", " + difficultyLabel if difficultyLabel else "")
      + (". " + (u.forWhoTimeNoHours | replace("{sessions}", totals.sessions)) if totals and totals.sessions and not totals.hoursText else "")
      + (". " + (u.forWhoTime | replace("{sessions}", totals.sessions) | replace("{hours}", totals.hoursText)) if totals and totals.sessions and totals.hoursText else "")
      ) | dump | safe }},
  "image": {{ site.defaultProductImage | absoluteUrl | dump | safe }},
  "brand": { "@type": "Brand", "name": "Triaperformance" },
  "offers": {
    "@type": "Offer",
    "url": {{ plan.url | dump | safe }},
    "priceCurrency": "USD",
    "price": {{ plan.price | dump | safe }},
    "availability": "https://schema.org/InStock"
  }
}
</script>
<script src="{{ "/assets/js/plan-capture.js" | v }}" defer></script>
