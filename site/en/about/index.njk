  <div class="wrap">
    <span class="label">Start now</span>
    <h2>Tell me your goal</h2>
    <p>Leave your details and I will get back to you within 24 hours. No commitment.</p>
    {% include "partials/contact-form.njk" %}
  </div>
</section>

