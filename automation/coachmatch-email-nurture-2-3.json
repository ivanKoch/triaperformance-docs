        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"query\": \"query FindPeopleForEmailNurture($status: String!) { people(filter: { leadStatus: { eq: $status }, emailTouchCount: { lt: 3 } }) { edges { node { id name { firstName lastName } emails { primaryEmail } emailTouchCount createdAt } } } }\",\n  \"variables\": {\n    \"status\": \"MESSAGE_SENT\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
