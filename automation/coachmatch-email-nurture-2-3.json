        "httpHeaderAuth": {
          "id": "JHN5QPZo087TvBnD",
          "name": "Twenty API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst results = [];\n\nfor (const edge of $input.first().json.data.people.edges) {\n  const person = edge.node;\n  const createdAt = new Date(person.createdAt);\n  const hoursSinceCreated = (now - createdAt) / (1000 * 60 * 60);\n  const touchCount = person.emailTouchCount;\n\n  const isDue =\n    (touchCount === 1 && hoursSinceCreated >= 24) ||\n    (touchCount === 2 && hoursSinceCreated >= 48);\n\n  if (isDue) {\n    results.push({\n      json: {\n        id: person.id,\n        firstname: person.name.firstName,\n        lastname: person.name.lastName,\n        email: person.emails.primaryEmail,\n        emailTouchCount: touchCount\n      }\n    });\n  }\n}\n\nreturn results;"
      },
